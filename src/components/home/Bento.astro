---
import SectionHead from '../primitives/SectionHead.astro';
import TileHead from '../primitives/TileHead.astro';
import Spark from '../primitives/Spark.astro';
import { o } from '../../lib/tokens';
import CountUp from "@astroanimate/core/CountUp";
import '../MagicBento.css';

const timeline: Array<[string, string, string]> = [
  ['day 01', 'kickoff · 3 stakeholders',        '#1D6AF3'],
  ['day 03', 'strategy doc · v1',               '#ea580c'],
  ['day 07', '↳ first deliverable shipped',     '#64748b'],
  ['day 12', '⏸ review · scope check-in',       '#2563eb'],
  ['day 14', '✓ demo · staging green',          '#1D6AF3'],
];

const bars = Array.from({ length: 30 }, (_, i) => i);

const config = JSON.stringify({
  enableStars: true,
  enableSpotlight: true,
  enableBorderGlow: true,
  disableAnimations: false,
  spotlightRadius: 400,
  particleCount: 12,
  enableTilt: false,
  glowColor: '23, 105, 255',
  clickEffect: true,
  enableMagnetism: false
});
---

<section class="bento magic-bento-root" id="how-we-work" data-magic-bento-config={config}>
  <div class="centered-head">
    <SectionHead
      tag="02 · How we work"
      title={`A product company, not an <em>agency</em>.`}
      sub="Five things that show up on every engagement, by default."
    />
  </div>

  <div class="asymmetric-bento-grid">
    <!-- Top Left Large Feature Card: Cadence (Spans 7 cols, 2 rows) -->
    <div
      class="bento-card card-cadence magic-bento-card magic-bento-card--border-glow particle-container"
      data-card-index="0"
      style="--glow-color: rgb(23, 105, 255);"
    >
      <TileHead label="cadence / engagement" tag="every sprint" />
      <div class="cadence-body">
        <div class="lead-text">
          Weekly demos. <span class="accent-link">Working software</span> in your repo by day 7. Decision points written down, not whiteboarded.
        </div>
        <div class="timeline-list mono">
          {timeline.map(([t, txt, c]) => (
            <div class="t-row">
              <span class="t-when">{t}</span>
              <span class="t-txt" style={`color:${c}`}>{txt}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Top Right Card: Scope SOW (Spans 5 cols) -->
    <div
      class="bento-card card-sow magic-bento-card magic-bento-card--border-glow particle-container"
      data-card-index="1"
      style="--glow-color: rgb(23, 105, 255);"
    >
      <TileHead label="scope / SOW" tag="fixed price" />
      <div class="sow-body">
        <p class="sow-lead">
          Scoped tightly. Priced before we start. <span class="dim">If we over-scope, it's on us — not on the change order.</span>
        </p>
        <pre class="sow-code mono"><Fragment set:html={`SOW · acme / intake-agent
  scope    : RAG · 3 doc sources · 1 UI surface
  duration : 4 weeks · 2 engineers + 1 PM
  price    : $96,000  fixed`} /></pre>
      </div>
    </div>

    <!-- Mid Right Card: Speed / Kickoff (Spans 5 cols) -->
    <div
      class="bento-card card-speed magic-bento-card magic-bento-card--border-glow particle-container"
      data-card-index="2"
      style="--glow-color: rgb(23, 105, 255);"
    >
      <TileHead label="speed / kickoff" tag="median" />
      <div class="speed-body">
        <div class="metric-label mono">days from intro to first deliverable</div>
        <div class="speed-row">
          <div class="metric-num">
            <CountUp value={5} duration={1600} enhance={true} fontSize="inherit" textColor="inherit" />
            <span class="unit">days</span>
          </div>
          <div class="metric-delta mono">↘ 4× faster than industry avg</div>
        </div>
        <Spark height={64} />
      </div>
    </div>

    <!-- Bottom Left Medium Card: Written Sprint Schema (Spans 7 cols) -->
    <div
      class="bento-card card-schema magic-bento-card magic-bento-card--border-glow particle-container"
      data-card-index="3"
      style="--glow-color: rgb(23, 105, 255);"
    >
      <TileHead label="a 4-week sprint, written down" tag="real SOW excerpt" />
      <pre class="schema-code mono"><Fragment set:html={`<span style="color:${o.faint}">// scope a project the way you'd scope a function</span>
<span style="color:${o.purple}">engagement</span> <span style="color:${o.blue}">acme.intakeAgent</span> = {
  <span style="color:${o.warn}">outcome</span>:   <span style="color:#1D6AF3">'agent that triages support tickets'</span>,
  <span style="color:${o.warn}">success</span>:   <span style="color:#1D6AF3">'≥85% precision · &lt;2s p95 · in-app'</span>,
  <span style="color:${o.warn}">team</span>:      [<span style="color:#1D6AF3">'@rin (lead)'</span>, <span style="color:#1D6AF3">'@marco'</span>, <span style="color:#1D6AF3">'@anika'</span>],
  <span style="color:${o.warn}">stack</span>:     [<span style="color:#1D6AF3">'your repo'</span>, <span style="color:#1D6AF3">'your VPC'</span>, <span style="color:#1D6AF3">'your eval set'</span>],
}`} /></pre>
    </div>

    <!-- Bottom Right Compact Card: Track Record (Spans 5 cols) -->
    <div
      class="bento-card card-track magic-bento-card magic-bento-card--border-glow particle-container"
      data-card-index="4"
      style="--glow-color: rgb(23, 105, 255);"
    >
      <TileHead label="track record" tag="last 24 mo" />
      <div class="track-body">
        <div class="track-top">
          <div class="metric-num accent">
            <CountUp value={42} duration={2000} enhance={true} fontSize="inherit" textColor="inherit" />
            <span class="faded">/44</span>
          </div>
          <span class="track-sub mono">shipped on time, on price</span>
        </div>
        <div class="bars">
          {bars.map(i => (
            <div
              class="bar"
              style={`background:${i === 19 || i === 27 ? '#ea580c' : '#1D6AF3'};height:${i === 19 || i === 27 ? '10px' : '20px'}`}
            ></div>
          ))}
        </div>
        <div class="track-foot mono">38 sprints · 2 came in late (refunded)</div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  const DEFAULT_SPOTLIGHT_RADIUS = 400;
  const MOBILE_BREAKPOINT = 768;

  interface BentoConfig {
    enableStars: boolean;
    enableSpotlight: boolean;
    enableBorderGlow: boolean;
    disableAnimations: boolean;
    spotlightRadius: number;
    particleCount: number;
    enableTilt: boolean;
    glowColor: string;
    clickEffect: boolean;
    enableMagnetism: boolean;
  }

  const calculateSpotlightValues = (radius: number) => ({
    proximity: radius * 0.5,
    fadeDistance: radius * 0.75
  });

  const createParticle = (x: number, y: number, color: string) => {
    const particle = document.createElement('div');
    particle.className = 'particle';
    Object.assign(particle.style, {
      position: 'absolute',
      width: '4px',
      height: '4px',
      borderRadius: '50%',
      background: `rgba(${color}, 1)`,
      boxShadow: `0 0 6px rgba(${color}, 0.6)`,
      pointerEvents: 'none',
      zIndex: '100',
      left: `${x}px`,
      top: `${y}px`
    });
    return particle;
  };

  const initMagicBento = (root: HTMLElement) => {
    const config: BentoConfig = JSON.parse(
      root.dataset.magicBentoConfig || '{}'
    );

    const cards = Array.from(
      root.querySelectorAll<HTMLElement>('.bento-card, .magic-bento-card')
    );

    if (!cards.length) return;

    const isMobile = () => window.innerWidth <= MOBILE_BREAKPOINT;
    const animationsDisabled = () => config.disableAnimations || isMobile();

    const particleTemplates = new Map<HTMLElement, HTMLElement[]>();
    const activeParticles = new Map<HTMLElement, HTMLElement[]>();
    const particleTimeouts = new Map<HTMLElement, number[]>();
    const hoveredCards = new Set<HTMLElement>();

    const initializeParticleTemplates = (card: HTMLElement) => {
      if (particleTemplates.has(card)) return;
      const rect = card.getBoundingClientRect();
      const particles = Array.from({ length: config.particleCount || 12 }, () =>
        createParticle(
          Math.random() * rect.width,
          Math.random() * rect.height,
          config.glowColor || '23, 105, 255'
        )
      );
      particleTemplates.set(card, particles);
    };

    const clearParticles = (card: HTMLElement) => {
      const timeouts = particleTimeouts.get(card) || [];
      timeouts.forEach(clearTimeout);
      particleTimeouts.set(card, []);

      const particles = activeParticles.get(card) || [];
      particles.forEach((particle) => {
        gsap.to(particle, {
          scale: 0,
          opacity: 0,
          duration: 0.3,
          ease: 'back.in(1.7)',
          onComplete: () => {
            particle.remove();
          }
        });
      });
      activeParticles.set(card, []);
    };

    const animateParticles = (card: HTMLElement) => {
      if (animationsDisabled() || !hoveredCards.has(card)) return;
      initializeParticleTemplates(card);
      const templates = particleTemplates.get(card) || [];

      templates.forEach((template, index) => {
        const timeout = window.setTimeout(() => {
          if (!hoveredCards.has(card) || animationsDisabled()) return;

          const particle = template.cloneNode(true) as HTMLElement;
          card.appendChild(particle);

          const active = activeParticles.get(card) || [];
          active.push(particle);
          activeParticles.set(card, active);

          gsap.fromTo(
            particle,
            { scale: 0, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.3, ease: 'back.out(1.7)' }
          );

          gsap.to(particle, {
            x: (Math.random() - 0.5) * 80,
            y: (Math.random() - 0.5) * 80,
            rotation: Math.random() * 360,
            duration: 2 + Math.random() * 2,
            ease: 'none',
            repeat: -1,
            yoyo: true
          });

          gsap.to(particle, {
            opacity: 0.3,
            duration: 1.5,
            ease: 'power2.inOut',
            repeat: -1,
            yoyo: true
          });
        }, index * 100);

        const timeouts = particleTimeouts.get(card) || [];
        timeouts.push(timeout);
        particleTimeouts.set(card, timeouts);
      });
    };

    const handleCardEnter = (card: HTMLElement) => {
      if (animationsDisabled()) return;
      hoveredCards.add(card);
      if (config.enableStars) animateParticles(card);
    };

    const handleCardLeave = (card: HTMLElement) => {
      hoveredCards.delete(card);
      clearParticles(card);
    };

    const handleCardClick = (event: MouseEvent, card: HTMLElement) => {
      if (!config.clickEffect || animationsDisabled()) return;

      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const maxDistance = Math.max(
        Math.hypot(x, y),
        Math.hypot(x - rect.width, y),
        Math.hypot(x, y - rect.height),
        Math.hypot(x - rect.width, y - rect.height)
      );

      const ripple = document.createElement('div');
      ripple.className = 'magic-bento-ripple';
      Object.assign(ripple.style, {
        width: `${maxDistance * 2}px`,
        height: `${maxDistance * 2}px`,
        left: `${x - maxDistance}px`,
        top: `${y - maxDistance}px`,
        background: `radial-gradient(circle, rgba(${config.glowColor}, 0.35) 0%, rgba(${config.glowColor}, 0.15) 35%, transparent 70%)`
      });

      card.appendChild(ripple);
      gsap.fromTo(
        ripple,
        { scale: 0, opacity: 1 },
        { scale: 1, opacity: 0, duration: 0.75, ease: 'power2.out', onComplete: () => ripple.remove() }
      );
    };

    const updateCardGlow = (
      card: HTMLElement,
      mouseX: number,
      mouseY: number,
      intensity: number,
      radius: number
    ) => {
      const rect = card.getBoundingClientRect();
      const relativeX = ((mouseX - rect.left) / rect.width) * 100;
      const relativeY = ((mouseY - rect.top) / rect.height) * 100;

      card.style.setProperty('--glow-x', `${relativeX}%`);
      card.style.setProperty('--glow-y', `${relativeY}%`);
      card.style.setProperty('--glow-intensity', intensity.toString());
      card.style.setProperty('--glow-radius', `${radius}px`);
    };

    let spotlight: HTMLElement | null = null;
    const createSpotlight = () => {
      if (!config.enableSpotlight || animationsDisabled()) return;
      spotlight = document.createElement('div');
      spotlight.className = 'global-spotlight';
      spotlight.style.background = `radial-gradient(circle, rgba(${config.glowColor}, 0.10) 0%, rgba(${config.glowColor}, 0.04) 30%, transparent 70%)`;
      document.body.appendChild(spotlight);
    };

    createSpotlight();

    const cardCleanup: Array<() => void> = [];

    cards.forEach((card) => {
      const enter = () => handleCardEnter(card);
      const leave = () => handleCardLeave(card);
      const click = (e: MouseEvent) => handleCardClick(e, card);

      card.addEventListener('mouseenter', enter);
      card.addEventListener('mouseleave', leave);
      card.addEventListener('click', click);

      cardCleanup.push(() => {
        card.removeEventListener('mouseenter', enter);
        card.removeEventListener('mouseleave', leave);
        card.removeEventListener('click', click);
        clearParticles(card);
      });
    });

    const handleMouseMove = (event: MouseEvent) => {
      if (!spotlight || animationsDisabled()) return;

      const sectionRect = root.getBoundingClientRect();
      const inside =
        event.clientX >= sectionRect.left &&
        event.clientX <= sectionRect.right &&
        event.clientY >= sectionRect.top &&
        event.clientY <= sectionRect.bottom;

      if (!inside) {
        gsap.to(spotlight, { opacity: 0, duration: 0.3 });
        cards.forEach((card) => {
          card.style.setProperty('--glow-intensity', '0');
        });
        return;
      }

      const { proximity, fadeDistance } = calculateSpotlightValues(
        config.spotlightRadius || DEFAULT_SPOTLIGHT_RADIUS
      );

      let minDistance = Infinity;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const distance =
          Math.hypot(event.clientX - centerX, event.clientY - centerY) -
          Math.max(rect.width, rect.height) / 2;

        const effectiveDistance = Math.max(0, distance);
        minDistance = Math.min(minDistance, effectiveDistance);

        let intensity = 0;
        if (effectiveDistance <= proximity) {
          intensity = 1;
        } else if (effectiveDistance <= fadeDistance) {
          intensity =
            (fadeDistance - effectiveDistance) / (fadeDistance - proximity);
        }

        updateCardGlow(
          card,
          event.clientX,
          event.clientY,
          intensity,
          config.spotlightRadius || DEFAULT_SPOTLIGHT_RADIUS
        );
      });

      gsap.to(spotlight, {
        left: event.clientX,
        top: event.clientY,
        duration: 0.1,
        ease: 'power2.out'
      });

      const opacity =
        minDistance <= proximity
          ? 0.7
          : minDistance <= fadeDistance
            ? ((fadeDistance - minDistance) / (fadeDistance - proximity)) * 0.7
            : 0;

      gsap.to(spotlight, {
        opacity,
        duration: opacity > 0 ? 0.2 : 0.4,
        ease: 'power2.out'
      });
    };

    document.addEventListener('mousemove', handleMouseMove);

    const handleResize = () => {
      if (isMobile() && spotlight) {
        gsap.to(spotlight, { opacity: 0, duration: 0.2 });
      }
    };

    window.addEventListener('resize', handleResize);

    return () => {
      cardCleanup.forEach((cleanup) => cleanup());
      document.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('resize', handleResize);
      spotlight?.remove();
    };
  };

  document.querySelectorAll<HTMLElement>('.magic-bento-root').forEach((root) => {
    initMagicBento(root);
  });
</script>

<style>
  .bento {
    padding: 36px 24px 44px;
    border-top: 1px solid rgba(217, 56, 30, 0.12);
    border-bottom: 1px solid rgba(217, 56, 30, 0.12);
    background: #f3eee8 !important;
    color: var(--foreground);
    position: relative;
  }

  :global(html[data-theme="dark"]) .bento {
    background: #090e1a !important;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .centered-head {
    display: flex;
    justify-content: center;
    text-align: center;
    margin-bottom: 18px;
  }

  .centered-head :global(.section-head) {
    justify-content: center;
    margin-bottom: 0;
  }

  .centered-head :global(.text) {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .centered-head :global(.sub) {
    margin: 0 auto;
    font-size: 13.5px;
  }

  .centered-head :global(h2) {
    font-size: clamp(24px, 3.4vw, 36px);
    letter-spacing: -0.8px;
    margin: 6px 0 4px;
  }

  /* Asymmetric Bento Grid - Ultra Compact Proportions */
  .asymmetric-bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: 10px;
    max-width: 980px;
    margin: 0 auto;
  }

  .bento-card {
    background: #ffffff;
    color: var(--card-foreground);
    border: 1px solid rgba(20, 30, 50, 0.10);
    border-radius: 10px;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }

  :global(html[data-theme="dark"]) .bento-card {
    background: #0e1526;
    border-color: rgba(255, 255, 255, 0.09);
    box-shadow: 0 3px 16px rgba(0, 0, 0, 0.3);
  }

  .bento-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(23, 105, 255, 0.12);
    border-color: #1D6AF3;
  }

  :global(html[data-theme="dark"]) .bento-card:hover {
    border-color: #60a5fa;
    box-shadow: 0 8px 24px rgba(96, 165, 250, 0.2);
  }

  /* Card Grid Placements */
  .card-cadence {
    grid-column: span 7;
    grid-row: span 2;
  }

  .card-sow {
    grid-column: span 5;
    grid-row: span 1;
  }

  .card-speed {
    grid-column: span 5;
    grid-row: span 1;
  }

  .card-schema {
    grid-column: span 7;
    grid-row: span 1;
  }

  .card-track {
    grid-column: span 5;
    grid-row: span 1;
  }

  /* Internal Card Styling - Compact Spacing */
  .cadence-body {
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 8px;
  }

  .lead-text {
    font-family: 'Inter', sans-serif;
    font-optical-sizing: auto;
    font-style: normal;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--card-foreground);
    margin-bottom: 6px;
  }

  .lead-text .accent-link {
    color: #1D6AF3;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: rgba(0, 0, 0, 0.02);
    padding: 8px 10px;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.05);
  }

  :global(html[data-theme="dark"]) .timeline-list {
    background: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.05);
  }

  .t-row {
    display: flex;
    justify-content: space-between;
    font-size: 10.5px;
    line-height: 1.15;
  }

  .t-when {
    color: #64748b;
    font-weight: 600;
  }

  .sow-body {
    padding: 8px 12px;
  }

  .sow-lead {
    font-family: 'Inter', sans-serif;
    font-optical-sizing: auto;
    font-style: normal;
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--card-foreground);
    margin: 0 0 6px 0;
  }

  .sow-lead .dim {
    color: #64748b;
  }

  .sow-code {
    background: #faf8f5;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    font-size: 10px;
    line-height: 1.3;
    color: var(--card-foreground);
    margin: 0;
  }

  :global(html[data-theme="dark"]) .sow-code {
    background: rgba(0, 0, 0, 0.25);
    border-color: rgba(255, 255, 255, 0.05);
  }

  .speed-body {
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .metric-label {
    font-size: 9.5px;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .speed-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .metric-num {
    font-size: 22px;
    font-weight: 800;
    line-height: 1;
    color: #0f172a;
    font-family: 'Inter', sans-serif;
  }

  :global(html[data-theme="dark"]) .metric-num {
    color: #F5F7FB;
  }

  .metric-num .unit {
    font-size: 11px;
    font-weight: 600;
    color: #64748b;
    margin-left: 3px;
  }

  .metric-delta {
    font-size: 10px;
    color: #ea580c;
    font-weight: 700;
  }

  .schema-code {
    background: #ffffff;
    padding: 8px 12px;
    font-size: 10px;
    line-height: 1.35;
    margin: 0;
    color: var(--card-foreground);
  }

  :global(html[data-theme="dark"]) .schema-code {
    background: #0e1526;
  }

  .track-body {
    padding: 8px 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .track-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .metric-num.accent {
    color: #ea580c;
  }

  .metric-num .faded {
    font-size: 13px;
    color: #64748b;
    font-weight: 600;
  }

  .track-sub {
    font-size: 10px;
    color: #64748b;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 22px;
  }

  .bar {
    flex: 1;
    border-radius: 2px;
    transition: transform 0.2s ease;
  }

  .bar:hover {
    transform: scaleY(1.15);
  }

  .track-foot {
    font-size: 9.5px;
    color: #64748b;
  }

  @media (max-width: 900px) {
    .bento {
      padding: 30px 14px 36px;
    }

    .asymmetric-bento-grid {
      grid-template-columns: 1fr;
    }

    .card-cadence,
    .card-sow,
    .card-speed,
    .card-schema,
    .card-track {
      grid-column: span 1;
      grid-row: auto;
    }
  }
</style>
