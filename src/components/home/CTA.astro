---
import Tag from '../primitives/Tag.astro';
import Btn from '../primitives/Btn.astro';
---
<section class="cta">
  <div class="glow" aria-hidden="true"></div>
  <div class="inner">
    <Tag>Ready when you are</Tag>
    <h2>
      Stop scoping <span class="accent">RFPs</span>.<br />
      Start shipping software.
    </h2>
    <p class="sub mono">
      A 30-minute call. A written discovery doc inside a week. A fixed-price SOW
      by day 10. No procurement theater.
    </p>
    <div class="actions">
      <Btn primary href="/contact">Start a project →</Btn>
      <Btn href="/services">See the lineup</Btn>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 120px 56px;
    text-align: center;
    position: relative;
  }
  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--o-accent-dim) 33%, transparent), transparent 50%);
    pointer-events: none;
  }
  .inner { position: relative; }

  h2 {
    margin: 14px auto 18px;
    font-size: 64px;
    letter-spacing: -2px;
    font-weight: 600;
    color: var(--o-ink);
    line-height: 0.98;
    max-width: 740px;
  }
  h2 .accent { color: var(--o-accent); }

  .sub {
    font-size: 14px;
    color: var(--o-mute);
    max-width: 460px;
    margin: 0 auto 32px;
  }

  .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 700px) {
    .cta { padding: 72px 24px; }
    h2 { font-size: 40px; letter-spacing: -1.2px; }
  }
</style>
