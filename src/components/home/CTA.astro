---
// Dark High-Impact Final CTA Section with Segmented Switch Buttons
import FadeInText from "@astroanimate/core/FadeInText";
---

<section class="cta-section" id="ready-when-you-are">
  <div class="cta-container">

    <!-- ── TAG EYEBROW ── -->
    <FadeInText enhance={true} duration={0.6} yOffset={16}>
      <span class="cta-eyebrow">READY WHEN YOU ARE</span>
    </FadeInText>

    <!-- ── TOP ROW: COMPACT BOLD HEADLINE WITH INLINE ARROW CIRCLE ── -->
    <div class="build-title-wrap">
      <FadeInText enhance={true} duration={0.8} yOffset={28}>
        <h2 class="build-title">
          Stop scoping <span class="accent-text">RFPs.</span><br />
          Start shipping software.<a
            href="https://calendly.com/raafaeyousufrehman/discovery-call"
            target="_blank"
            rel="noopener noreferrer"
            class="title-arrow-circle"
            aria-label="Start a project"
          ><span class="arrow-icon">→</span></a>
        </h2>
      </FadeInText>
    </div>

    <!-- ── BOTTOM ROW: WEBSITE-STYLE PILL BUTTONS + SUPPORTING TEXT ── -->
    <div class="build-bottom-row">
      <FadeInText enhance={true} duration={0.8} delay={0.1} yOffset={24}>
        <div class="cta-buttons-group">
          <a
            href="/contact/"
            class="site-pill-btn primary-blue-pill"
            style="background:#1D6AF3; color:#ffffff; padding:12px 26px; border-radius:100px; text-decoration:none; display:inline-flex; align-items:center; gap:8px; font-weight:700; font-size:15px; box-shadow:0 4px 16px rgba(29,106,243,0.38);"
          >
            <span>Contact us</span>
            <svg class="pill-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>

          <a
            href="https://ollasoftware.com/services/"
            class="site-pill-btn secondary-glass-pill"
            style="background:rgba(255,255,255,0.08); color:#ffffff; padding:12px 24px; border-radius:100px; border:1.5px solid rgba(255,255,255,0.22); text-decoration:none; display:inline-flex; align-items:center; font-weight:600; font-size:15px;"
          >
            <span>See the lineup</span>
          </a>
        </div>
      </FadeInText>

      <FadeInText enhance={true} duration={0.8} delay={0.2} yOffset={20}>
        <p class="trusted-subtext">
          A 30-minute call. A written discovery doc inside a week. A fixed-price SOW by day 10. No procurement theater.
        </p>
      </FadeInText>
    </div>

  </div>
</section>

<style>
  /* ═══════════════════════════════════════════
     DARK HIGH-IMPACT SECTION (COMPACT & SLEEK)
  ═══════════════════════════════════════════ */
  .cta-section {
    background: #060913 !important;
    color: #ffffff !important;
    padding: 64px 48px 76px !important;
    width: 100% !important;
    box-sizing: border-box !important;
    display: flex !important;
    justify-content: center !important;
    border-top: 1px solid rgba(56, 189, 248, 0.14) !important;
    position: relative !important;
    z-index: 10 !important;
  }

  .cta-container {
    max-width: 1240px;
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* ── EYEBROW ── */
  .cta-eyebrow {
    font-family: 'Inter', sans-serif !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.14em !important;
    text-transform: uppercase !important;
    color: #1769FF !important;
    display: inline-block !important;
  }

  /* ── TOP TITLE ── */
  .build-title-wrap {
    width: 100%;
  }

  .build-title {
    font-family: 'Inter', sans-serif !important;
    font-optical-sizing: auto !important;
    font-style: normal !important;
    font-size: clamp(34px, 4.8vw, 64px) !important;
    font-weight: 800 !important;
    line-height: 1.06 !important;
    letter-spacing: -0.035em !important;
    color: #ffffff !important;
    margin: 0 !important;
    display: block !important;
  }

  .build-title .accent-text {
    color: #1769FF !important;
  }

  /* Inline Circular accent button — Electric Blue & Perfectly Centered */
  .title-arrow-circle {
    width: clamp(38px, 3.8vw, 52px) !important;
    height: clamp(38px, 3.8vw, 52px) !important;
    border-radius: 50% !important;
    background: #1D6AF3 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
    vertical-align: middle !important;
    margin-left: 12px !important;
    margin-bottom: 6px !important;
    box-shadow: 0 4px 18px rgba(29, 106, 243, 0.45) !important;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  .title-arrow-circle:hover {
    transform: scale(1.1) translateY(-2px) !important;
    background: #1557D0 !important;
    box-shadow: 0 8px 26px rgba(29, 106, 243, 0.65) !important;
  }

  .arrow-icon {
    font-size: clamp(18px, 1.8vw, 26px) !important;
    color: #ffffff !important;
    line-height: 1 !important;
    display: inline-block !important;
    transition: transform 0.2s ease !important;
  }

  .title-arrow-circle:hover .arrow-icon {
    transform: translateX(3px) !important;
  }

  /* ── BOTTOM ROW ── */
  .build-bottom-row {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 32px !important;
    flex-wrap: wrap !important;
    width: 100% !important;
    padding-top: 10px !important;
  }

  /* ── WEBSITE-STYLE BUTTONS GROUP ── */
  .cta-buttons-group {
    display: flex !important;
    align-items: center !important;
    gap: 14px !important;
    flex-wrap: wrap !important;
  }

  .site-pill-btn {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-optical-sizing: auto !important;
    font-style: normal !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    cursor: pointer !important;
  }

  /* Primary Blue Pill Button (Exact Match to Navbar "Start a Project") */
  .primary-blue-pill {
    background: #1D6AF3 !important;
    color: #ffffff !important;
    padding: 11px 24px !important;
    border-radius: 100px !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 8px !important;
    box-shadow: 0 4px 16px rgba(29, 106, 243, 0.35) !important;
    transition: all 0.2s ease !important;
  }

  .primary-blue-pill:hover {
    background: #1557D0 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 6px 22px rgba(29, 106, 243, 0.5) !important;
  }

  .pill-arrow {
    display: inline-block !important;
    transition: transform 0.2s ease !important;
  }
  .primary-blue-pill:hover .pill-arrow {
    transform: translateX(3px) !important;
  }

  /* Secondary Glass Pill Button */
  .secondary-glass-pill {
    background: rgba(255, 255, 255, 0.08) !important;
    color: #ffffff !important;
    border: 1.5px solid rgba(255, 255, 255, 0.25) !important;
    padding: 11px 22px !important;
    border-radius: 100px !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    display: inline-flex !important;
    align-items: center !important;
    transition: all 0.2s ease !important;
  }

  .secondary-glass-pill:hover {
    background: rgba(255, 255, 255, 0.18) !important;
    border-color: rgba(255, 255, 255, 0.5) !important;
    color: #ffffff !important;
    transform: translateY(-2px) !important;
  }

  .trusted-subtext {
    font-family: 'Inter', sans-serif !important;
    font-optical-sizing: auto !important;
    font-style: normal !important;
    font-size: 14px !important;
    line-height: 1.5 !important;
    color: #a1a1aa !important;
    margin: 0 !important;
    max-width: 440px !important;
    text-align: right !important;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 768px) {
    .cta-section {
      padding: 48px 20px 56px !important;
    }
    .build-bottom-row {
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 20px !important;
    }
    .trusted-subtext {
      text-align: left !important;
      max-width: 100% !important;
    }
  }
</style>
