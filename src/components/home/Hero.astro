---
import '../../styles/hero.css';

interface Props {
  eyebrow?: string;
  titleAccent?: string;
  title?: string;
  titleSuffix?: string;
  description?: string;
  showLogo?: boolean;
}

const {
  eyebrow = 'BANGALORE · EST. 2021 · NOW BOOKING Q3 2026',
  titleAccent = 'Pioneer',
  title = 'AI software company',
  titleSuffix = 'out of India.',
  description = 'Ollasoftware is the pioneer AI software development company in India, headquartered in Bangalore. Owners of 40+ AI brands in production — Aeoniti, Crawlcrawl, Switchllm, Ollima, Super25.ai and more. We build the same caliber of product for clients worldwide, in your repo, on your stack.',
  showLogo = false,
} = Astro.props;

const statItems = [
  { value: '05 DAYS', label: 'Discovery' },
  { value: 'SOC 2', label: 'Type II' },
  { value: '100%', label: 'Code ownership' },
  { value: '01 WEEK', label: 'SOW' }
];
---

<section class="hero-section" id="hero">
  <!-- Subtle overlay gradient for crisp typography contrast -->
  <div class="hero-bg-overlay" aria-hidden="true"></div>

  <div class="hero-container">
    <!-- 1. FULL-WIDTH HERO IMAGE ON TOP -->
    <div class="hero-ecosystem-visual">
        <!-- Light mode image -->
        <img
          src="/hero-light-new.png"
          alt="Ollasoftware Hero"
          class="hero-ecosystem-img hero-img-light"
          loading="eager"
          decoding="async"
        />
        <!-- Dark mode image -->
        <picture class="hero-img-dark">
          <img
            src="/hero-dark-new.png"
            alt="Ollasoftware Hero Dark"
            class="hero-ecosystem-img"
            loading="eager"
            decoding="async"
          />
        </picture>
      </div>

    <!-- 2. TWO-COLUMN CONTENT: Headline on Left, Description + CTAs on Right -->
    <div class="hero-content-grid">
      <!-- LEFT COLUMN: Eyebrow + Big Headline -->
      <div class="hero-col-left">
        <div class="hero-eyebrow-wrap">
          <span class="eyebrow-line" aria-hidden="true"></span>
          <span class="hero-meta-tag">{eyebrow}</span>
        </div>

        <h1 class="hero-headline">
          <span class="hl-pioneer">{titleAccent}</span>
          <span class="hl-main">{title}</span>
          <span class="hl-subtext">{titleSuffix.replace(/\.$/, '')}<span class="hl-dot">.</span></span>
        </h1>
      </div>

      <!-- RIGHT COLUMN: Paragraph Description + CTA Buttons -->
      <div class="hero-col-right">
        <p class="hero-desc" set:html={description} />

        <div class="hero-actions">
          <a href="/contact/" class="hero-btn primary">
            <span>Contact us</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="/services/" class="hero-btn secondary">
            <span>See what we ship</span>
          </a>
        </div>
      </div>
    </div>

    <!-- 3. BOTTOM METRICS ROW: Stats on Left, Brand Slogan Tagline on Right -->
    <div class="hero-bottom-bar">
      <div class="hero-stats-row">
        {statItems.map((stat, index) => (
          <div class="hero-stat-col">
            <div class="hero-stat-item">
              <span class="hero-stat-value">{stat.value}</span>
              <span class="hero-stat-label">{stat.label}</span>
            </div>
            {index < statItems.length - 1 && (
              <div class="hero-stat-divider" aria-hidden="true"></div>
            )}
          </div>
        ))}
      </div>

      <div class="hero-tagline-col">
        <span class="tagline-line" aria-hidden="true"></span>
        <span class="hero-tagline-text">IDEAS &nbsp; PRODUCTS &nbsp; PEOPLE &nbsp; A BRIGHTER TOMORROW</span>
      </div>
    </div>
  </div>
</section>
