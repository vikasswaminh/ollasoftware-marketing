---
import '../../styles/hero.css';
import FadeInText from "@astroanimate/core/FadeInText";

interface Props {
  eyebrow?: string;
  titleAccent?: string;
  title?: string;
  titleSuffix?: string;
  description?: string;
  showLogo?: boolean;
}

const {
  eyebrow = 'BANGALORE · EST. 2021 · NOW BOOKING Q3 2026',
  titleAccent = 'Pioneer',
  title = 'AI software company',
  titleSuffix = 'out of India.',
  description = 'Ollasoftware is the pioneer AI software development company in India, <strong class="hl-sub">headquartered in Bangalore</strong>. Owners of 40+ AI brands in production — Aeoniti, Crawlcrawl, Switchllm, Ollima, Super25.ai and more. We build the same caliber of product for clients worldwide, in your repo, on your stack.',
  showLogo = true,
} = Astro.props;

const trustItems = [
  'Discovery in 5 days',
  'SOC 2 Type II',
  'You own the code',
  'SOW signed in a week'
];
---

<section class="hero-section" id="hero">
  <!-- Subtle center radial glow for contrast -->
  <div class="hero-radial-glow" aria-hidden="true"></div>

  <div class="hero-container">
    <!-- LEFT COLUMN: Content aligned to left -->
    <div class="hero-left-content">
      <!-- 1. Top Metadata Tag -->
      <FadeInText duration={0.6} yOffset={15}>
        <div class="hero-meta-tag">
          <span>{eyebrow}</span>
        </div>
      </FadeInText>

      <!-- 2. Main 3-Line Headline -->
      <FadeInText duration={0.8} yOffset={25}>
        <h1 class="hero-headline">
          <span class="hl-pioneer">{titleAccent}</span>
          <span class="hl-main">{title}</span><br />
          <span class="hl-subtext">{titleSuffix.replace(/\.$/, '')}<span class="hl-dot">.</span></span>
        </h1>
      </FadeInText>

      <!-- 3. Description Paragraph -->
      <FadeInText enhance={true} duration={0.8} yOffset={30}>
        <p class="hero-desc" set:html={description} />
      </FadeInText>

      <!-- 4. CTA Action Buttons -->
      <FadeInText enhance={true} duration={0.8} delay={0.1} yOffset={25}>
        <div class="hero-actions">
          <a href="/contact/" class="hero-btn primary">
            <span>Contact us →</span>
          </a>
          <a href="/services/" class="hero-btn secondary">
            <span>See what we ship</span>
          </a>
        </div>
      </FadeInText>

      <!-- 5. Trust / Proof Badge Pill -->
      <FadeInText enhance={true} duration={0.8} delay={0.2} yOffset={20}>
        <div class="hero-proof-pill">
          <div class="proof-pill-content">
            {trustItems.map((item, index) => (
              <span class="proof-item">
                <span class="proof-check-circle">✓</span>
                <span>{item}</span>
                {index < trustItems.length - 1 && <span class="proof-dot-separator">·</span>}
              </span>
            ))}
          </div>
        </div>
      </FadeInText>
    </div>

    <!-- RIGHT COLUMN: New Ollasoftware Building Emblem (Light & Dark, Static & Sharp) -->
    {showLogo && (
      <FadeInText enhance={true} duration={0.8} delay={0.15} yOffset={20} blur="0px">
        <div class="hero-right-visual">
          <div class="hero-3d-logo-wrapper" id="hero-static-logo">
            <img
              src="/logo-building-light.png"
              alt="Ollasoftware Building Emblem"
              class="hero-3d-logo-img hero-logo-light"
              loading="eager"
              decoding="async"
            />
            <img
              src="/logo-building-dark.png"
              alt="Ollasoftware Building Emblem"
              class="hero-3d-logo-img hero-logo-dark"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </FadeInText>
    )}
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initHeroAnimations() {
    const hero = document.getElementById('hero');
    if (!hero) return;

    const items = hero.querySelectorAll('.hero-animate-item');
    if (items.length) {
      gsap.fromTo(
        items,
        { y: 16, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.65,
          stagger: 0.08,
          ease: 'power3.out'
        }
      );
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroAnimations);
  } else {
    initHeroAnimations();
  }
</script>
