---
const logos = ['Northwind', 'Helio Bank', 'Pelago', 'Riverlane', 'Forma Health', 'Sundial', 'Kestrel', 'Arclight'];
---
<section class="logos">
  <span class="label mono">Teams shipping with us</span>
  <div class="row">
    {logos.map(l => <span class="logo">{l}</span>)}
  </div>
</section>

<style>
  .logos {
    padding: 32px 56px;
    border-bottom: 1px solid var(--o-line);
    display: flex;
    align-items: center;
    gap: 48px;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .label {
    font-size: 9px;
    color: var(--o-faint);
    text-transform: uppercase;
    letter-spacing: 1px;
    flex-shrink: 0;
  }
  .row { display: flex; gap: 36px; opacity: 0.55; flex-wrap: wrap; }
  .logo {
    font-size: 15px;
    font-weight: 600;
    color: var(--o-mute);
    letter-spacing: -0.3px;
  }
  @media (max-width: 700px) { .logos { padding: 24px; } }
</style>
