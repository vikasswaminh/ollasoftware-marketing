---
import { o } from '../../lib/tokens';

const path = Astro.url.pathname;
const isActive = (to: string) => to === path || (to !== '/' && path.startsWith(to));
---
<header class="nav" id="site-nav">
  <div class="nav-container">
    
    <!-- LEFT ZONE: Logo & Brand Name -->
    <a href="/" class="brand" aria-label="ollasoftware — home">
      <img src="/logo-building-light.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-light" />
      <img src="/logo-building-dark.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-dark" />
      <span class="brand-blue-text">ollasoftware</span>
    </a>

    <!-- CENTER ZONE: Services, Work, Blog, Jobs, About -->
    <div class="nav-center">
      <a href="/services/" class:list={['nav-link', { active: isActive('/services/') }]}>Services</a>
      <a href="/work/" class:list={['nav-link', { active: isActive('/work/') }]}>Work</a>
      <a href="/blog/" class:list={['nav-link', { active: isActive('/blog/') }]}>Blog</a>
      <a href="/jobs/" class:list={['nav-link', { active: isActive('/jobs/') }]}>Jobs</a>
      <a href="/about/" class:list={['nav-link', { active: isActive('/about/') }]}>About</a>
    </div>

    <!-- RIGHT ZONE: Theme Toggle, Start a Project Button -->
    <div class="nav-right">
      <!-- iOS-Style Horizontal Interactive Toggle Switch -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle-switch"
        aria-label="Toggle dark mode"
        role="switch"
        aria-checked="false"
      >
        <span class="toggle-track">
          <span class="toggle-thumb">
            <!-- Sun icon in thumb when light -->
            <svg class="thumb-icon icon-sun" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <!-- Moon icon in thumb when dark -->
            <svg class="thumb-icon icon-moon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1769FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
        </span>
      </button>

      <a href="/contact/" class="cta-btn">
        <span>Contact us</span>
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>

      <button
        type="button"
        class="nav-burger"
        aria-label="Open navigation menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <span class="burger-line" aria-hidden="true"></span>
        <span class="burger-line" aria-hidden="true"></span>
        <span class="burger-line" aria-hidden="true"></span>
      </button>
    </div><!-- /.nav-right -->
  </div><!-- /.nav-container -->

  <!-- Full-Screen Mobile Drawer (Guaranteed Z-Index & Clean Scroll) -->
  <nav class="nav-links" id="nav-links" aria-label="Mobile Navigation">
    <div class="drawer-header-bar">
      <a href="/" class="brand" aria-label="ollasoftware — home">
        <img src="/logo-building-light.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-light" />
        <img src="/logo-building-dark.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-dark" />
        <span class="brand-blue-text">ollasoftware</span>
      </a>
      <button type="button" class="drawer-close-btn" id="drawer-close-btn" aria-label="Close navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-content-scroll">
      <!-- 0. TOP PRIMARY QUICK-NAV LINKS (Services, Work, Blog, Jobs, About) -->
      <div class="drawer-primary-nav">
        <a href="/services/" class:list={['drawer-main-link', { active: isActive('/services/') }]}>
          <span>Services</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/work/" class:list={['drawer-main-link', { active: isActive('/work/') }]}>
          <span>Work</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/blog/" class:list={['drawer-main-link', { active: isActive('/blog/') }]}>
          <span>Blog</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/jobs/" class:list={['drawer-main-link', { active: isActive('/jobs/') }]}>
          <span>Jobs</span>
          <span class="nav-arrow">→</span>
        </a>
        <a href="/about/" class:list={['drawer-main-link', { active: isActive('/about/') }]}>
          <span>About</span>
          <span class="nav-arrow">→</span>
        </a>
      </div>



      <!-- BOTTOM CONTROLS: Dark Mode & Contact us Button -->
      <div class="drawer-bottom-zone">
        <div class="drawer-theme-toggle-row">
          <span class="drawer-theme-label">Dark Mode</span>
          <button
            type="button"
            class="theme-toggle-switch drawer-theme-btn"
            aria-label="Toggle dark mode"
            role="switch"
            aria-checked="false"
          >
            <span class="toggle-track">
              <span class="toggle-thumb">
                <svg class="thumb-icon icon-sun" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="5"/>
                  <line x1="12" y1="1" x2="12" y2="3"/>
                  <line x1="12" y1="21" x2="12" y2="23"/>
                  <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                  <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                  <line x1="1" y1="12" x2="3" y2="12"/>
                  <line x1="21" y1="12" x2="23" y2="12"/>
                  <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                  <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
                <svg class="thumb-icon icon-moon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1769FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
              </span>
            </span>
          </button>
        </div>

        <div class="drawer-cta-wrap">
          <a href="/contact/" class="drawer-cta-btn">
            <span>Contact us</span>
            <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    function initMobileNav() {
      const nav = document.getElementById('site-nav');
      if (!nav) return;
      const btn = nav.querySelector('.nav-burger');
      const drawer = document.getElementById('nav-links');
      if (!btn || !drawer) return;

      const closeBtn = document.getElementById('drawer-close-btn');

      const setOpen = (open) => {
        if (open) {
          nav.classList.add('nav-open');
          btn.setAttribute('aria-expanded', 'true');
          btn.setAttribute('aria-label', 'Close navigation menu');
          document.body.style.overflow = 'hidden';
        } else {
          nav.classList.remove('nav-open');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open navigation menu');
          document.body.style.overflow = '';
        }
      };

      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = nav.classList.contains('nav-open');
        setOpen(!isOpen);
      };

      if (closeBtn) {
        closeBtn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          setOpen(false);
        };
      }

      drawer.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          setOpen(false);
        });
      });

      document.addEventListener('click', (e) => {
        if (!nav.classList.contains('nav-open')) return;
        if (e.target instanceof Element && !nav.contains(e.target)) {
          setOpen(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('nav-open')) {
          setOpen(false);
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 900 && nav.classList.contains('nav-open')) {
          setOpen(false);
        }
      });
    }

    // ── Dark Mode Toggle (Synchronize all toggle buttons on page) ──
    const initThemeToggle = () => {
      const html = document.documentElement;
      const toggleButtons = document.querySelectorAll('.theme-toggle-switch');
      if (!toggleButtons.length) return;

      const updateToggleState = (isDark) => {
        toggleButtons.forEach((btn) => {
          btn.setAttribute('aria-checked', String(isDark));
        });
      };

      const isCurrentDark = html.getAttribute('data-theme') === 'dark';
      updateToggleState(isCurrentDark);

      const toggleTheme = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const nowDark = html.getAttribute('data-theme') === 'dark';
        if (nowDark) {
          html.removeAttribute('data-theme');
          try { localStorage.setItem('olla-theme', 'light'); } catch (err) {}
          updateToggleState(false);
        } else {
          html.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('olla-theme', 'dark'); } catch (err) {}
          updateToggleState(true);
        }
      };

      toggleButtons.forEach((btn) => {
        btn.onclick = toggleTheme;
      });
    };

    const setup = () => {
      initMobileNav();
      initThemeToggle();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
    document.addEventListener('astro:page-load', setup);
  })();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    width: 100%;
    height: 68px;
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 100;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06) !important;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    transition: background-color 0.3s ease;
  }

  :global(html[data-theme="dark"]) .nav {
    background: rgba(7, 10, 18, 0.85) !important;
    border-bottom-color: rgba(255, 255, 255, 0.08) !important;
  }

  /* 3-Zone Header Layout: Left Brand, Center Links, Right CTA */
  .nav-container {
    width: 100%;
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    box-sizing: border-box;
    position: relative;
  }

  /* LEFT ZONE: Brand / Logo */
  .brand {
    justify-self: start;
    text-decoration: none;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 10px !important;
    padding: 0;
    z-index: 2;
  }

  .brand-logo-img {
    height: 44px !important;
    width: auto;
    object-fit: contain;
    display: block !important;
    flex-shrink: 0;
  }

  .brand-logo-dark {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo-light {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo-dark {
    display: block !important;
    filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.45));
  }

  .brand-blue-text {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
    font-size: 24px !important;
    font-weight: 800 !important;
    letter-spacing: -0.04em;
    color: #1D6AF3 !important;
    line-height: 1;
  }

  /* CENTER ZONE: Navigation Menu Links with reduced spacing */
  .nav-center {
    justify-self: center;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 18px !important;
  }

  /* RIGHT ZONE: Theme Toggle & CTA */
  .nav-right {
    justify-self: end;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 14px !important;
    z-index: 2;
  }

  .nav-link {
    color: #4b5563;
    font-family: 'Lato', sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    padding: 3px 0;
    transition: color 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }

  :global(html[data-theme="dark"]) .nav-link {
    color: #d1d5db;
  }

  .nav-link:hover, .nav-link.active {
    color: #1D6AF3;
  }

  :global(html[data-theme="dark"]) .nav-link:hover,
  :global(html[data-theme="dark"]) .nav-link.active {
    color: #60a5fa;
  }

  /* ─── iOS Style Horizontal Toggle Switch ─── */
  .theme-toggle-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px;
    cursor: pointer;
    outline: none;
    line-height: 1;
    height: 26px;
    flex-shrink: 0;
  }

  .toggle-track {
    position: relative;
    overflow: hidden;
    width: 48px;
    height: 26px;
    border-radius: 100px;
    background: #cbd5e1;
    border: 1px solid #94a3b8;
    padding: 2px;
    box-sizing: border-box;
    transition: background 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    align-items: center;
  }

  .toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease;
    transform: translateX(0px);
  }

  html[data-theme="dark"] .toggle-track {
    background: #1769FF;
    border-color: #2979ff;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3), 0 0 12px rgba(23, 105, 255, 0.4);
  }

  html[data-theme="dark"] .toggle-thumb {
    transform: translateX(22px);
    background: #ffffff;
  }

  .icon-sun  { display: block; }
  .icon-moon { display: none; }

  html[data-theme="dark"] .icon-sun  { display: none; }
  html[data-theme="dark"] .icon-moon { display: block; }

  .cta-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1D6AF3;
    color: #ffffff;
    font-family: 'Lato', sans-serif;
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.2;
    padding: 10px 22px;
    border-radius: 100px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(29, 106, 243, 0.28);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .cta-btn:hover {
    background: #1557D0;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(29, 106, 243, 0.38);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .cta-btn:hover .arrow {
    transform: translateX(3px);
  }

  /* Hamburger menu for mobile */
  .nav-burger {
    display: none;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: transparent;
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    flex-shrink: 0;
  }

  .burger-line {
    width: 16px;
    height: 1.5px;
    background: #111827;
    border-radius: 1px;
    transition: transform 0.18s, opacity 0.14s;
  }

  :global(html[data-theme="dark"]) .nav:not(.nav--sticky) {
    background: transparent !important;
  }

  :global(html[data-theme="dark"]) .nav-burger {
    border-color: rgba(255, 255, 255, 0.18);
  }

  :global(html[data-theme="dark"]) .burger-line {
    background: #ffffff;
  }

  .nav-open .burger-line:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .nav-open .burger-line:nth-child(2) { opacity: 0; }
  .nav-open .burger-line:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .nav-links {
    display: none !important;
  }

  .drawer-theme-toggle-row {
    display: none;
  }

  /* Tablet & Mobile Responsive */
  @media (max-width: 900px) {
    .nav {
      height: 64px;
      padding-top: 0;
    }
    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 16px;
    }
    .nav-center {
      display: none !important;
    }
    .brand {
      justify-self: auto;
      padding: 0;
      transform: none;
      gap: 10px;
    }
    .nav-right {
      gap: 0;
    }

    /* ── Hide top-navbar toggle and Contact Us button on mobile screens ── */
    .nav-right .theme-toggle-switch:not(.drawer-theme-btn),
    .nav-right .cta-btn {
      display: none !important;
    }

    .nav-burger {
      display: inline-flex !important;
    }

    .nav-links {
      display: none !important;
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      right: 0 !important;
      bottom: 0 !important;
      width: 100vw !important;
      height: 100vh !important;
      transform: none !important;
      background: #ffffff !important;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.25);
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 0 !important;
      padding: 0 !important;
      overflow: hidden !important;
      z-index: 999999 !important;
    }

    :global(html[data-theme="dark"]) .nav-links {
      background: #070a12 !important;
    }

    .nav.nav-open .nav-links,
    #site-nav.nav-open .nav-links {
      display: flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .drawer-header-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      padding: 0 16px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      flex-shrink: 0;
      width: 100%;
      box-sizing: border-box;
      background: #ffffff;
    }

    :global(html[data-theme="dark"]) .drawer-header-bar {
      background: #070a12;
      border-bottom-color: rgba(255, 255, 255, 0.1);
    }

    .drawer-close-btn {
      width: 36px;
      height: 36px;
      border: 1px solid rgba(0, 0, 0, 0.12);
      background: transparent;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #0f172a;
      padding: 0;
      transition: background 0.15s ease;
    }

    :global(html[data-theme="dark"]) .drawer-close-btn {
      border-color: rgba(255, 255, 255, 0.18);
      color: #ffffff;
    }

    .drawer-content-scroll {
      display: flex;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0;
      padding: 20px 20px 40px;
      width: 100%;
      height: calc(100vh - 64px);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      box-sizing: border-box;
    }

    .drawer-primary-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding-bottom: 8px;
    }

    .drawer-main-link {
      font-family: 'Lato', sans-serif;
      font-size: 18px;
      font-weight: 700;
      color: #0f172a !important;
      text-decoration: none;
      padding: 14px 12px;
      border-radius: 10px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.15s ease;
    }

    :global(html[data-theme="dark"]) .drawer-main-link {
      color: #f8fafc !important;
      border-bottom-color: rgba(255, 255, 255, 0.06);
    }

    .drawer-main-link:hover,
    .drawer-main-link.active {
      color: #1D6AF3 !important;
      background: rgba(29, 106, 243, 0.06);
    }

    .nav-arrow {
      color: #94a3b8;
      font-size: 16px;
      transition: transform 0.15s ease;
    }

    .drawer-main-link:hover .nav-arrow {
      transform: translateX(4px);
      color: #1D6AF3;
    }

    :global(html[data-theme="dark"]) .drawer-main-link:hover,
    :global(html[data-theme="dark"]) .drawer-main-link.active {
      color: #38BDF8 !important;
      background: rgba(56, 189, 248, 0.1);
    }

    .drawer-section {
      width: 100%;
      box-sizing: border-box;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    :global(html[data-theme="dark"]) .drawer-section {
      border-bottom-color: rgba(255, 255, 255, 0.07);
    }

    .drawer-section:last-of-type {
      border-bottom: none;
      padding-bottom: 0;
    }

    .drawer-sec-head {
      font-family: 'Lato', sans-serif;
      font-size: 11px;
      font-weight: 800;
