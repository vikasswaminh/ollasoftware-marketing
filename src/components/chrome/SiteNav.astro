---
import { o } from '../../lib/tokens';

const path = Astro.url.pathname;
const isActive = (to: string) => to === path || (to !== '/' && path.startsWith(to));
---
<header class="nav" id="site-nav">
  <div class="nav-container">
    
    <!-- LEFT ZONE: Logo & Brand Name -->
    <a href="/" class="brand" aria-label="ollasoftware — home">
      <img src="/logo-building-light.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-light" />
      <img src="/logo-building-dark.png" alt="ollasoftware logo" class="brand-logo-img brand-logo-dark" />
      <span class="brand-blue-text">ollasoftware</span>
    </a>

    <!-- CENTER ZONE: Services, Work, Blog, Jobs, About -->
    <div class="nav-center">
      <a href="/services/" class:list={['nav-link', { active: isActive('/services/') }]}>Services</a>
      <a href="/work/" class:list={['nav-link', { active: isActive('/work/') }]}>Work</a>
      <a href="/blog/" class:list={['nav-link', { active: isActive('/blog/') }]}>Blog</a>
      <a href="/jobs/" class:list={['nav-link', { active: isActive('/jobs/') }]}>Jobs</a>
      <a href="/about/" class:list={['nav-link', { active: isActive('/about/') }]}>About</a>
    </div>

    <!-- RIGHT ZONE: Theme Toggle, Start a Project Button -->
    <div class="nav-right">
      <!-- iOS-Style Horizontal Interactive Toggle Switch -->
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle-switch"
        aria-label="Toggle dark mode"
        role="switch"
        aria-checked="false"
      >
        <span class="toggle-track">
          <span class="toggle-thumb">
            <!-- Sun icon in thumb when light -->
            <svg class="thumb-icon icon-sun" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"/>
              <line x1="12" y1="1" x2="12" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="23"/>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
              <line x1="1" y1="12" x2="3" y2="12"/>
              <line x1="21" y1="12" x2="23" y2="12"/>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
            </svg>
            <!-- Moon icon in thumb when dark -->
            <svg class="thumb-icon icon-moon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#1769FF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </span>
        </span>
      </button>

      <a href="/contact/" class="cta-btn">
        <span>Contact us</span>
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>

      <button
        type="button"
        class="nav-burger"
        aria-label="Open navigation menu"
        aria-controls="nav-links"
        aria-expanded="false"
      >
        <span class="burger-line" aria-hidden="true"></span>
        <span class="burger-line" aria-hidden="true"></span>
        <span class="burger-line" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Mobile Drawer Links -->
    <nav class="nav-links" id="nav-links" aria-label="Mobile Navigation">
      <a href="/services/" class:list={['nav-link', { active: isActive('/services/') }]}>Services</a>
      <a href="/work/" class:list={['nav-link', { active: isActive('/work/') }]}>Work</a>
      <a href="/blog/" class:list={['nav-link', { active: isActive('/blog/') }]}>Blog</a>
      <a href="/jobs/" class:list={['nav-link', { active: isActive('/jobs/') }]}>Jobs</a>
      <a href="/about/" class:list={['nav-link', { active: isActive('/about/') }]}>About</a>
      <a href="/contact/" class:list={['nav-link', { active: isActive('/contact/') }]}>Contact</a>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    // ── Mobile Menu Toggle ──
    const nav = document.getElementById('site-nav');
    if (nav) {
      const btn = nav.querySelector('.nav-burger');
      const setOpen = (open) => {
        nav.classList.toggle('nav-open', open);
        if (btn) {
          btn.setAttribute('aria-expanded', String(open));
          btn.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        }
        document.documentElement.style.overflow = open ? 'hidden' : '';
      };

      if (btn) {
        btn.addEventListener('click', () => {
          setOpen(!nav.classList.contains('nav-open'));
        });
      }

      nav.querySelectorAll('.nav-links a').forEach((a) => {
        a.addEventListener('click', () => setOpen(false));
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('nav-open')) setOpen(false);
      });

      document.addEventListener('click', (e) => {
        if (!nav.classList.contains('nav-open')) return;
        if (e.target instanceof Element && !nav.contains(e.target)) setOpen(false);
      });

      const mq = window.matchMedia('(min-width: 901px)');
      mq.addEventListener('change', (e) => { if (e.matches) setOpen(false); });
    }

    // ── Dark Mode Toggle ──
    const initThemeToggle = () => {
      const html = document.documentElement;
      const toggleBtn = document.getElementById('theme-toggle');
      if (!toggleBtn) return;

      const updateToggleState = (isDark) => {
        toggleBtn.setAttribute('aria-checked', String(isDark));
      };

      const isCurrentDark = html.getAttribute('data-theme') === 'dark';
      updateToggleState(isCurrentDark);

      // Handle user click
      toggleBtn.onclick = (e) => {
        e.preventDefault();
        const nowDark = html.getAttribute('data-theme') === 'dark';
        if (nowDark) {
          html.removeAttribute('data-theme');
          try { localStorage.setItem('olla-theme', 'light'); } catch (err) {}
          updateToggleState(false);
        } else {
          html.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('olla-theme', 'dark'); } catch (err) {}
          updateToggleState(true);
        }
      };
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeToggle);
    } else {
      initThemeToggle();
    }
  })();
</script>

<style>
  .nav {
    position: relative;
    width: 100%;
    height: 56px;
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    z-index: 100;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06) !important;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    transition: background-color 0.3s ease;
  }

  :global(html[data-theme="dark"]) .nav {
    background: rgba(7, 10, 18, 0.85) !important;
    border-bottom-color: rgba(255, 255, 255, 0.08) !important;
  }

  /* 3-Zone Header Layout: Left Brand, Center Links, Right CTA */
  .nav-container {
    width: 100%;
    max-width: 1320px;
    height: 100%;
    margin: 0 auto;
    padding: 0 28px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    box-sizing: border-box;
    position: relative;
  }

  /* LEFT ZONE: Brand / Logo */
  .brand {
    justify-self: start;
    text-decoration: none;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 7px !important;
    padding: 0;
    z-index: 2;
  }

  .brand-logo-img {
    height: 28px;
    width: auto;
    object-fit: contain;
    display: block !important;
    flex-shrink: 0;
  }

  .brand-logo-dark {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo-light {
    display: none !important;
  }

  :global(html[data-theme="dark"]) .brand-logo-dark {
    display: block !important;
    filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.45));
  }

  .brand-blue-text {
    font-family: var(--o-font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #1D6AF3 !important;
    line-height: 1;
  }

  /* CENTER ZONE: Navigation Menu Links with reduced spacing */
  .nav-center {
    justify-self: center;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 18px !important;
  }

  /* RIGHT ZONE: Theme Toggle & CTA */
  .nav-right {
    justify-self: end;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 14px !important;
    z-index: 2;
  }

  .nav-link {
    color: #4b5563;
    font-family: var(--o-font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 13.5px;
    font-weight: 500;
    text-decoration: none;
    padding: 3px 0;
    transition: color 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }

  :global(html[data-theme="dark"]) .nav-link {
    color: #d1d5db;
  }

  .nav-link:hover, .nav-link.active {
    color: #1D6AF3;
  }

  :global(html[data-theme="dark"]) .nav-link:hover,
  :global(html[data-theme="dark"]) .nav-link.active {
    color: #60a5fa;
  }

  /* ─── iOS Style Horizontal Toggle Switch ─── */
  .theme-toggle-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0 4px;
    cursor: pointer;
    outline: none;
    line-height: 1;
    height: 26px;
    flex-shrink: 0;
  }

  .toggle-track {
    position: relative;
    overflow: hidden;
    width: 48px;
    height: 26px;
    border-radius: 100px;
    background: #cbd5e1;
    border: 1px solid #94a3b8;
    padding: 2px;
    box-sizing: border-box;
    transition: background 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    align-items: center;
  }

  .toggle-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.3s ease;
    transform: translateX(0px);
  }

  html[data-theme="dark"] .toggle-track {
    background: #1769FF;
    border-color: #2979ff;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.3), 0 0 12px rgba(23, 105, 255, 0.4);
  }

  html[data-theme="dark"] .toggle-thumb {
    transform: translateX(22px);
    background: #ffffff;
  }

  .icon-sun  { display: block; }
  .icon-moon { display: none; }

  html[data-theme="dark"] .icon-sun  { display: none; }
  html[data-theme="dark"] .icon-moon { display: block; }

  .cta-btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1D6AF3;
    color: #ffffff;
    font-family: var(--o-font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
    padding: 10px 22px;
    border-radius: 100px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(29, 106, 243, 0.28);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    white-space: nowrap;
  }

  .cta-btn:hover {
    background: #1557D0;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(29, 106, 243, 0.38);
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .cta-btn:hover .arrow {
    transform: translateX(3px);
  }

  /* Hamburger menu for mobile */
  .nav-burger {
    display: none;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    background: transparent;
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }

  .burger-line {
    width: 16px;
    height: 1.5px;
    background: #111827;
    border-radius: 1px;
    transition: transform 0.18s, opacity 0.14s;
  }

  :global(html[data-theme="dark"]) .nav:not(.nav--sticky) {
    background: transparent !important;
  }

  :global(html[data-theme="dark"]) .burger-line {
    background: #ffffff;
  }

  .nav-open .burger-line:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .nav-open .burger-line:nth-child(2) { opacity: 0; }
  .nav-open .burger-line:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  .nav-links {
    display: none !important;
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .nav {
      height: 64px;
      padding-top: 0;
    }
    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 20px;
    }
    .nav-left { display: none !important; }
    .brand { justify-self: auto; padding: 0; transform: none; }
    .nav-right-link { display: none !important; }
    .nav-right {
      gap: 12px;
    }
    .nav-burger { display: inline-flex; }

    .nav-links {
      display: none !important;
      position: fixed;
      top: 64px;
      left: 0;
      right: 0;
      transform: none;
      background: #000000;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 12px 20px 24px;
      max-height: calc(100vh - 64px);
      overflow-y: auto;
    }

    .nav.nav-open .nav-links { display: flex !important; }

    .nav-links .nav-link {
      width: 100%;
      padding: 12px 0;
      font-size: 15px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: #ffffff !important;
    }
  }
</style>
