---
// Parent-company attribution band. Sits above SiteNav, scrolls away on first
// interaction. White surface deliberately contrasts the dark site so the
// attribution lands as a trust signal rather than getting lost in chrome.
// Source: https://www.networkershome.com/
---
<aside class="parent-banner" id="parent-banner" role="complementary" aria-label="Parent company">
  <a class="pb-link" href="https://www.networkershome.com/" target="_blank" rel="noopener">
    <span class="pb-badge" aria-hidden="true">NH</span>
    <span class="pb-text">
      <span class="pb-prefix">We are part of the</span>
      <strong class="pb-name">NETWORKERS&nbsp;HOME</strong>
      <span class="pb-suffix">Group</span>
    </span>
    <span class="pb-arrow" aria-hidden="true">↗</span>
  </a>
</aside>

<style>
  .parent-banner {
    background: #FFF0E6;
    color: #172033;
    border-bottom: 1px solid rgba(23, 32, 51, 0.08);
    width: 100%;
    height: 40px;
    min-height: 40px;
    box-sizing: border-box;
    position: relative;
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pb-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    height: 100%;
    box-sizing: border-box;
    text-decoration: none;
    color: #172033;
    font-family: 'Lato', sans-serif;
    font-size: 13px;
    line-height: 1.2;
    transition: background 0.15s ease;
  }

  .pb-link:hover {
    background: rgba(23, 32, 51, 0.04);
  }

  .pb-link:hover .pb-arrow {
    transform: translate(2px, -2px);
  }

  .pb-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: #172033;
    color: #ffffff;
    font-family: 'Lato', sans-serif;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.2px;
    flex-shrink: 0;
  }

  .pb-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pb-prefix {
    color: #172033;
    font-weight: 500;
    font-size: 13px;
  }

  .pb-name {
    color: #172033;
    font-weight: 700;
    letter-spacing: 0.4px;
    font-size: 13px;
  }

  .pb-suffix {
    color: #172033;
    font-weight: 500;
    font-size: 13px;
  }

  .pb-arrow {
    color: #172033;
    font-size: 13px;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  @media (max-width: 500px) {
    .parent-banner {
      height: 36px;
      min-height: 36px;
    }
    .pb-link { padding: 0 10px; gap: 6px; font-size: 11px; }
    .pb-badge { width: 17px; height: 17px; font-size: 8.5px; }
    .pb-prefix, .pb-name, .pb-suffix, .pb-arrow { font-size: 11px; }
  }
</style>
