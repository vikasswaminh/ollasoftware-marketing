---
// Parent-company attribution band. Sits above SiteNav, scrolls away on first
// interaction. White surface deliberately contrasts the dark site so the
// attribution lands as a trust signal rather than getting lost in chrome.
// Source: https://www.networkershome.com/
---
<aside class="parent-banner" id="parent-banner" role="complementary" aria-label="Parent company">
  <a class="pb-link" href="https://www.networkershome.com/" target="_blank" rel="noopener">
    <span class="pb-badge" aria-hidden="true">NH</span>
    <span class="pb-text">
      <span class="pb-prefix">We are part of the</span>
      <strong class="pb-name">NETWORKERS&nbsp;HOME</strong>
      <span class="pb-suffix">Group</span>
    </span>
    <span class="pb-arrow" aria-hidden="true">↗</span>
  </a>
</aside>

<style>
  .parent-banner {
    background: #08090d;
    color: #ffffff;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    width: 100%;
    min-height: 28px;
    position: relative;
    z-index: 101;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pb-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 4px 16px;
    text-decoration: none;
    color: #ffffff;
    font-family: var(--o-font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 11.5px;
    line-height: 1.2;
    transition: background 0.15s ease;
  }

  .pb-link:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .pb-link:hover .pb-arrow {
    transform: translate(2px, -2px);
  }

  .pb-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: #ffffff;
    color: #000000;
    font-family: var(--o-font-sans, 'Inter', system-ui, -apple-system, sans-serif);
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.2px;
    flex-shrink: 0;
  }

  .pb-text {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .pb-prefix {
    color: #a1a1aa;
    font-weight: 400;
  }

  .pb-name {
    color: #ffffff;
    font-weight: 700;
    letter-spacing: 0.4px;
    font-size: 11.5px;
  }

  .pb-suffix {
    color: #a1a1aa;
    font-weight: 400;
  }

  .pb-arrow {
    color: #a1a1aa;
    font-size: 11.5px;
    transition: transform 0.15s ease;
    flex-shrink: 0;
  }

  @media (max-width: 500px) {
    .pb-link { padding: 4px 10px; gap: 6px; font-size: 10px; }
    .pb-badge { width: 16px; height: 16px; font-size: 8.5px; }
    .pb-name { font-size: 10px; }
  }
</style>
