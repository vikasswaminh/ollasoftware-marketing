---
import { o } from '../../lib/tokens';

interface Props {
  points?: number[];
  color?: string;
  height?: number | string;
}

const {
  points = [38, 30, 34, 28, 26, 24, 22, 25, 20, 18, 16, 19, 14, 12, 14, 10, 12, 8, 10, 7],
  color = '#1D6AF3',
  height = 56,
} = Astro.props;

const W = 300, H = 60, max = 40;
const d = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'} ${(i * W) / (points.length - 1)} ${H - (p / max) * H}`)
  .join(' ');
const lastY = H - (points[points.length - 1]! / max) * H;
---
<div class="spark-wrapper" style={`height: ${typeof height === 'number' ? height + 'px' : height};`}>
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" width="100%" height="100%" role="img" aria-label="Speed trend chart">
    <defs>
      <linearGradient id="spark-gradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color={color} stop-opacity="0.30" />
        <stop offset="100%" stop-color={color} stop-opacity="0.02" />
      </linearGradient>
    </defs>
    <path d={`${d} L ${W} ${H} L 0 ${H} Z`} fill="url(#spark-gradient)" />
    <path d={d} fill="none" stroke={color} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx={W} cy={lastY} r="4" fill={color} />
  </svg>
</div>

<style>
  .spark-wrapper {
    width: 100%;
    position: relative;
    margin-top: 6px;
    display: flex;
    align-items: flex-end;
  }
  .spark-wrapper svg {
    width: 100%;
    overflow: visible;
  }
</style>
