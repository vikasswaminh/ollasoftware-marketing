---
interface Props {
  primary?: boolean;
  href?: string;
  size?: 'sm' | 'md';
  type?: 'button' | 'submit';
  ariaLabel?: string;
}

const { primary = false, href, size = 'md', type = 'button', ariaLabel } = Astro.props;
const cls = ['btn', primary ? 'primary' : 'outline', `size-${size}`];
const Tag = href ? 'a' : 'button';
const extra = href ? { href } : { type };
---
<Tag class:list={[...cls]} aria-label={ariaLabel} {...extra}>
  <slot />
</Tag>

<style>
  .btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: 'Lato', sans-serif;
    font-weight: 700;
    letter-spacing: -0.01em;
    cursor: pointer;
    text-decoration: none;
    border-radius: 100px;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  /* GitHub Shine effect sheen gradient on hover */
  .btn::before {
    content: "";
    position: absolute;
    top: -4rem;
    right: 0;
    width: 2.5rem;
    height: 10rem;
    transform: translateX(4rem) rotate(20deg);
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
    transition: transform 700ms ease;
    pointer-events: none;
    z-index: 2;
  }

  .btn:hover::before {
    transform: translateX(-14rem) rotate(20deg);
  }

  .btn.size-sm { padding: 8px 18px; font-size: 13px; min-height: 38px; border-radius: 100px; }
  .btn.size-md { padding: 12px 26px; font-size: 15px; min-height: 48px; border-radius: 100px; }

  .btn.primary {
    border: none;
    background: #1D6AF3;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(29, 106, 243, 0.28);
  }
  .btn.primary:hover {
    background: #1557D0;
    box-shadow: 0 6px 20px rgba(29, 106, 243, 0.38);
    transform: translateY(-1px);
    filter: none;
  }
  .btn.outline {
    border: 1px solid var(--o-line-hi);
    background: transparent;
    color: var(--o-ink);
    border-radius: 100px;
  }
  .btn.outline:hover {
    border-color: rgba(0, 0, 0, 0.25);
    background: rgba(0, 0, 0, 0.03);
    transform: translateY(-1px);
  }
  .btn:active { transform: translateY(1px); }
</style>
