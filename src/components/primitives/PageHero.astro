---
import Tag from './Tag.astro';

interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
}

const { eyebrow, title, sub, breadcrumb } = Astro.props;
---
<section class="hero">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="inner">
    {breadcrumb && breadcrumb.length > 0 && (
      <nav class="crumbs mono" aria-label="Breadcrumb">
        {breadcrumb.map((b, i) => (
          <>
            {b.href ? <a href={b.href}>{b.label}</a> : <span class="current">{b.label}</span>}
            {i < breadcrumb.length - 1 && <span class="sep">/</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <Tag>{eyebrow}</Tag>}
    <h1>{title}</h1>
    {sub && <p class="sub mono">{sub}</p>}
    {Astro.slots.has('default') && <div class="actions"><slot /></div>}
  </div>
</section>

<style>
  .hero {
    padding: 88px 56px 72px;
    border-bottom: 1px solid var(--o-line);
    position: relative;
    overflow: hidden;
  }
  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--o-line) 1px, transparent 1px);
    background-size: 24px 24px;
    -webkit-mask-image: radial-gradient(ellipse 60% 50% at 30% 30%, #000 30%, transparent 100%);
            mask-image: radial-gradient(ellipse 60% 50% at 30% 30%, #000 30%, transparent 100%);
    opacity: 0.5;
    pointer-events: none;
  }
  .inner { position: relative; }

  .crumbs {
    font-size: 12px;
    color: var(--o-mute);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .crumbs a { color: var(--o-mute); text-decoration: none; }
  .crumbs a:hover { color: var(--o-ink); }
  .crumbs .current { color: var(--o-ink); }
  .crumbs .sep { color: var(--o-faint); }

  h1 {
    margin: 20px 0 22px;
    font-size: 64px;
    line-height: 0.98;
    letter-spacing: -2.2px;
    font-weight: 600;
    color: var(--o-ink);
    max-width: 880px;
  }

  .sub {
    font-size: 15px;
    line-height: 1.7;
    color: var(--o-mute);
    max-width: 620px;
    margin: 0;
  }

  .actions {
    margin-top: 28px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero { padding: 64px 24px 48px; }
    h1 { font-size: 44px; letter-spacing: -1.4px; }
  }
</style>
