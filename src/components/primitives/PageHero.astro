---
import Tag from './Tag.astro';

interface Props {
  eyebrow?: string;
  title: string;
  sub?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
}

const { eyebrow, title, sub, breadcrumb } = Astro.props;
---
<section class="hero">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="inner">
    {breadcrumb && breadcrumb.length > 0 && (
      <nav class="crumbs mono" aria-label="Breadcrumb">
        {breadcrumb.map((b, i) => (
          <>
            {b.href ? <a href={b.href}>{b.label}</a> : <span class="current">{b.label}</span>}
            {i < breadcrumb.length - 1 && <span class="sep">/</span>}
          </>
        ))}
      </nav>
    )}
    {eyebrow && <Tag>{eyebrow}</Tag>}
    <h1>{title}</h1>
    {sub && <p class="sub mono">{sub}</p>}
    {Astro.slots.has('default') && <div class="actions"><slot /></div>}
  </div>
</section>

<style>
  .hero {
    padding: 88px 56px 72px;
    border-bottom: 1px solid var(--o-line);
    position: relative;
    overflow: hidden;
  }
  .grid-bg {
    display: none !important;
  }
  .inner { position: relative; }

  .crumbs {
    font-size: 10px;
    color: var(--o-mute);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .crumbs a { color: var(--o-mute); text-decoration: none; }
  .crumbs a:hover { color: var(--o-ink); }
  .crumbs .current { color: var(--o-ink); }
  .crumbs .sep { color: var(--o-faint); }

  h1 {
    margin: 16px 0 16px;
    font-size: clamp(24px, 5.5vw, 56px);
    line-height: 1.05;
    letter-spacing: clamp(-0.8px, -0.25vw, -2px);
    font-weight: 700;
    color: var(--o-ink);
    max-width: 880px;
    overflow-wrap: break-word;
    font-family: 'Lato', sans-serif;
  }

  .sub {
    font-size: clamp(11.5px, 1.2vw, 13px);
    line-height: 1.55;
    color: var(--o-mute);
    max-width: 620px;
    margin: 0;
    font-family: 'Lato', sans-serif;
  }

  .actions {
    margin-top: 20px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .hero { padding: 48px 16px 36px; }
  }
  @media (max-width: 500px) {
    .hero { padding: 28px 14px 28px; }
    h1 {
      font-size: clamp(20px, 6.5vw, 28px);
      margin: 10px 0 10px;
    }
    .sub {
      font-size: 12px;
    }
    .crumbs {
      margin-bottom: 14px;
    }
  }
</style>
