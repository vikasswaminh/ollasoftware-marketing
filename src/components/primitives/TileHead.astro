---
interface Props {
  label: string;
  tag?: string;
}

const { label, tag } = Astro.props;
---
<div class="tile-head">
  <span class="label mono">{label}</span>
  {tag && <span class="tag mono">{tag}</span>}
</div>

<style>
  .tile-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    border-bottom: 1px solid var(--o-line);
  }
  .label { font-size: 8px; color: var(--o-mute); letter-spacing: 0.3px; }
  .tag { font-size: 9px; color: var(--o-faint); }
</style>
