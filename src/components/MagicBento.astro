---
import './MagicBento.css';

interface Card {
  color?: string;
  title: string;
  description: string;
  label: string;
}

interface Props {
  textAutoHide?: boolean;
  enableStars?: boolean;
  enableSpotlight?: boolean;
  enableBorderGlow?: boolean;
  disableAnimations?: boolean;
  spotlightRadius?: number;
  particleCount?: number;
  enableTilt?: boolean;
  glowColor?: string;
  clickEffect?: boolean;
  enableMagnetism?: boolean;
  cards?: Card[];
}

const {
  textAutoHide = true,
  enableStars = true,
  enableSpotlight = true,
  enableBorderGlow = true,
  disableAnimations = false,
  spotlightRadius = 400,
  particleCount = 12,
  enableTilt = false,
  glowColor = '23, 105, 255',
  clickEffect = true,
  enableMagnetism = false,
  cards = [
    {
      color: '#ffffff',
      title: 'AI Agents',
      description: 'Autonomous software that works for your team.',
      label: 'Intelligence'
    },
    {
      color: '#ffffff',
      title: 'Automation',
      description: 'Turn repetitive workflows into software.',
      label: 'Efficiency'
    },
    {
      color: '#ffffff',
      title: 'Analytics',
      description: 'Understand your product with real-time intelligence.',
      label: 'Insights'
    },
    {
      color: '#ffffff',
      title: 'Security',
      description: 'Enterprise-grade infrastructure and protection.',
      label: 'Protection'
    },
    {
      color: '#ffffff',
      title: 'Integrations',
      description: 'Connect your existing tools and systems.',
      label: 'Connectivity'
    },
    {
      color: '#ffffff',
      title: 'Deployment',
      description: 'Ship production software faster.',
      label: 'Delivery'
    }
  ]
} = Astro.props;

const config = JSON.stringify({
  enableStars,
  enableSpotlight,
  enableBorderGlow,
  disableAnimations,
  spotlightRadius,
  particleCount,
  enableTilt,
  glowColor,
  clickEffect,
  enableMagnetism
});
---

<div
  class="magic-bento-root"
  data-magic-bento-config={config}
>
  <div class="card-grid bento-section">
    {
      cards.map((card, index) => (
        <div
          class:list={[
            'magic-bento-card',
            textAutoHide && 'magic-bento-card--text-autohide',
            enableBorderGlow && 'magic-bento-card--border-glow',
            enableStars && 'particle-container'
          ]}
          data-card-index={index}
          style={`background-color: ${card.color || '#ffffff'}; --glow-color: rgb(${glowColor});`}
        >
          <div class="magic-bento-card__header">
            <div class="magic-bento-card__label mono">
              {card.label}
            </div>
          </div>

          <div class="magic-bento-card__content">
            <h3 class="magic-bento-card__title">
              {card.title}
            </h3>

            <p class="magic-bento-card__description">
              {card.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  const DEFAULT_SPOTLIGHT_RADIUS = 400;
  const MOBILE_BREAKPOINT = 768;

  interface BentoConfig {
    enableStars: boolean;
    enableSpotlight: boolean;
    enableBorderGlow: boolean;
    disableAnimations: boolean;
    spotlightRadius: number;
    particleCount: number;
    enableTilt: boolean;
    glowColor: string;
    clickEffect: boolean;
    enableMagnetism: boolean;
  }

  const calculateSpotlightValues = (radius: number) => ({
    proximity: radius * 0.5,
    fadeDistance: radius * 0.75
  });

  const createParticle = (x: number, y: number, color: string) => {
    const particle = document.createElement('div');
    particle.className = 'particle';
    Object.assign(particle.style, {
      position: 'absolute',
      width: '4px',
      height: '4px',
      borderRadius: '50%',
      background: `rgba(${color}, 1)`,
      boxShadow: `0 0 6px rgba(${color}, 0.6)`,
      pointerEvents: 'none',
      zIndex: '100',
      left: `${x}px`,
      top: `${y}px`
    });
    return particle;
  };

  const initMagicBento = (root: HTMLElement) => {
    const config: BentoConfig = JSON.parse(
      root.dataset.magicBentoConfig || '{}'
    );

    const cards = Array.from(
      root.querySelectorAll('.magic-bento-card, .bento-card')
    ) as HTMLElement[];

    if (!cards.length) return;

    const isMobile = () => window.innerWidth <= MOBILE_BREAKPOINT;
    const animationsDisabled = () => config.disableAnimations || isMobile();

    const particleTemplates = new Map<HTMLElement, HTMLElement[]>();
    const activeParticles = new Map<HTMLElement, HTMLElement[]>();
    const particleTimeouts = new Map<HTMLElement, number[]>();
    const hoveredCards = new Set<HTMLElement>();

    const initializeParticleTemplates = (card: HTMLElement) => {
      if (particleTemplates.has(card)) return;
      const rect = card.getBoundingClientRect();
      const particles = Array.from({ length: config.particleCount || 12 }, () =>
        createParticle(
          Math.random() * rect.width,
          Math.random() * rect.height,
          config.glowColor || '23, 105, 255'
        )
      );
      particleTemplates.set(card, particles);
    };

    const clearParticles = (card: HTMLElement) => {
      const timeouts = particleTimeouts.get(card) || [];
      timeouts.forEach(clearTimeout);
      particleTimeouts.set(card, []);

      const particles = activeParticles.get(card) || [];
      particles.forEach((particle) => {
        gsap.to(particle, {
          scale: 0,
          opacity: 0,
          duration: 0.3,
          ease: 'back.in(1.7)',
          onComplete: () => {
            particle.remove();
          }
        });
      });
      activeParticles.set(card, []);
    };

    const animateParticles = (card: HTMLElement) => {
      if (animationsDisabled() || !hoveredCards.has(card)) return;
      initializeParticleTemplates(card);
      const templates = particleTemplates.get(card) || [];

      templates.forEach((template, index) => {
        const timeout = window.setTimeout(() => {
          if (!hoveredCards.has(card) || animationsDisabled()) return;

          const particle = template.cloneNode(true) as HTMLElement;
          card.appendChild(particle);

          const active = activeParticles.get(card) || [];
          active.push(particle);
          activeParticles.set(card, active);

          gsap.fromTo(
            particle,
            { scale: 0, opacity: 0 },
            { scale: 1, opacity: 1, duration: 0.3, ease: 'back.out(1.7)' }
          );

          gsap.to(particle, {
            x: (Math.random() - 0.5) * 80,
            y: (Math.random() - 0.5) * 80,
            rotation: Math.random() * 360,
            duration: 2 + Math.random() * 2,
            ease: 'none',
            repeat: -1,
            yoyo: true
          });

          gsap.to(particle, {
            opacity: 0.3,
            duration: 1.5,
            ease: 'power2.inOut',
            repeat: -1,
            yoyo: true
          });
        }, index * 100);

        const timeouts = particleTimeouts.get(card) || [];
        timeouts.push(timeout);
        particleTimeouts.set(card, timeouts);
      });
    };

    const handleCardEnter = (card: HTMLElement) => {
      if (animationsDisabled()) return;
      hoveredCards.add(card);
      if (config.enableStars) animateParticles(card);
      if (config.enableTilt) {
        gsap.to(card, {
          rotateX: 4,
          rotateY: 4,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 1000
        });
      }
    };

    const handleCardLeave = (card: HTMLElement) => {
      hoveredCards.delete(card);
      clearParticles(card);
      if (animationsDisabled()) return;
      if (config.enableTilt) {
        gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.3, ease: 'power2.out' });
      }
      if (config.enableMagnetism) {
        gsap.to(card, { x: 0, y: 0, duration: 0.3, ease: 'power2.out' });
      }
    };

    const handleCardMove = (event: MouseEvent, card: HTMLElement) => {
      if (animationsDisabled()) return;
      if (!config.enableTilt && !config.enableMagnetism) return;

      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;

      if (config.enableTilt) {
        const rotateX = ((y - centerY) / centerY) * -6;
        const rotateY = ((x - centerX) / centerX) * 6;
        gsap.to(card, { rotateX, rotateY, duration: 0.1, ease: 'power2.out', transformPerspective: 1000 });
      }

      if (config.enableMagnetism) {
        const magnetX = (x - centerX) * 0.04;
        const magnetY = (y - centerY) * 0.04;
        gsap.to(card, { x: magnetX, y: magnetY, duration: 0.3, ease: 'power2.out' });
      }
    };

    const handleCardClick = (event: MouseEvent, card: HTMLElement) => {
      if (!config.clickEffect || animationsDisabled()) return;

      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const maxDistance = Math.max(
        Math.hypot(x, y),
        Math.hypot(x - rect.width, y),
        Math.hypot(x, y - rect.height),
        Math.hypot(x - rect.width, y - rect.height)
      );

      const ripple = document.createElement('div');
      ripple.className = 'magic-bento-ripple';
      Object.assign(ripple.style, {
        width: `${maxDistance * 2}px`,
        height: `${maxDistance * 2}px`,
        left: `${x - maxDistance}px`,
        top: `${y - maxDistance}px`,
        background: `radial-gradient(circle, rgba(${config.glowColor}, 0.35) 0%, rgba(${config.glowColor}, 0.15) 35%, transparent 70%)`
      });

      card.appendChild(ripple);
      gsap.fromTo(
        ripple,
        { scale: 0, opacity: 1 },
        { scale: 1, opacity: 0, duration: 0.75, ease: 'power2.out', onComplete: () => ripple.remove() }
      );
    };

    const updateCardGlow = (
      card: HTMLElement,
      mouseX: number,
      mouseY: number,
      intensity: number,
      radius: number
    ) => {
      const rect = card.getBoundingClientRect();
      const relativeX = ((mouseX - rect.left) / rect.width) * 100;
      const relativeY = ((mouseY - rect.top) / rect.height) * 100;

      card.style.setProperty('--glow-x', `${relativeX}%`);
      card.style.setProperty('--glow-y', `${relativeY}%`);
      card.style.setProperty('--glow-intensity', intensity.toString());
      card.style.setProperty('--glow-radius', `${radius}px`);
    };

    let spotlight: HTMLElement | null = null;
    const createSpotlight = () => {
      if (!config.enableSpotlight || animationsDisabled()) return;
      spotlight = document.createElement('div');
      spotlight.className = 'global-spotlight';
      spotlight.style.background = `radial-gradient(circle, rgba(${config.glowColor}, 0.12) 0%, rgba(${config.glowColor}, 0.05) 30%, transparent 70%)`;
      document.body.appendChild(spotlight);
    };

    createSpotlight();

    const cardCleanup: Array<() => void> = [];

    cards.forEach((card) => {
      const enter = () => handleCardEnter(card);
      const leave = () => handleCardLeave(card);
      const move = (e: MouseEvent) => handleCardMove(e, card);
      const click = (e: MouseEvent) => handleCardClick(e, card);

      card.addEventListener('mouseenter', enter);
      card.addEventListener('mouseleave', leave);
      card.addEventListener('mousemove', move);
      card.addEventListener('click', click);

      cardCleanup.push(() => {
        card.removeEventListener('mouseenter', enter);
        card.removeEventListener('mouseleave', leave);
        card.removeEventListener('mousemove', move);
        card.removeEventListener('click', click);
        clearParticles(card);
      });
    });

    const handleMouseMove = (event: MouseEvent) => {
      if (!spotlight || animationsDisabled()) return;

      const sectionRect = root.getBoundingClientRect();
      const inside =
        event.clientX >= sectionRect.left &&
        event.clientX <= sectionRect.right &&
        event.clientY >= sectionRect.top &&
        event.clientY <= sectionRect.bottom;

      if (!inside) {
        gsap.to(spotlight, { opacity: 0, duration: 0.3 });
        cards.forEach((card) => {
          card.style.setProperty('--glow-intensity', '0');
        });
        return;
      }

      const { proximity, fadeDistance } = calculateSpotlightValues(
        config.spotlightRadius || DEFAULT_SPOTLIGHT_RADIUS
      );

      let minDistance = Infinity;

      cards.forEach((card) => {
        const rect = card.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const distance =
          Math.hypot(event.clientX - centerX, event.clientY - centerY) -
          Math.max(rect.width, rect.height) / 2;

        const effectiveDistance = Math.max(0, distance);
        minDistance = Math.min(minDistance, effectiveDistance);

        let intensity = 0;
        if (effectiveDistance <= proximity) {
          intensity = 1;
        } else if (effectiveDistance <= fadeDistance) {
          intensity =
            (fadeDistance - effectiveDistance) / (fadeDistance - proximity);
        }

        updateCardGlow(
          card,
          event.clientX,
          event.clientY,
          intensity,
          config.spotlightRadius || DEFAULT_SPOTLIGHT_RADIUS
        );
      });

      gsap.to(spotlight, {
        left: event.clientX,
        top: event.clientY,
        duration: 0.1,
        ease: 'power2.out'
      });

      const opacity =
        minDistance <= proximity
          ? 0.7
          : minDistance <= fadeDistance
            ? ((fadeDistance - minDistance) / (fadeDistance - proximity)) * 0.7
            : 0;

      gsap.to(spotlight, {
        opacity,
        duration: opacity > 0 ? 0.2 : 0.4,
        ease: 'power2.out'
      });
    };

    document.addEventListener('mousemove', handleMouseMove);

    const handleResize = () => {
      if (isMobile() && spotlight) {
        gsap.to(spotlight, { opacity: 0, duration: 0.2 });
      }
    };

    window.addEventListener('resize', handleResize);

    return () => {
      cardCleanup.forEach((cleanup) => cleanup());
      document.removeEventListener('mousemove', handleMouseMove);
      window.removeEventListener('resize', handleResize);
      spotlight?.remove();
    };
  };

  document.querySelectorAll<HTMLElement>('.magic-bento-root').forEach((root) => {
    initMagicBento(root);
  });
</script>
