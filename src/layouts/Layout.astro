---
import '../styles/global.css';
import ParentBanner from '../components/chrome/ParentBanner.astro';
import SiteNav from '../components/chrome/SiteNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { organizationLd, websiteLd, breadcrumbLd, ldScript } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Optional extra JSON-LD payload(s) injected before </head>. */
  jsonLd?: unknown[];
  /** Breadcrumb trail for BreadcrumbList schema. If omitted, no crumb schema. */
  breadcrumb?: Array<{ name: string; url: string }>;
  /** Custom OG image path (PNG); defaults to /og-image.png. */
  ogImage?: string;
  /** Hide top layout nav if embedded inside page hero */
  hideNav?: boolean;
}

const {
  title,
  description = 'Pioneer AI software development company in India. Headquartered in Bangalore. Owners of 40+ AI brands in production. We build custom AI, software, AEO/SEO, social and performance marketing for clients worldwide.',
  jsonLd = [],
  breadcrumb,
  ogImage = '/og-image.png',
  hideNav = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbs = new URL(ogImage, Astro.site).toString();
const ogImageSquareAbs = new URL('/og-image-square.png', Astro.site).toString();

// Always inject Organization + WebSite; add Breadcrumb if provided; then any
// page-specific schemas the caller passed via `jsonLd`.
const allLd: unknown[] = [organizationLd, websiteLd];
if (breadcrumb && breadcrumb.length > 0) allLd.push(breadcrumbLd(breadcrumb));
for (const x of jsonLd) allLd.push(x);
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Fonts: Lato (all weights & styles), Inter (for logo), JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Cache Invalidation: Instruct all browsers and proxies to always revalidate HTML -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <script is:inline>
      window.addEventListener('pageshow', function(e) {
        if (e.persisted) window.location.reload();
      });
    </script>

    <!-- Crawl policy mirrors robots.txt; per-page meta makes intent explicit. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large" />

    <!-- Geo targeting: India / Bangalore -->
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bangalore" />
    <meta name="geo.position" content="12.9716;77.5946" />
    <meta name="ICBM" content="12.9716, 77.5946" />

    <!-- hreflang: single-locale for now (en-IN serves worldwide too) -->
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Author / publisher -->
    <meta name="author" content="Ollasoftware" />
    <meta name="publisher" content="Ollasoftware" />
    <link rel="publisher" href="https://ollasoftware.com/" />
    <meta name="theme-color" content="#0f1114" />
    <meta name="application-name" content="Ollasoftware" />

    <!-- Favicons: Multi-resolution icons for browser tabs, bookmarks and search engines -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=3" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=3" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=3" />
    <link rel="shortcut icon" href="/favicon.ico?v=3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=3" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png?v=3" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png?v=3" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph (Facebook / WhatsApp / Slack / Discord / Telegram / LinkedIn).
         WhatsApp specifically requires PNG with absolute URL, declared width
         and height, and an image under ~300 KB. og-image.png is 108 KB. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ollasoftware" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:secure_url" content={ogImageAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ollasoftware — pioneer AI software development company in India, headquartered in Bangalore" />
    <!-- Second image (square) for clients that prefer 1:1 (iMessage, some
         WhatsApp surfaces, Threads). -->
    <meta property="og:image" content={ogImageSquareAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ollasoftware" />
    <meta name="twitter:creator" content="@ollasoftware" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content="Ollasoftware — pioneer AI software development company in India, headquartered in Bangalore" />

    <!-- Performance: resource hints -->
    <link rel="dns-prefetch" href="//ollasoftware-marketing.pages.dev" />

    <!-- AEO crawler hints: where to find the long-form summary -->
    <link rel="alternate" type="text/markdown" title="LLM index" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" title="LLM index (full)" href="/llms-full.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Instant Theme Detection Script -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('olla-theme');
          if (saved === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          } else if (saved === 'light') {
            document.documentElement.removeAttribute('data-theme');
          } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Structured data: Organization + WebSite + optional Breadcrumb + per-page schemas -->
    {allLd.map(ld => <Fragment set:html={ldScript(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <ParentBanner />
    <div class="site-header-sticky">
      {!hideNav && <SiteNav />}
    </div>
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <!-- Universal Blur Fade-In Scroll-Trigger Engine -->
    <script is:inline>
      (() => {
        if (typeof window === 'undefined') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.scroll-reveal-item, [data-animate="fade-in"], .bento-card, .rule-accordion-item, .testimonial-card, .work-card, .feature-card, .gallery-slide-card, .blog-card, .job-card, .client-logo-item').forEach(el => {
            el.classList.add('is-revealed');
          });
          return;
        }

        const selector = '.scroll-reveal-item, [data-animate="fade-in"], .bento-card, .rule-accordion-item, .testimonial-card, .work-card, .feature-card, .gallery-slide-card, .blog-card, .job-card, .client-logo-item';

        function initScrollReveals() {
          const elements = document.querySelectorAll(selector);
          if (!elements.length) return;

          // Stagger sibling items inside parent containers
          const parents = new Set();
          elements.forEach(el => {
            if (el.parentElement) parents.add(el.parentElement);
          });

          parents.forEach(parent => {
            const siblings = parent.querySelectorAll(selector);
            siblings.forEach((el, index) => {
              if (!el.style.getPropertyValue('--reveal-delay')) {
                el.style.setProperty('--reveal-delay', `${(index % 4) * 90}ms`);
              }
            });
          });

          if (!('IntersectionObserver' in window)) {
            elements.forEach(el => el.classList.add('is-revealed'));
            return;
          }

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
          );

          elements.forEach((el) => {
            if (el.getBoundingClientRect().top < window.innerHeight - 30) {
              el.classList.add('is-revealed');
            } else {
              observer.observe(el);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initScrollReveals);
        } else {
          initScrollReveals();
        }

        // Safety net to ensure no element stays hidden
        setTimeout(() => {
          document.querySelectorAll(selector).forEach(el => {
            if (!el.classList.contains('is-revealed')) {
              const rect = el.getBoundingClientRect();
              if (rect.top < window.innerHeight) {
                el.classList.add('is-revealed');
              }
            }
          });
        }, 1200);
      })();
    </script>
  </body>
</html>

<style is:global>
  .site-header-sticky {
    position: sticky !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    z-index: 1000 !important;
  }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--o-accent);
    color: var(--o-accent-ink);
    padding: 10px 16px;
    z-index: 100;
    text-decoration: none;
    font-family: var(--o-font-mono);
    font-size: 11px;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
