---
import '../styles/global.css';
import SiteNav from '../components/chrome/SiteNav.astro';
import SiteFooter from '../components/chrome/SiteFooter.astro';
import { organizationLd, websiteLd, breadcrumbLd, ldScript } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  /** Optional extra JSON-LD payload(s) injected before </head>. */
  jsonLd?: unknown[];
  /** Breadcrumb trail for BreadcrumbList schema. If omitted, no crumb schema. */
  breadcrumb?: Array<{ name: string; url: string }>;
  /** Custom OG image path (PNG); defaults to /og-image.png. */
  ogImage?: string;
}

const {
  title,
  description = 'Pioneer AI software development company in India. Headquartered in Bangalore. Owners of 40+ AI brands in production. We build custom AI, software, AEO/SEO, social and performance marketing for clients worldwide.',
  jsonLd = [],
  breadcrumb,
  ogImage = '/og-image.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbs = new URL(ogImage, Astro.site).toString();
const ogImageSquareAbs = new URL('/og-image-square.png', Astro.site).toString();

// Always inject Organization + WebSite; add Breadcrumb if provided; then any
// page-specific schemas the caller passed via `jsonLd`.
const allLd: unknown[] = [organizationLd, websiteLd];
if (breadcrumb && breadcrumb.length > 0) allLd.push(breadcrumbLd(breadcrumb));
for (const x of jsonLd) allLd.push(x);
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Crawl policy mirrors robots.txt; per-page meta makes intent explicit. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-image-preview:large" />

    <!-- Geo targeting: India / Bangalore -->
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Bangalore" />
    <meta name="geo.position" content="12.9716;77.5946" />
    <meta name="ICBM" content="12.9716, 77.5946" />

    <!-- hreflang: single-locale for now (en-IN serves worldwide too) -->
    <link rel="alternate" hreflang="en-IN" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Author / publisher -->
    <meta name="author" content="Ollasoftware" />
    <meta name="publisher" content="Ollasoftware" />
    <link rel="publisher" href="https://ollasoftware.com/" />
    <meta name="theme-color" content="#0f1114" />
    <meta name="application-name" content="Ollasoftware" />

    <!-- Favicons: SVG for modern browsers, PNG fallbacks for everything else.
         Order matters: browsers pick the first format they understand. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph (Facebook / WhatsApp / Slack / Discord / Telegram / LinkedIn).
         WhatsApp specifically requires PNG with absolute URL, declared width
         and height, and an image under ~300 KB. og-image.png is 108 KB. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ollasoftware" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:secure_url" content={ogImageAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ollasoftware — pioneer AI software development company in India, headquartered in Bangalore" />
    <!-- Second image (square) for clients that prefer 1:1 (iMessage, some
         WhatsApp surfaces, Threads). -->
    <meta property="og:image" content={ogImageSquareAbs} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1080" />
    <meta property="og:image:height" content="1080" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ollasoftware" />
    <meta name="twitter:creator" content="@ollasoftware" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <meta name="twitter:image:alt" content="Ollasoftware — pioneer AI software development company in India, headquartered in Bangalore" />

    <!-- Performance: resource hints -->
    <link rel="dns-prefetch" href="//ollasoftware-marketing.pages.dev" />

    <!-- AEO crawler hints: where to find the long-form summary -->
    <link rel="alternate" type="text/markdown" title="LLM index" href="/llms.txt" />
    <link rel="alternate" type="text/markdown" title="LLM index (full)" href="/llms-full.txt" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Structured data: Organization + WebSite + optional Breadcrumb + per-page schemas -->
    {allLd.map(ld => <Fragment set:html={ldScript(ld)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--o-accent);
    color: #0a0a0a;
    padding: 10px 16px;
    z-index: 100;
    text-decoration: none;
    font-family: var(--o-font-mono);
    font-size: 13px;
  }
  .skip-link:focus {
    left: 0;
  }
</style>
