---
// Hybrid mode: prerender to static HTML (default for current pages).
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Btn from '../components/primitives/Btn.astro';
import Tag from '../components/primitives/Tag.astro';
import { jobs, jobCategories, hiringOverview, type JobCategoryKey } from '../lib/jobs';
import { SITE } from '../lib/seo';

// Group jobs by category, preserving canonical order.
const grouped = jobCategories.map(cat => ({
  ...cat,
  items: jobs.filter(j => j.category === cat.key),
}));

// Build a JobPosting JSON-LD per role so Google Jobs and answer engines can
// surface them as discrete postings. Valid through 90 days from build time.
const now = new Date();
const validThrough = new Date(now.getTime() + 90 * 24 * 60 * 60 * 1000);

const employmentTypeMap: Record<string, string> = {
  'Full-time': 'FULL_TIME',
  'Part-time': 'PART_TIME',
  'Contract': 'CONTRACTOR',
  'Internship': 'INTERN',
};

const jobLd = jobs.map(j => ({
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  '@id': `${SITE}/jobs/#${j.slug}`,
  title: j.title,
  description: `${j.summary} Skills: ${j.skills.join(', ')}.`,
  datePosted: now.toISOString().slice(0, 10),
  validThrough: validThrough.toISOString().slice(0, 10),
  employmentType: employmentTypeMap[j.employmentType] ?? 'FULL_TIME',
  hiringOrganization: { '@id': `${SITE}#organization` },
  jobLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'HSR Layout',
      addressLocality: 'Bangalore',
      addressRegion: 'Karnataka',
      postalCode: '560102',
      addressCountry: 'IN',
    },
  },
  jobLocationType: 'TELECOMMUTE',
  applicantLocationRequirements: { '@type': 'Country', name: 'India' },
  baseSalary: {
    '@type': 'MonetaryAmount',
    currency: 'INR',
    value: { '@type': 'QuantitativeValue', unitText: 'YEAR', name: j.compensation },
  },
  experienceRequirements: j.experience,
  skills: j.skills.join(', '),
  industry: 'AI Software Development',
  occupationalCategory: jobCategories.find(c => c.key === j.category)?.label ?? '',
  totalJobOpenings: j.openings,
  url: `${SITE}/jobs/#${j.slug}`,
  directApply: false,
}));

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  numberOfItems: jobs.length,
  itemListElement: jobs.map((j, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: j.title,
    url: `${SITE}/jobs/#${j.slug}`,
  })),
};

// Filter facet options
const allLocations = Array.from(new Set(jobs.map(j => {
  if (j.location.includes('Work From Office')) return 'Bangalore · Work From Office';
  if (j.location.includes('Work from home')) return 'Work from home · India';
  return 'Bangalore · Hybrid';
})));

const allJobTypes = ['Full-time', 'Internship'];

const allSkills = [
  'Claude Code', 'Cursor', 'React 19', 'TypeScript', 'Next.js 15', 'Python 3.13',
  'Swift 6', 'Kotlin 2', 'Kubernetes', 'Anthropic MCP SDK', 'FastAPI', 'Figma',
  'v0.dev', 'Palo Alto PAN-OS 11', 'Splunk ES', 'Microsoft Sentinel', 'DSPy',
  'LangGraph', 'OpenAPI 3.1', 'Burp Suite Pro', 'ISO 27001', 'SEO research'
];

const organizations = [
  'Ollasoftware Ecosystem', 'AEONITI', 'Crawlcrawl', 'Switchllm', 'Ollima',
  'NHPREP', 'Quick21', 'FreeFreeCV', 'Networkers Home'
];

const degrees = [
  { id: 'mba', label: 'MBA / PGP (IIM & Premier B-Schools)', match: 'mba' },
  { id: 'premier', label: 'IIT / IIM / NIT / IIIT Premier Grads', match: 'premier' },
  { id: 'any', label: 'Bachelor\'s / Skills First (No Degree Gate)', match: 'any' }
];

const experienceLevels = [
  { id: 'fresher', label: 'Freshers / 0–1 yrs (Intern & MBA)', match: 'fresher' },
  { id: 'mid-2-5', label: '2–5 / 2–6 years (Engineers & Designers)', match: '2–' },
  { id: 'senior-3-8', label: '3–8 years (Senior, DevOps, Security)', match: '3–' },
  { id: 'lead-4-8', label: '4–8 years (Lead & Product Managers)', match: '4–' }
];
---
<Layout
  title="Jobs at Ollasoftware — 1,200+ AI Engineering Roles in Bangalore, India"
  description="1,200+ open roles at Ollasoftware across 16 founder companies in Bangalore. Frontend, backend, MCP server, DevOps, SOC, pentest, prompt engineering, AI product. Hybrid (3+2). ₹4.5–15 LPA. 1+ year AI tooling required."
  breadcrumb={[
    { name: 'Home', url: `${SITE}/` },
    { name: 'Jobs', url: `${SITE}/jobs/` },
  ]}
  jsonLd={[itemListLd, ...jobLd]}
>
  <!-- Hero Section (Clean 2-Line Heading & Static Background Emblem) -->
  <section class="jobs-hero">
    <div class="hero-inner">
      <div class="hero-left">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href="/">home</a>
          <span class="sep">/</span>
          <span class="current">jobs</span>
        </nav>
        
        <div class="eyebrow-wrap">
          <Tag color="var(--o-accent)">JOBS · BANGALORE HQ</Tag>
        </div>

        <h1>1,200+ open roles. 16 founder<br class="hero-br" />companies. One senior team.</h1>
        
        <p class="hero-sub">
          Build AI software in production at the pioneer AI software development company in India. Real work on real founder-owned products — AEONITI, Crawlcrawl, Switchllm, Ollima, NHPREP, Quick21, FreeFreeCV and more. Hybrid out of HSR Layout, Bangalore.
        </p>

        <div class="hero-actions">
          <Btn primary href="#mba-fresher-ai-strategy-sales-distribution-class-of-2026">Featured: MBA Freshers →</Btn>
          <Btn href="#filter-section">Browse all roles</Btn>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-image-container">
          <div class="image-glow" aria-hidden="true"></div>
          <img
            src="/job.png"
            alt="Ollasoftware Jobs"
            class="hero-pure-image"
            width="340"
            height="340"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Straight Horizontal Overview Stats Strip -->
  <section class="overview-strip-section" aria-label="Hiring Overview">
    <div class="overview-strip">
      <div class="strip-stat">
        <span class="stat-main">1200+</span>
        <span class="stat-sub mono">TOTAL OPENINGS</span>
      </div>
      <div class="strip-stat">
        <span class="stat-main">16</span>
        <span class="stat-sub mono">FOUNDER COMPANIES</span>
      </div>
      <div class="strip-stat">
        <span class="stat-main accent-blue">Bangalore</span>
        <span class="stat-sub mono">HSR LAYOUT, BANGALORE</span>
      </div>
      <div class="strip-stat">
        <span class="stat-main accent-orange">₹4.5 – 15 LPA</span>
        <span class="stat-sub mono">SALARY BAND</span>
      </div>
      <div class="strip-stat">
        <span class="stat-main accent-blue">Hybrid</span>
        <span class="stat-sub mono">3 DAYS OFFICE, 2 DAYS REMOTE</span>
      </div>
      <div class="strip-stat">
        <span class="stat-main">1 year</span>
        <span class="stat-sub mono">MIN AI TOOLING XP</span>
      </div>
    </div>
  </section>

  <!-- Category Oval Pill Bar (No 'JUMP TO:', Oval Shape) -->
  <section class="category-pill-bar" aria-label="Filter by Category">
    <div class="pill-bar-inner">
      <div class="pill-list mono" id="category-pills">
        <button type="button" class="cat-pill active" data-cat="all">
          <span class="pill-label">All</span>
          <span class="pill-count">({jobs.length})</span>
        </button>

        {jobCategories.map((c) => {
          const count = jobs.filter(j => j.category === c.key).length;
          return (
            <button
              type="button"
              class="cat-pill"
              data-cat={c.key}
              style={`--pill-accent:${c.accentVar}`}
            >
              <span class="pill-label">{c.label}</span>
              <span class="pill-count">({count})</span>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Google Careers Style Filter & Search Workspace -->
  <section id="filter-section" class="careers-section">
    <div class="careers-container">
      
      <!-- Left Filter Sidebar -->
      <aside class="careers-sidebar" aria-label="Job Search and Filters">
        <div class="sidebar-sticky-panel">
          
          <!-- Matched Count Header -->
          <div class="match-summary-header">
            <div class="match-text">
              <span id="matched-count" class="match-number">{jobs.length}</span>
              <span class="match-label">jobs matched</span>
            </div>
            <button type="button" id="clear-all-filters-btn" class="btn-clear-action mono" title="Reset all filters">
              Clear filters
            </button>
          </div>

          <!-- Main Search Box (Google Careers Style) -->
          <div class="search-input-group">
            <div class="search-box">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="job-search-input"
                class="search-field"
                placeholder="What do you want to do?"
                autocomplete="off"
                spellcheck="false"
              />
              <button type="button" id="clear-search-btn" class="clear-search-x" aria-label="Clear search" hidden>×</button>
            </div>
          </div>

          <!-- Filter Accordions -->
          <div class="accordion-groups">
            
            <!-- 1. Locations -->
            <div class="filter-accordion" data-group="locations">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Locations</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list">
                  {allLocations.map(loc => {
                    const count = jobs.filter(j => {
                      if (loc === 'Bangalore · Work From Office') return j.location.includes('Work From Office');
                      if (loc === 'Work from home · India') return j.location.includes('Work from home');
                      return !j.location.includes('Work From Office') && !j.location.includes('Work from home');
                    }).length;
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-location" value={loc} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{loc}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 2. Experience -->
            <div class="filter-accordion" data-group="experience">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Experience</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list">
                  {experienceLevels.map(exp => {
                    const count = jobs.filter(j => {
                      if (exp.id === 'fresher') return j.experience.toLowerCase().includes('fresh') || j.experience.toLowerCase().includes('graduating');
                      if (exp.id === 'mid-2-5') return j.experience.includes('2–') || j.experience.includes('2-');
                      if (exp.id === 'senior-3-8') return j.experience.includes('3–') || j.experience.includes('3-');
                      if (exp.id === 'lead-4-8') return j.experience.includes('4–') || j.experience.includes('4-');
                      return false;
                    }).length;
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-experience" value={exp.id} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{exp.label}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 3. Skills & qualifications -->
            <div class="filter-accordion" data-group="skills">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Skills & qualifications</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list scrollable-list">
                  {allSkills.map(skill => {
                    const count = jobs.filter(j => 
                      j.skills.some(s => s.toLowerCase().includes(skill.toLowerCase())) ||
                      j.summary.toLowerCase().includes(skill.toLowerCase())
                    ).length;
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-skill" value={skill.toLowerCase()} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{skill}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 4. Degree -->
            <div class="filter-accordion" data-group="degree">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Degree</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list">
                  {degrees.map(deg => {
                    const count = deg.id === 'mba' ? 1 : deg.id === 'premier' ? 2 : 16;
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-degree" value={deg.id} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{deg.label}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 5. Job types -->
            <div class="filter-accordion" data-group="jobtypes">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Job types</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list">
                  {allJobTypes.map(jt => {
                    const count = jobs.filter(j => j.employmentType === jt).length;
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-jobtype" value={jt} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{jt}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 6. Organizations -->
            <div class="filter-accordion" data-group="organizations">
              <button type="button" class="accordion-trigger" aria-expanded="false">
                <span class="accordion-title">Organizations</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="filter-options-list scrollable-list">
                  {organizations.map(org => {
                    const count = org === 'Ollasoftware Ecosystem' ? jobs.length : Math.max(2, Math.floor(jobs.length / 3));
                    return (
                      <label class="filter-checkbox-item">
                        <input type="checkbox" name="filter-org" value={org.toLowerCase()} class="facet-checkbox" />
                        <span class="custom-check"></span>
                        <span class="facet-label">{org}</span>
                        <span class="facet-count mono">({count})</span>
                      </label>
                    );
                  })}
                </div>
              </div>
            </div>

            <!-- 7. Sort by -->
            <div class="filter-accordion open" data-group="sort">
              <button type="button" class="accordion-trigger" aria-expanded="true">
                <span class="accordion-title">Sort by</span>
                <span class="accordion-arrow">▾</span>
              </button>
              <div class="accordion-content">
                <div class="sort-select-wrapper">
                  <select id="sort-jobs-select" class="sort-select mono">
                    <option value="relevance">Relevance & Match</option>
                    <option value="openings">Most Openings (High to Low)</option>
                    <option value="salary">Salary: High to Low</option>
                    <option value="title">Role Title (A → Z)</option>
                  </select>
                </div>
              </div>
            </div>

          </div>
        </div>
      </aside>

      <!-- Right Job Results Column -->
      <main class="careers-results" id="job-results-container">
        
        <!-- Active Filter Tags Bar with Button Clear All -->
        <div id="active-filter-chips" class="active-chips-bar" hidden>
          <span class="chips-title mono">Active:</span>
          <div id="chips-container" class="chips-list"></div>
          <button type="button" id="clear-chips-btn" class="btn-clear-action mono">Clear all</button>
        </div>

        <!-- Job Cards List (Compact Sizing & Clean Text Without Emojis) -->
        <div class="jobs-cards-stack" id="jobs-list">
          {jobs.map(j => {
            const cat = jobCategories.find(c => c.key === j.category);
            const accentVar = cat?.accentVar ?? 'var(--o-accent)';
            const openingsNum = parseInt(j.openings.replace(/[^0-9]/g, '')) || 10;
            const salaryNum = j.compensation.includes('15') ? 15 : j.compensation.includes('14') ? 14 : j.compensation.includes('13') ? 13 : 8;
            
            // Normalized attributes for fast JS filtering
            const locationType = j.location.includes('Work From Office') 
              ? 'Bangalore · Work From Office' 
              : j.location.includes('Work from home') 
                ? 'Work from home · India' 
                : 'Bangalore · Hybrid';
            
            const expLevel = (j.experience.toLowerCase().includes('fresh') || j.experience.toLowerCase().includes('graduating'))
              ? 'fresher'
              : j.experience.includes('4–') || j.experience.includes('4-')
                ? 'lead-4-8'
                : j.experience.includes('3–') || j.experience.includes('3-')
                  ? 'senior-3-8'
                  : 'mid-2-5';

            const degreeType = j.category === 'mba-fresher' ? 'mba' : j.slug === 'premier-institute-intern' ? 'premier' : 'any';

            // Aliases for anchoring (e.g. #mba-fresher also points to mba-fresher card)
            const isMbaFresher = j.category === 'mba-fresher';
            const isAiMarketingIntern = j.slug === 'ai-marketing-intern';
            const applyUrl = isAiMarketingIntern ? `/jobs/${j.slug}/` : `/apply/?role=${j.slug}`;

            return (
              <article
                id={j.slug}
                class:list={['career-card', { 'featured-card': j.featured }]}
                style={`--card-accent:${accentVar};`}
                data-slug={j.slug}
                data-title={j.title.toLowerCase()}
                data-category={j.category}
                data-location={locationType}
                data-experience={expLevel}
                data-experience-text={j.experience.toLowerCase()}
                data-jobtype={j.employmentType}
                data-degree={degreeType}
                data-skills={j.skills.join(',').toLowerCase()}
                data-summary={j.summary.toLowerCase()}
                data-openings={openingsNum}
                data-salary-num={salaryNum}
              >
                {/* Secondary anchor for backwards-compatible link #mba-fresher */}
                {isMbaFresher && <a id="mba-fresher" class="anchor-target" aria-hidden="true"></a>}
                
                <!-- Top Row: Category badge, Featured badge, Openings count, Bookmark & Share -->
                <div class="card-top-bar">
                  <div class="card-badge-row">
                    <span class="cat-badge mono">
                      {cat?.label}
                    </span>
                    {j.featured && (
                      <span class="star-badge mono">
                        ★ FEATURED · {isMbaFresher ? 'CLASS OF 2026' : 'PRIORITY HIRING'}
                      </span>
                    )}
                    <span class="openings-pill mono">
                      {isMbaFresher ? '8–12 (Class of 2026) OPENINGS' : `${j.openings} OPENINGS`}
                    </span>
                  </div>

                  <div class="card-quick-actions">
                    <button type="button" class="action-icon-btn copy-job-link" data-slug={j.slug} title="Copy role link" aria-label="Copy job link">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="18" cy="5" r="3"></circle>
                        <circle cx="6" cy="12" r="3"></circle>
                        <circle cx="18" cy="19" r="3"></circle>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                      </svg>
                    </button>
                    <button type="button" class="action-icon-btn bookmark-btn" data-slug={j.slug} title="Save role" aria-label="Bookmark job">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                      </svg>
                    </button>
                  </div>
                </div>

                <!-- Main Role Heading -->
                <h2 class="role-heading">
                  <a href={applyUrl} class="role-title-link">
                    {j.title}
                  </a>
                </h2>

                <!-- Key Meta Details (Blue for Location & Type, Orange for Compensation) -->
                <div class="meta-row mono">
                  <span class="meta-val meta-blue">{j.location}</span>
                  <span class="meta-sep">·</span>
                  <span class="meta-val meta-blue">{j.employmentType}</span>
                  <span class="meta-sep">·</span>
                  <span class="meta-val meta-orange">{j.compensation}</span>
                </div>

                <!-- Summary Description -->
                <p class="role-summary">{j.summary}</p>

                <!-- Experience & Toolkit Fluency Section -->
                <div class="specs-grid">
                  <div class="spec-col">
                    <span class="spec-label mono">EXPERIENCE REQUIREMENTS</span>
                    <span class="spec-text">{j.experience}</span>
                  </div>
                  
                  <div class="spec-col">
                    <span class="spec-label mono">{j.featured ? 'TOOLKIT FLUENCY & SKILLS' : 'KEY SKILLS & STACK'}</span>
                    <div class="skill-chips-wrap">
                      {j.skills.map(s => (
                        <span class="skill-chip mono">{s}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <!-- Action Footer -->
                <div class="card-footer">
                  <div class="apply-actions">
                    <a
                      href={applyUrl}
                      class="btn-apply-primary mono"
                    >
                      Apply →
                    </a>
                  </div>

                  <span class="org-note mono">
                    Ollasoftware · Bangalore HQ
                  </span>
                </div>
              </article>
            );
          })}
        </div>

        <!-- Empty State (Zero Results) -->
        <div id="no-jobs-matched" class="empty-state-box" hidden>
          <div class="empty-icon">🔍</div>
          <h3>No matching jobs found</h3>
          <p>We couldn't find any roles matching your current combination of search terms and filters.</p>
          <button type="button" id="reset-all-filters-btn" class="btn-reset-filters mono">
            Reset all filters
          </button>
        </div>

      </main>
    </div>
  </section>

  <!-- Application Loop Section (Centered Layout per User Request) -->
  <section id="apply" class="how-to-apply">
    <div class="centered-apply-head">
      <Tag color="var(--o-accent)">HOW TO APPLY</Tag>
      <h2 class="apply-main-heading">The application loop.</h2>
      <p class="apply-sub-heading">
        We hire fast. We move slowly on the wrong fits. The faster you give us a real signal, the faster we say yes or no.
      </p>
    </div>

    <ol class="loop">
      <li>
        <span class="loop-num mono">01</span>
        <h3>Submit via the form</h3>
        <p>
          Include role title, your top 3 AI tools, and one production link
          — a GitHub PR, a deployed app, an MCP repo. Generic CVs get
          auto-filtered. Less is more if the production link is strong.
        </p>
      </li>
      <li>
        <span class="loop-num mono">02</span>
        <h3>{hiringOverview.interviewRounds} interview rounds</h3>
        <p>
          Round 1: 30-min screen with hiring manager. Round 2: paired
          work with a senior engineer on a real ticket. Round 3:
          system / architecture discussion. Round 4: founder fit.
        </p>
      </li>
      <li>
        <span class="loop-num mono">03</span>
        <h3>{hiringOverview.typicalTimeline}</h3>
        <p>
          From submission to offer in 7–14 days. We tell you yes or no
          fast. We do not ghost. We give written feedback either way,
          because we owe it to you.
        </p>
      </li>
    </ol>

    <div class="cta-row">
      <Btn primary href="/apply/">Start your application →</Btn>
      <Btn href="/about/">Learn about the company</Btn>
    </div>
  </section>

  <!-- Fine Print Section -->
  <section class="fine-print">
    <div class="fp-block">
      <span class="fp-label mono">Remote policy</span>
      <p>Default hybrid (3 office, 2 remote). Fully remote available for engineers with 5+ years of proven async track record on production teams.</p>
    </div>
    <div class="fp-block">
      <span class="fp-label mono">Freshers</span>
      <p>Premier-institute graduates (IIT / IIM / NIT / IIIT) can apply to the internship tracks. Other graduates are evaluated directly on production links and code evidence.</p>
    </div>
    <div class="fp-block">
      <span class="fp-label mono">Generic CVs</span>
      <p>We auto-filter applications without a production link. This is not a hard gate against career-changers — a working side project counts. It is a hard gate against unread CVs.</p>
    </div>
    <div class="fp-block">
      <span class="fp-label mono">Equal opportunity</span>
      <p>Ollasoftware hires on evidence of work, not pedigree of where it came from. We have no degree filter for roles outside the premier-institute intern track. If you can do the work, we want to talk.</p>
    </div>
  </section>

  <!-- Toast Notification element for Copy / Bookmark -->
  <div id="job-toast" class="job-toast mono" role="status" aria-live="polite" hidden></div>
</Layout>

<script>
  // High performance client-side Google Careers-style live filtering
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('job-search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
    const clearAllBtn = document.getElementById('clear-all-filters-btn') as HTMLButtonElement | null;
    const resetFiltersBtn = document.getElementById('reset-all-filters-btn') as HTMLButtonElement | null;
    const matchedCountEl = document.getElementById('matched-count');
    const cardsStack = document.getElementById('jobs-list');
    const emptyState = document.getElementById('no-jobs-matched');
    const sortSelect = document.getElementById('sort-jobs-select') as HTMLSelectElement | null;
    const toast = document.getElementById('job-toast');
    const categoryPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
    const activeChipsBar = document.getElementById('active-filter-chips');
    const chipsContainer = document.getElementById('chips-container');
    const clearChipsBtn = document.getElementById('clear-chips-btn');

    if (!cardsStack) return;

    const cards = Array.from(cardsStack.querySelectorAll<HTMLElement>('.career-card'));
    let activeCategory = 'all';

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.hidden = false;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
        setTimeout(() => { toast.hidden = true; }, 200);
      }, 2500);
    }

    // Accordion Toggle Handlers
    document.querySelectorAll('.accordion-trigger').forEach(trigger => {
      trigger.addEventListener('click', () => {
        const accordion = trigger.closest('.filter-accordion');
        if (!accordion) return;
        const isOpen = accordion.classList.contains('open');
        accordion.classList.toggle('open', !isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    // Share & Bookmark buttons
    cardsStack.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const copyBtn = target.closest('.copy-job-link') as HTMLElement | null;
      const bookmarkBtn = target.closest('.bookmark-btn') as HTMLElement | null;

      if (copyBtn) {
        const slug = copyBtn.dataset.slug;
        const url = `${window.location.origin}/jobs/#${slug}`;
        navigator.clipboard.writeText(url).then(() => {
          showToast(`Link copied: #${slug}`);
        }).catch(() => {
          showToast(`Copied role link`);
        });
      } else if (bookmarkBtn) {
        const slug = bookmarkBtn.dataset.slug;
        bookmarkBtn.classList.toggle('bookmarked');
        const isBookmarked = bookmarkBtn.classList.contains('bookmarked');
        showToast(isBookmarked ? `Saved ${slug} to bookmarks` : `Removed ${slug}`);
      }
    });

    // Category Pill Click
    categoryPills.forEach(pill => {
      pill.addEventListener('click', () => {
        categoryPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeCategory = pill.dataset.cat || 'all';
        applyFilters();
      });
    });

    // Checkbox and Search input listeners
    document.querySelectorAll<HTMLInputElement>('.facet-checkbox').forEach(cb => {
      cb.addEventListener('change', applyFilters);
    });

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        if (clearSearchBtn) {
          clearSearchBtn.hidden = searchInput.value.trim().length === 0;
        }
        applyFilters();
      });
    }

    if (clearSearchBtn && searchInput) {
      clearSearchBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearSearchBtn.hidden = true;
        searchInput.focus();
        applyFilters();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', applyFilters);
    }

    function clearAllFilters() {
      if (searchInput) {
        searchInput.value = '';
        if (clearSearchBtn) clearSearchBtn.hidden = true;
      }
      document.querySelectorAll<HTMLInputElement>('.facet-checkbox').forEach(cb => {
        cb.checked = false;
      });
      categoryPills.forEach(p => p.classList.remove('active'));
      const allPill = document.querySelector<HTMLButtonElement>('.cat-pill[data-cat="all"]');
      if (allPill) allPill.classList.add('active');
      activeCategory = 'all';
      if (sortSelect) sortSelect.value = 'relevance';
      applyFilters();
      showToast('Filters cleared');
    }

    if (clearAllBtn) clearAllBtn.addEventListener('click', clearAllFilters);
    if (resetFiltersBtn) resetFiltersBtn.addEventListener('click', clearAllFilters);
    if (clearChipsBtn) clearChipsBtn.addEventListener('click', clearAllFilters);

    function applyFilters() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      
      const selectedLocations = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-location"]:checked')).map(cb => cb.value);
      const selectedExperience = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-experience"]:checked')).map(cb => cb.value);
      const selectedSkills = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-skill"]:checked')).map(cb => cb.value);
      const selectedDegrees = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-degree"]:checked')).map(cb => cb.value);
      const selectedJobTypes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-jobtype"]:checked')).map(cb => cb.value);
      const selectedOrgs = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="filter-org"]:checked')).map(cb => cb.value);

      // Render Active Chips
      renderActiveChips(query, selectedLocations, selectedExperience, selectedSkills, selectedDegrees, selectedJobTypes, selectedOrgs);

      let visibleCards: HTMLElement[] = [];

      cards.forEach(card => {
        const title = card.dataset.title || '';
        const summary = card.dataset.summary || '';
        const skills = card.dataset.skills || '';
        const category = card.dataset.category || '';
        const location = card.dataset.location || '';
        const experience = card.dataset.experience || '';
        const experienceText = card.dataset.experienceText || '';
        const jobtype = card.dataset.jobtype || '';
        const degree = card.dataset.degree || '';

        // Category check
        const matchCategory = activeCategory === 'all' || category === activeCategory;

        // Search query check
        const matchQuery = !query || 
          title.includes(query) || 
          summary.includes(query) || 
          skills.includes(query) || 
          experienceText.includes(query) ||
          category.includes(query);

        // Location check
        const matchLocation = selectedLocations.length === 0 || selectedLocations.includes(location);

        // Experience check
        const matchExperience = selectedExperience.length === 0 || selectedExperience.includes(experience);

        // Skills check
        const matchSkills = selectedSkills.length === 0 || selectedSkills.some(s => skills.includes(s) || summary.includes(s));

        // Degree check
        const matchDegree = selectedDegrees.length === 0 || selectedDegrees.includes(degree) || (selectedDegrees.includes('any') && degree === 'any');

        // Job type check
        const matchJobType = selectedJobTypes.length === 0 || selectedJobTypes.includes(jobtype);

        // Organizations check
        const matchOrg = selectedOrgs.length === 0 || selectedOrgs.some(org => 
          org.includes('ollasoftware') || summary.includes(org) || title.includes(org)
        );

        const isMatch = matchCategory && matchQuery && matchLocation && matchExperience && matchSkills && matchDegree && matchJobType && matchOrg;

        if (isMatch) {
          card.style.display = '';
          visibleCards.push(card);
        } else {
          card.style.display = 'none';
        }
      });

      // Sorting
      const sortMode = sortSelect?.value || 'relevance';
      if (sortMode === 'openings') {
        visibleCards.sort((a, b) => (parseInt(b.dataset.openings || '0') - parseInt(a.dataset.openings || '0')));
      } else if (sortMode === 'salary') {
        visibleCards.sort((a, b) => (parseInt(b.dataset.salaryNum || '0') - parseInt(a.dataset.salaryNum || '0')));
      } else if (sortMode === 'title') {
        visibleCards.sort((a, b) => (a.dataset.title || '').localeCompare(b.dataset.title || ''));
      }

      // Re-append sorted visible cards
      visibleCards.forEach(c => cardsStack?.appendChild(c));

      // Update counters & empty state
      if (matchedCountEl) {
        matchedCountEl.textContent = String(visibleCards.length);
      }

      if (emptyState) {
        emptyState.hidden = visibleCards.length > 0;
      }
    }

    function renderActiveChips(
      query: string, 
      locs: string[], 
      exps: string[], 
      skills: string[], 
      degs: string[], 
      types: string[], 
      orgs: string[]
    ) {
      if (!chipsContainer || !activeChipsBar) return;
      chipsContainer.innerHTML = '';

      const chips: { label: string; onRemove: () => void }[] = [];

      if (activeCategory !== 'all') {
        chips.push({
          label: `Category: ${activeCategory}`,
          onRemove: () => {
            const allPill = document.querySelector<HTMLButtonElement>('.cat-pill[data-cat="all"]');
            allPill?.click();
          }
        });
      }

      if (query) {
        chips.push({
          label: `Search: "${query}"`,
          onRemove: () => {
            if (searchInput) searchInput.value = '';
            if (clearSearchBtn) clearSearchBtn.hidden = true;
            applyFilters();
          }
        });
      }

      locs.forEach(loc => {
        chips.push({
          label: loc,
          onRemove: () => {
            const cb = document.querySelector<HTMLInputElement>(`input[name="filter-location"][value="${loc}"]`);
            if (cb) { cb.checked = false; applyFilters(); }
          }
        });
      });

      exps.forEach(exp => {
        chips.push({
          label: `Exp: ${exp}`,
          onRemove: () => {
            const cb = document.querySelector<HTMLInputElement>(`input[name="filter-experience"][value="${exp}"]`);
            if (cb) { cb.checked = false; applyFilters(); }
          }
        });
      });

      skills.forEach(skill => {
        chips.push({
          label: `Skill: ${skill}`,
          onRemove: () => {
            const cb = document.querySelector<HTMLInputElement>(`input[name="filter-skill"][value="${skill}"]`);
            if (cb) { cb.checked = false; applyFilters(); }
          }
        });
      });

      types.forEach(jt => {
        chips.push({
          label: jt,
          onRemove: () => {
            const cb = document.querySelector<HTMLInputElement>(`input[name="filter-jobtype"][value="${jt}"]`);
            if (cb) { cb.checked = false; applyFilters(); }
          }
        });
      });

      if (chips.length > 0) {
        activeChipsBar.hidden = false;
        chips.forEach(chip => {
          const chipEl = document.createElement('span');
          chipEl.className = 'chip-pill mono';
          chipEl.innerHTML = `${chip.label} <button type="button" class="chip-x" aria-label="Remove filter">×</button>`;
          chipEl.querySelector('button')?.addEventListener('click', chip.onRemove);
          chipsContainer.appendChild(chipEl);
        });
      } else {
        activeChipsBar.hidden = true;
      }
    }

    // Handle incoming URL hash (e.g. #mba-fresher, #mba-fresher-ai-strategy-sales-distribution-class-of-2026, #ai-marketing-intern)
    function scrollToHash() {
      if (window.location.hash) {
        const targetSlug = window.location.hash.replace('#', '');
        let targetCard = document.getElementById(targetSlug);
        if (!targetCard && targetSlug === 'mba-fresher') {
          targetCard = document.querySelector('[data-category="mba-fresher"]');
        }
        if (targetCard) {
          setTimeout(() => {
            targetCard?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard?.classList.add('highlight-flash');
            setTimeout(() => targetCard?.classList.remove('highlight-flash'), 2000);
          }, 150);
        }
      }
    }

    scrollToHash();
    window.addEventListener('hashchange', scrollToHash);
  });
</script>

