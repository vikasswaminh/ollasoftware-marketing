---
// Hybrid mode: prerender to static HTML (default for current pages).
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/primitives/PageHero.astro';
import SectionHead from '../components/primitives/SectionHead.astro';
import Btn from '../components/primitives/Btn.astro';
import Tag from '../components/primitives/Tag.astro';
import FounderBlock from '../components/founder/FounderBlock.astro';

const team = [
  { name: 'Rin Saito',           role: 'Lead, AI software',        focus: 'AI software',           place: 'Brooklyn',  hue: 'var(--o-accent)' },
  { name: 'Theo Karras',         role: 'Principal engineer',       focus: 'Software dev',          place: 'Lisboa',    hue: 'var(--o-blue)' },
  { name: 'Maya Iyer',           role: 'Head of AEO',              focus: 'AEO',                   place: 'Brooklyn',  hue: 'var(--o-purple)' },
  { name: 'Dev Sharma',          role: 'Head of SEO',              focus: 'SEO',                   place: 'Bangalore', hue: 'var(--o-warn)' },
  { name: 'Noor Hassan',         role: 'Head of Social',           focus: 'Social media',          place: 'Brooklyn',  hue: 'var(--o-red)' },
  { name: 'Kiran Patel',         role: 'Head of Performance',      focus: 'Paid media',            place: 'Lisboa',    hue: 'var(--o-teal)' },
  { name: 'Marco Pellegrini',    role: 'Principal engineer',       focus: 'AI software',           place: 'Lisboa',    hue: 'var(--o-accent)' },
  { name: 'Asha Devarajan',      role: 'Senior engineer',          focus: 'Software dev',          place: 'Bangalore', hue: 'var(--o-blue)' },
  { name: 'Oksana Hrytsenko',    role: 'Senior engineer',          focus: 'Software dev',          place: 'Brooklyn',  hue: 'var(--o-blue)' },
  { name: 'Arjun Menon',         role: 'Lead editor',              focus: 'SEO / AEO',             place: 'Bangalore', hue: 'var(--o-warn)' },
  { name: 'Ian Brewster',        role: 'Senior writer',            focus: 'Social',                place: 'Brooklyn',  hue: 'var(--o-red)' },
  { name: 'Yuna Park',           role: 'Senior video editor',      focus: 'Social / perf',         place: 'Lisboa',    hue: 'var(--o-red)' },
  { name: 'Priya Iyer',          role: 'Senior strategist',        focus: 'Pricing & ops',         place: 'Brooklyn',  hue: 'var(--o-mute)' },
  { name: 'Anika Devarajan',     role: 'Senior strategist',        focus: 'Discovery',             place: 'Lisboa',    hue: 'var(--o-mute)' },
  { name: 'Eli Tanaka',          role: 'Design lead',              focus: 'All of it',             place: 'Lisboa',    hue: 'var(--o-purple)' },
  { name: 'Sam Wynter',          role: 'Operations',               focus: 'Procurement & ops',     place: 'Brooklyn',  hue: 'var(--o-mute)' },
  { name: 'Rae Okafor',          role: 'Finance & people',         focus: 'Hiring & payroll',      place: 'Lisboa',    hue: 'var(--o-mute)' },
  { name: 'Felix Otieno',        role: 'Senior engineer',          focus: 'AI software',           place: 'Nairobi',   hue: 'var(--o-accent)' },
];
---
<Layout
  title="About — Ollasoftware"
  description="About Ollasoftware — pioneer AI software development company in India, headquartered in Bangalore. Owners of 40+ AI brands in production. Founded 2021. Offices in Bangalore, Brooklyn, Lisboa, Nairobi."
>
  <!-- About Hero Section with Left Content & Right Bangalore Globe Illustration -->
  <section class="about-hero">
    <div class="hero-inner">
      <div class="hero-left">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href="/">home</a>
          <span class="sep">/</span>
          <span class="current">about</span>
        </nav>
        
        <div class="eyebrow-wrap">
          <Tag color="var(--o-accent)">THE COMPANY · BANGALORE HQ</Tag>
        </div>

        <h1>Pioneer AI software development company in India.</h1>
        
        <p class="hero-sub mono">
          Headquartered in Bangalore. Started in 2021 by engineers who were tired of agency PowerPoint and tired of in-house politics. Today we own and operate 40+ AI brands in production — and we build the same caliber of product for clients worldwide, who want what we ship for ourselves.
        </p>

        <div class="hero-actions">
          <Btn primary href="/contact/">Talk to us →</Btn>
          <Btn href="/work/">See our work</Btn>
        </div>
      </div>

      <div class="hero-right">
        <div class="hero-image-container">
          <img 
            src="/loki.png" 
            alt="Ollasoftware Bangalore Headquarters Globe" 
            class="hero-globe-img"
            width="460"
            height="425"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="founder-section" id="founder">
    <FounderBlock variant="full" />
  </section>

  <section class="story" id="the-why">
    <div class="story-container">
      <div class="story-grid">
        <div class="story-text">
          <span class="why-tag mono">THE WHY.</span>
          <p>
            We started Ollasoftware in 2021 because we wanted to build AI software
            — at production scale, with our own money, on our own roadmap. No
            investors. No quarterly slide reviews. No "please clarify the brief."
            Just ship.
          </p>
          <p>
            Five years later we own 40+ AI brands across infra, security, dev
            tools, search, education, and consumer. Every one of them — Aeoniti,
            Crawlcrawl, Switchllm, Ollima, Super25.ai, 24observe and the rest —
            is in production, paying its own bills, run by the same senior team
            we'd put on your engagement.
          </p>
          <p>
            That's the pioneer thesis: we don't pitch slides about AI software,
            we ship it. When clients hire us, they get the engineers who built
            Crawlcrawl, the strategists who launched Aeoniti, the designers who
            shaped Ollima — not juniors learning on someone else's dollar.
          </p>
        </div>

        <aside class="story-stats-grid">
          <!-- Stat 1: 2021 FOUNDED -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">2021</span>
              <span class="why-stat-lbl mono">FOUNDED</span>
            </div>
          </div>

          <!-- Stat 2: 18 PEOPLE -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">18</span>
              <span class="why-stat-lbl mono">PEOPLE</span>
            </div>
          </div>

          <!-- Stat 3: 42 / 44 SPRINTS -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <circle cx="12" cy="12" r="6"/>
                <circle cx="12" cy="12" r="2"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">42 / 44</span>
              <span class="why-stat-lbl mono">SPRINTS ON TIME + PRICE</span>
            </div>
          </div>

          <!-- Stat 4: $0 SPENT ON SALES STAFF -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v12M15 9.5a2.5 2.5 0 0 0-5 0c0 3 5 2 5 5a2.5 2.5 0 0 1-5 0"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">$0</span>
              <span class="why-stat-lbl mono">SPENT ON SALES STAFF</span>
            </div>
          </div>

          <!-- Stat 5: 4 CITIES -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
                <line x1="9" y1="22" x2="9" y2="22.01"/>
                <line x1="15" y1="22" x2="15" y2="22.01"/>
                <line x1="9" y1="6" x2="9" y2="6.01"/>
                <line x1="15" y1="6" x2="15" y2="6.01"/>
                <line x1="9" y1="10" x2="9" y2="10.01"/>
                <line x1="15" y1="10" x2="15" y2="10.01"/>
                <line x1="9" y1="14" x2="9" y2="14.01"/>
                <line x1="15" y1="14" x2="15" y2="14.01"/>
                <line x1="9" y1="18" x2="9" y2="18.01"/>
                <line x1="15" y1="18" x2="15" y2="18.01"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">4</span>
              <span class="why-stat-lbl mono">CITIES</span>
            </div>
          </div>

          <!-- Stat 6: 0 INVESTORS, EVER -->
          <div class="why-stat-card">
            <div class="why-stat-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </div>
            <div class="why-stat-info">
              <span class="why-stat-num mono">0</span>
              <span class="why-stat-lbl mono">INVESTORS, EVER</span>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="team" id="team">
    <div class="team-container">
      <div class="team-header-row">
        <div class="team-header-left">
          <span class="team-tag mono">THE TEAM</span>
          <h2 class="team-main-h2">Eighteen names. No avatars, on purpose.</h2>
        </div>
        <div class="team-header-right">
          <p class="team-sub">
            We don't use stock photos. We don't use AI-generated portraits. If you want to know what we look like, ask us on the call.
          </p>
        </div>
      </div>

      <div class="team-grid">
        {team.map(p => (
          <div class="team-member-item">
            <div class="team-initial-circle" aria-hidden="true">{p.name[0]}</div>
            <div class="team-member-info">
              <div class="team-member-name">{p.name}</div>
              <div class="team-member-role mono">{p.role}</div>
              <div class="team-member-meta">
                <span class="team-focus" set:html={p.focus} />
                <span class="team-dot">·</span>
                <span class="team-place">{p.place}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="offices" id="where-we-work">
    <div class="offices-container">
      <div class="offices-header">
        <span class="offices-tag mono">WHERE WE WORK</span>
        <h2 class="offices-main-h2">Headquartered in Bangalore. Four cities. Three time zones.</h2>
      </div>
      <div class="o-grid">
        <!-- Bangalore -->
        <div class="office-card">
          <h4 class="office-title mono">BENGALURU, IN · HQ</h4>
          <div class="office-ill-wrap">
            <img src="/city-bengaluru.png" alt="Bengaluru Vidhana Soudha Landmark" class="office-img" width="180" height="76" loading="lazy" decoding="async" />
          </div>
          <div class="office-info">
            <p class="addr">L-149, Sector 6 · HSR Layout · Bengaluru 560102 · Karnataka, India</p>
            <p class="hrs mono">Mon–Sat · 10:00–18:00 IST · +91-9611027980</p>
            <p class="note">Global HQ. Most of eng, AI software, SEO, AEO, editorial.</p>
          </div>
        </div>

        <!-- Brooklyn -->
        <div class="office-card">
          <h4 class="office-title mono">BROOKLYN, NY</h4>
          <div class="office-ill-wrap">
            <img src="/city-brooklyn.png" alt="Brooklyn Bridge" class="office-img" width="180" height="76" loading="lazy" decoding="async" />
          </div>
          <div class="office-info">
            <p class="addr">68 Jay St · Suite 414 · Brooklyn, NY 11201, USA</p>
            <p class="hrs mono">M–F · 09:00–18:00 ET</p>
            <p class="note">North America hub. Eng, social, ops.</p>
          </div>
        </div>

        <!-- Lisboa -->
        <div class="office-card">
          <h4 class="office-title mono">LISBOA, PT</h4>
          <div class="office-ill-wrap">
            <img src="/city-lisboa.png" alt="Lisboa Tram" class="office-img office-img-tall" width="76" height="76" loading="lazy" decoding="async" />
          </div>
          <div class="office-info">
            <p class="addr">R. da Bica de Duarte Belo 42 · 1200-053 Lisboa, Portugal</p>
            <p class="hrs mono">M–F · 09:00–18:00 WET</p>
            <p class="note">EU hub. Eng, perf marketing, design, finance.</p>
          </div>
        </div>

        <!-- Nairobi -->
        <div class="office-card">
          <h4 class="office-title mono">NAIROBI, KE</h4>
          <div class="office-ill-wrap">
            <img src="/city-nairobi.png" alt="Nairobi Skyline" class="office-img" width="180" height="76" loading="lazy" decoding="async" />
          </div>
          <div class="office-info">
            <p class="addr">Riverside Square · Riverside Dr · Nairobi, Kenya</p>
            <p class="hrs mono">M–F · 09:00–18:00 EAT</p>
            <p class="note">Newest. Eng.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="careers" id="careers">
    <div class="careers-container">
      <div class="careers-layout">
        <!-- Left Column: Title, Copy & CTA -->
        <div class="careers-left-col">
          <span class="careers-tag mono">CAREERS · 19 OPEN ROLES</span>
          <h2 class="careers-main-h2">We hire at scale across 16 founder companies.</h2>
          <p class="careers-main-sub">
            From frontend engineers to MCP server engineers to SOC analysts to AI product managers — we always have senior roles open in Bangalore. Three teaser roles below; the full list of categories lives on the jobs page.
          </p>
          <a href="/jobs/" class="careers-cta-btn">
            See all 19 roles →
          </a>
        </div>

        <!-- Right Side: 3 Teaser Job Cards -->
        <div class="careers-cards-grid">
          <!-- Card 1: Senior Engineer -->
          <div class="career-card">
            <div class="career-card-top">
              <div class="career-icon-wrap" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              </div>
              <span class="career-tag-pill mono">ENG</span>
              <h3 class="career-job-title">Senior engineer — AI software</h3>
              <div class="career-job-meta">
                <p>Brooklyn or Lisboa · full-time</p>
                <p>$260–320k OTE · 8+ yr senior xp</p>
              </div>
            </div>
            <a href="/jobs/" class="career-apply-link">Apply →</a>
          </div>

          <!-- Card 2: Senior Editor -->
          <div class="career-card">
            <div class="career-card-top">
              <div class="career-icon-wrap" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"/>
                </svg>
              </div>
              <span class="career-tag-pill mono">EDITOR</span>
              <h3 class="career-job-title">Senior editor — SEO/AEO</h3>
              <div class="career-job-meta">
                <p>Bangalore · full-time</p>
                <p>$90–110k · 6+ yr editorial xp</p>
              </div>
            </div>
            <a href="/contact/?role=seo-ed" class="career-apply-link">Apply →</a>
          </div>

          <!-- Card 3: Senior Media Buyer -->
          <div class="career-card">
            <div class="career-card-top">
              <div class="career-icon-wrap" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"/>
                  <line x1="12" y1="20" x2="12" y2="4"/>
                  <line x1="6" y1="20" x2="6" y2="14"/>
                  <path d="M4 10l8-6 8 6"/>
                </svg>
              </div>
              <span class="career-tag-pill mono">PERF</span>
              <h3 class="career-job-title">Senior media buyer — Performance</h3>
              <div class="career-job-meta">
                <p>Lisboa · full-time</p>
                <p>$130–170k · 6+ yr B2B paid xp</p>
              </div>
            </div>
            <a href="/contact/?role=perf-buyer" class="career-apply-link">Apply →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="press-cta-section" id="press">
    <div class="press-cta-container">
      <div class="press-cta-grid">
        
        <!-- Left Side: Press list -->
        <div class="press-col">
          <span class="press-tag mono">PRESS</span>
          <h2 class="press-main-h2">Where we've been quoted.</h2>
          <ul class="press-list">
            <li class="press-item">
              <span class="press-date mono">2026.03</span>
              <strong class="press-pub">The Pragmatic Engineer</strong>
              <span class="press-dot">·</span>
              <span class="press-quote">"Why product companies beat consultancies for AI work"</span>
            </li>
            <li class="press-item">
              <span class="press-date mono">2025.11</span>
              <strong class="press-pub">a16z Future</strong>
              <span class="press-dot">·</span>
              <span class="press-quote">"The senior-bench-only thesis"</span>
            </li>
            <li class="press-item">
              <span class="press-date mono">2025.08</span>
              <strong class="press-pub">Sifted</strong>
              <span class="press-dot">·</span>
              <span class="press-quote">"Brooklyn × Lisboa: a cross-Atlantic AI portfolio"</span>
            </li>
            <li class="press-item">
              <span class="press-date mono">2025.04</span>
              <strong class="press-pub">Lenny's Newsletter</strong>
              <span class="press-dot">·</span>
              <span class="press-quote">"How Olla scopes a 4-week AI sprint"</span>
            </li>
          </ul>
        </div>

        <!-- Right Side: CTA Card -->
        <div class="cta-col">
          <div class="partner-cta-card">
            <h3 class="partner-cta-title">Want to talk to a partner?</h3>
            <p class="partner-cta-sub">
              No SDR. No qualification form. No procurement theatre. Just a 30-minute call with someone who'd actually be on your engagement.
            </p>
            <div class="partner-cta-actions">
              <a href="/contact/" class="partner-btn-primary">Talk to us →</a>
              <a href="/services/" class="partner-btn-secondary">See services</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     ABOUT HERO (2-Column Split with Right Bangalore Globe Illustration)
  ══════════════════════════════════════════════════════════════════════ */
  .about-hero {
    padding: 88px 56px 72px;
    border-bottom: 1px solid var(--o-line);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 390px;
    gap: 48px;
    align-items: center;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .crumbs {
    font-size: 10px;
    color: var(--o-mute);
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
  }
  .crumbs a { color: var(--o-mute); text-decoration: none; }
  .crumbs a:hover { color: var(--o-ink); }
  .crumbs .current { color: var(--o-ink); }
  .crumbs .sep { color: var(--o-faint); }

  .eyebrow-wrap {
    margin-bottom: 14px;
  }

  .about-hero h1 {
    margin: 0 0 18px;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.1;
    letter-spacing: clamp(-0.8px, -0.2vw, -1.8px);
    font-weight: 700;
    color: var(--o-ink);
    max-width: 680px;
    overflow-wrap: break-word;
  }

  .hero-sub {
    font-size: clamp(12px, 1.1vw, 13px);
    line-height: 1.65;
    color: var(--o-mute);
    max-width: 620px;
    margin: 0 0 24px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero-right {
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }

  .hero-image-container {
    width: 100%;
    max-width: 380px;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: globeFloat 6s ease-in-out infinite alternate;
  }

  .hero-globe-img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.09));
    transition: transform 0.3s ease;
  }

  :global(html[data-theme="dark"]) .hero-globe-img {
    filter: drop-shadow(0 15px 36px rgba(56, 189, 248, 0.3));
  }

  @keyframes globeFloat {
    0% { transform: translateY(0px); }
    100% { transform: translateY(-6px); }
  }

  @media (max-width: 1080px) {
    .hero-inner {
      grid-template-columns: 1fr 320px;
      gap: 36px;
    }
    .hero-image-container {
      max-width: 320px;
    }
    .hero-globe-img {
      max-height: 320px;
    }
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr 270px;
      gap: 28px;
    }
    .hero-image-container {
