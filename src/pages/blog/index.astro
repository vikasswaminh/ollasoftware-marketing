---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/primitives/Tag.astro';
import Btn from '../../components/primitives/Btn.astro';
import { allPosts } from '../../lib/blog';
import { SITE, breadcrumbLd } from '../../lib/seo';

const breadcrumb = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'Blog', url: `${SITE}/blog/` },
];

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/blog/#blog`,
  name: 'Ollasoftware Brand Deep-Dives',
  description: 'Long-form, 5,000-word pieces on every AI brand in the Ollasoftware portfolio. Honest, technical, no fluff.',
  url: `${SITE}/blog/`,
  publisher: { '@id': `${SITE}#organization` },
  blogPost: allPosts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: `${SITE}/blog/${p.slug}/`,
    description: p.metaDescription,
    datePublished: p.publishedOn,
    dateModified: p.lastUpdated,
  })),
};

// Curated filter tags mapping
const MUST_READ_SLUGS = new Set(['ollima', '24observe', 'ollagraph', 'quickztna', 'crawlcrawl', 'ollanode', '21tunnel']);
const EDITORS_PICK_SLUGS = new Set(['memfog', 'ollabear', 'meshwg', 'aeoniti', 'ollastack', 'ollavpn']);
const AI_AGENTS_SLUGS = new Set(['ollima', 'ollagraph', 'ollabear', 'ollasuper', 'memfog', 'browserfog', 'crawlcrawl', 'aeoniti', '24observe']);
const SECURITY_SLUGS = new Set(['quickztna', 'quicksdwan', 'meshwg', 'ollavpn', 'olladns', '21tunnel']);
const DEV_APIS_SLUGS = new Set(['ollastack', 'ollanode', '21tunnel', 'crawlcrawl', '24observe', 'olladns', 'ollagraph']);
const SAAS_SLUGS = new Set(['ollasync', 'freefreecv', 'nhprep', 'networkershome', 'ollasuper']);

// Filter categories
const filterCategories = [
  { id: 'all', label: 'All', count: allPosts.length },
  { id: 'must-read', label: 'Must Read', count: MUST_READ_SLUGS.size },
  { id: 'editors-pick', label: "Editor's Pick", count: EDITORS_PICK_SLUGS.size },
  { id: 'ai-agents', label: 'AI & Agents', count: AI_AGENTS_SLUGS.size },
  { id: 'security', label: 'Security & VPN', count: SECURITY_SLUGS.size },
  { id: 'dev-apis', label: 'Dev APIs', count: DEV_APIS_SLUGS.size },
  { id: 'saas', label: 'SaaS', count: SAAS_SLUGS.size },
];

const enhancedPosts = allPosts.map((p, i) => {
  const isMustRead = MUST_READ_SLUGS.has(p.slug);
  const isEditorsPick = EDITORS_PICK_SLUGS.has(p.slug);
  const isAi = AI_AGENTS_SLUGS.has(p.slug);
  const isSecurity = SECURITY_SLUGS.has(p.slug);
  const isDevApi = DEV_APIS_SLUGS.has(p.slug);
  const isSaas = SAAS_SLUGS.has(p.slug);

  const tags: string[] = ['all'];
  if (isMustRead) tags.push('must-read');
  if (isEditorsPick) tags.push('editors-pick');
  if (isAi) tags.push('ai-agents');
  if (isSecurity) tags.push('security');
  if (isDevApi) tags.push('dev-apis');
  if (isSaas) tags.push('saas');

  let badge = '';
  if (isMustRead) badge = 'Must Read';
  else if (isEditorsPick) badge = "Editor's Pick";
  else if (p.category === 'security') badge = 'Security';
  else if (p.category === 'api') badge = 'Dev API';
  else if (p.category === 'ai') badge = 'AI Agent';
  else if (p.category === 'saas') badge = 'SaaS';
  else badge = 'Deep Dive';

  return {
    ...p,
    indexStr: String(i + 1).padStart(2, '0'),
    filterTags: tags.join(' '),
    curatedBadge: badge,
    isMustRead,
    isEditorsPick,
  };
});

// Categorized archive grouping for bottom archive section (matching NetworkersHome topology)
const archiveCategories = [
  {
    name: 'AI & Autonomous Agents',
    posts: allPosts.filter((p) => p.category === 'ai'),
  },
  {
    name: 'Developer APIs & Tooling',
    posts: allPosts.filter((p) => p.category === 'api'),
  },
  {
    name: 'Security & Mesh Networks',
    posts: allPosts.filter((p) => p.category === 'security'),
  },
  {
    name: 'Training & Career SaaS',
    posts: allPosts.filter((p) => p.category === 'saas' || p.category === 'training' || p.category === 'education'),
  },
];

const featuredPost = enhancedPosts[0];
const remainingPosts = enhancedPosts.slice(1);
---
<Layout
  title="Brand Deep-Dives — Ollasoftware Blog"
  description="Long-form 5,000-word brand deep-dives on every Olla product — Ollima, Ollagraph, Ollabear, Ollanode, OllaDNS and more. Honest, technical, useful."
  keywords={[
    'top seo agency in bangalore',
    'software development company in bangalore',
    'ai software development company bangalore',
    'seo agency bangalore',
    'custom software development company in bangalore',
    'best software development company in bangalore',
    'aeo agency bangalore',
    'answer engine optimization india',
    'ollasoftware blog',
    'deep-dive tech blog bangalore'
  ]}
  breadcrumb={breadcrumb}
  jsonLd={[blogLd, breadcrumbLd(breadcrumb)]}
>
  <!-- Hero Section with Left / Right Split Layout (Preserved exactly as requested) -->
  <section class="blog-hero-split">
    <div class="hero-col hero-left">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href="/">home</a>
        <span class="sep">/</span>
        <span class="current">blog</span>
      </nav>

      <div class="eyebrow-wrap">
        <Tag>BRAND DEEP-DIVES · 5,000 WORDS EACH</Tag>
      </div>

      <h1 class="hero-h1">The Ollasoftware blog.</h1>

      <p class="hero-desc">
        One 5,000-word piece per AI brand we own and operate. Built for the developer who wants to know exactly what each product does, who it is for, and how it compares — before they commit a single line of code.
      </p>

      <div class="hero-actions">
        <Btn primary href="/contact/">Talk to Ollasoftware →</Btn>
        <Btn href="/work/">See our work</Btn>
      </div>
    </div>

    <div class="hero-col hero-right">
      <div class="eyebrow-wrap">
        <span class="subtag mono">THE PIECES</span>
      </div>

      <h2 class="right-h2">One piece per brand. Updated as we ship.</h2>

      <p class="right-desc">
        Every brand in the Ollasoftware portfolio gets one long-form deep-dive — what it does, who it is for, how it compares, and what is on the roadmap. The aim is a piece you can read once and have a complete mental model of the product. New pieces ship every 1–2 weeks.
      </p>

      <div class="stats-mini mono">
        <div class="stat-pill">
          <span class="stat-num">{allPosts.length}</span>
          <span class="stat-lbl">Deep Dives</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">5k+</span>
          <span class="stat-lbl">Words/Piece</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">Production AI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Blue Filter Ribbon (Matching Ollasoftware Blog Design) -->
  <aside class="trust-ribbon-blue" aria-label="Filter blog categories">
    <div class="trust-scroller mono">
      {
        filterCategories.map((cat, idx) => (
          <>
            <button
              class={`blue-filter-btn ${idx === 0 ? 'active' : ''}`}
              data-filter={cat.id}
              type="button"
              aria-label={`Filter by ${cat.label}`}
            >
              <span class="lbl">{cat.label}</span>
              <span class="num">{cat.count}</span>
            </button>
            {idx < filterCategories.length - 1 && <span class="trust-dot">·</span>}
          </>
        ))
      }
    </div>
  </aside>

  <!-- Main 3-Column Content Layout -->
  <div class="blog-main-layout" id="pieces">
    <!-- Left Column: Founder Special & All 21 Pieces (Expandable Inline) -->
    <aside class="founder-sidebar" aria-label="Founder Special & Brand Deep-Dives">
      <div class="sidebar-sticky-inner">
        <div class="sidebar-badge-header">
          <span class="nh-pill-amber">FOUNDER SPECIAL</span>
        </div>

        <nav class="sidebar-clean-nav" aria-label="Founder Special Articles List">
          {enhancedPosts.slice(0, 8).map((p) => (
            <a
              href={`/blog/${p.slug}/`}
              class="sidebar-clean-link sidebar-post-item"
              data-slug={p.slug}
              data-tags={p.filterTags}
              data-title={p.title.toLowerCase()}
              data-brand={p.brand.toLowerCase()}
            >
              {p.brand} — {p.brandTagline}
            </a>
          ))}

          <!-- Expandable remaining posts list shown directly below on click -->
          <div id="sidebarRemainingPosts" class="sidebar-expandable-list" style="display: none;">
            {enhancedPosts.slice(8).map((p) => (
              <a
                href={`/blog/${p.slug}/`}
                class="sidebar-clean-link sidebar-post-item"
                data-slug={p.slug}
                data-tags={p.filterTags}
                data-title={p.title.toLowerCase()}
                data-brand={p.brand.toLowerCase()}
              >
                {p.brand} — {p.brandTagline}
              </a>
            ))}
          </div>
        </nav>

        <button
          type="button"
          id="toggleSidebarBtn"
          class="sidebar-view-all-amber"
          aria-expanded="false"
        >
          View All ({enhancedPosts.length}) ↓
        </button>
      </div>
    </aside>

    <!-- Middle Column: Newest Articles & 3-Col Grid -->
    <div class="posts-column">
      <!-- Section Header -->
      <div class="section-label-bar">
        <span class="newest-pill" id="sectionLabelPill">NEWEST ARTICLES</span>
      </div>

      <!-- Featured Top Card with Watermark -->
      <a
        class="featured-hero-card"
        id="featuredHeroCard"
        href={`/blog/${featuredPost.slug}/`}
        data-slug={featuredPost.slug}
        data-tags={featuredPost.filterTags}
        data-title={featuredPost.title.toLowerCase()}
        data-brand={featuredPost.brand.toLowerCase()}
        data-desc={featuredPost.metaDescription.toLowerCase()}
      >
        <div class="card-watermark" id="featuredWatermark" aria-hidden="true">
          <picture>
            <source srcset="/nh-watermark.webp" type="image/webp" />
            <img src="/nh-watermark.webp" alt="" class="watermark-img" id="watermarkImg" />
          </picture>
        </div>
        <div class="featured-tags-row">
          <div class="tags-left">
            <span class="category-pill-brand" id="featuredBadge">{featuredPost.curatedBadge}</span>
            <span class="card-domain-tag mono" id="featuredDomain">{featuredPost.brandDomain}</span>
          </div>
          <span class="new-badge-pill">NEW</span>
        </div>
        <h2 class="featured-title" id="featuredTitle">{featuredPost.brand} — {featuredPost.brandTagline}</h2>
        <p class="featured-desc" id="featuredDesc">{featuredPost.metaDescription}</p>
        <div class="featured-foot">
          <span class="meta-read-time mono" id="featuredReadTime">{featuredPost.readingTimeMin} min read</span>
          <span class="meta-read-link">Read article →</span>
        </div>
      </a>

      <!-- 3-Column Card Grid -->
      <div class="post-grid-3col" id="postGrid">
        {
          remainingPosts.map((p) => (
            <a
              class="clean-post-card post-card"
              id={`card-${p.slug}`}
              data-slug={p.slug}
              href={`/blog/${p.slug}/`}
              data-tags={p.filterTags}
              data-title={p.title.toLowerCase()}
              data-brand={p.brand.toLowerCase()}
              data-desc={p.metaDescription.toLowerCase()}
            >
              <div class="card-top-row">
                <span class="category-pill-brand">{p.curatedBadge}</span>
                <span class="card-domain-tag mono">{p.brandDomain}</span>
              </div>
              <div class="card-content-area">
                <h3 class="card-clean-title">{p.brand}</h3>
                <p class="card-clean-tagline">{p.brandTagline}</p>
                <p class="card-clean-desc">{p.metaDescription}</p>
              </div>
              <div class="card-clean-foot">
                <span class="card-read-time mono">{p.readingTimeMin} min read</span>
                <span class="card-clean-cta">Read article →</span>
              </div>
            </a>
          ))
        }
      </div>

      <!-- No Results Found State -->
      <div id="noResults" class="no-results mono" style="display: none;">
        <p>No deep-dives found matching this query or filter.</p>
        <button class="reset-filter-btn" type="button" id="resetAllBtn">View All Pieces</button>
      </div>
    </div>

    <!-- Right Column: About Us (Seamless navigation matching main site) -->
    <aside class="about-sidebar" aria-label="About Ollasoftware">
      <div class="sidebar-sticky-inner">
        <div class="sidebar-badge-header">
          <span class="nh-pill-purple">ABOUT US</span>
        </div>

        <nav class="sidebar-clean-nav" aria-label="About Us Links List">
          <a href="/about/#founder" class="sidebar-clean-link">
            Meet Founder · Dual CCIE #22239
          </a>
          <a href="/about/#the-why" class="sidebar-clean-link">
            The Why · Company Story & Philosophy
          </a>
          <a href="/about/#team" class="sidebar-clean-link">
            The Senior Team · Engineers & Leads
          </a>
          <a href="/about/#where-we-work" class="sidebar-clean-link">
            Where We Work · 4 Global Hubs
          </a>
          <a href="/jobs/" class="sidebar-clean-link">
            Careers · Hiring 19 Open Roles
          </a>
          <a href="/about/#press" class="sidebar-clean-link">
            Press & Media Coverage
          </a>
          <a href="/services/" class="sidebar-clean-link">
            Services · AI, Software & AEO
          </a>
          <a href="/process/" class="sidebar-clean-link">
            Process & Security · SOC 2 & GDPR
          </a>
        </nav>

        <a href="/about/" class="sidebar-view-all-purple">
          Explore About Page →
        </a>
      </div>
    </aside>
  </div>

  <!-- Complete Blog Archive Section (Topology from NetworkersHome Blog) -->
  <section class="blog-archive-section">
    <!-- Atmospheric Background Logo Watermark -->
    <div class="archive-bg-watermark" aria-hidden="true">
      <picture>
        <source srcset="/loogogo.webp" type="image/webp" />
        <img src="/loogogo.png" alt="" class="archive-watermark-img" />
      </picture>
    </div>

    <div class="archive-inner">
      <div class="archive-header">
        <span class="archive-eyebrow">COMPLETE DIRECTORY</span>
        <h2 class="archive-title">Complete blog archive</h2>
        <p class="archive-sub">
          Browse all {allPosts.length} brand deep-dives by category. Use the interactive filters above for keyword filtering, or scan the archive below for direct browsing.
        </p>
      </div>

      <div class="archive-main-layout">
        <!-- Directory Categories Column (Multi-column responsive layout per category) -->
        <div class="archive-directory-col">
          {
            archiveCategories.map((group) => (
              <div class="archive-category-block">
                <div class="archive-cat-head">
                  <h3 class="archive-cat-name">{group.name}</h3>
                  <span class="archive-cat-count">({group.posts.length})</span>
                </div>
                <ul class="archive-links-grid">
                  {group.posts.map((p) => (
                    <li class="archive-link-item">
                      <a href={`/blog/${p.slug}/`} class="archive-link">
                        <span class="archive-link-brand">{p.brand}</span>
                        <span class="archive-link-tagline">— {p.brandTagline}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <!-- Ecosystem Showcase Sidebar with /loogogo.webp to visually balance and fill the section -->
        <aside class="archive-brand-sidebar">
          <div class="archive-brand-card">
            <div class="archive-brand-card-top">
              <span class="archive-brand-pill">✦ OFFICIAL DIRECTORY</span>
            </div>
            
            <div class="archive-brand-img-wrap">
              <picture>
                <source srcset="/loogogo.webp" type="image/webp" />
                <img
                  src="/loogogo.png"
                  alt="OllaSoftware Brand Suite"
                  class="archive-brand-img"
                  loading="lazy"
                />
              </picture>
            </div>

            <h3 class="archive-brand-heading">OllaSoftware Ecosystem</h3>
            <p class="archive-brand-desc">
              All 21 production platforms across Autonomous AI Agents, Zero Trust Security, High-Performance APIs, and Tech Career SaaS.
            </p>

            <div class="archive-brand-stats-grid">
              <div class="archive-stat-box">
                <span class="archive-stat-val">11</span>
                <span class="archive-stat-lbl">AI Agents</span>
              </div>
              <div class="archive-stat-box">
                <span class="archive-stat-val">4</span>
                <span class="archive-stat-lbl">Security & VPN</span>
              </div>
              <div class="archive-stat-box">
                <span class="archive-stat-val">2</span>
                <span class="archive-stat-lbl">Dev APIs</span>
              </div>
              <div class="archive-stat-box">
                <span class="archive-stat-val">4</span>
                <span class="archive-stat-lbl">Career SaaS</span>
              </div>
            </div>

            <div class="archive-brand-footer">
              <a href="/" class="archive-brand-cta">
                Explore ollasoftware.com <span class="cta-arrow">→</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<!-- Client Script for Real-time Search & Filter Interaction -->
<script is:inline define:vars={{ postsData: enhancedPosts }}>
  function initBlog() {
    const filterBtns = document.querySelectorAll('.blue-filter-btn');
    const gridCards = document.querySelectorAll('#postGrid .clean-post-card');
    const sidebarItems = document.querySelectorAll('.sidebar-post-item');
    const noResults = document.getElementById('noResults');
    const resetAllBtn = document.getElementById('resetAllBtn');

    const featuredHeroCard = document.getElementById('featuredHeroCard');
    const featuredWatermark = document.getElementById('featuredWatermark');
    const watermarkImg = document.getElementById('watermarkImg');
    const sectionLabelPill = document.getElementById('sectionLabelPill');
    const featuredBadge = document.getElementById('featuredBadge');
    const featuredDomain = document.getElementById('featuredDomain');
    const featuredTitle = document.getElementById('featuredTitle');
    const featuredDesc = document.getElementById('featuredDesc');
    const featuredReadTime = document.getElementById('featuredReadTime');

    if (!filterBtns.length) return;

    const watermarkMap = {
      'networkershome': '/nh-watermark.webp',
      '21tunnel': '/watermarks/21tunnel.webp',
      'meshwg': '/watermarks/meshwg.webp',
      'browserfog': '/watermarks/browserfog.webp',
      'quicksdwan': '/watermarks/quicksdwan.webp',
      'nhprep': '/watermarks/nhprep.webp',
      'ollima': '/watermarks/21tunnel.webp',
      'crawlcrawl': '/watermarks/browserfog.webp',
      'memfog': '/watermarks/browserfog.webp',
      'aeoniti': '/watermarks/browserfog.webp',
      'ollagraph': '/watermarks/21tunnel.webp',
      'ollastack': '/watermarks/21tunnel.webp',
      'ollanode': '/watermarks/21tunnel.webp',
      'olladns': '/watermarks/quicksdwan.webp',
      'quickztna': '/watermarks/quicksdwan.webp',
      'ollavpn': '/watermarks/meshwg.webp',
      'freefreecv': '/watermarks/nhprep.webp',
      'ollasync': '/watermarks/nhprep.webp',
      'ollasuper': '/watermarks/21tunnel.webp',
      'ollabear': '/watermarks/browserfog.webp',
      '24observe': '/watermarks/21tunnel.webp'
    };

    const labelMap = {
      'all': 'NEWEST ARTICLES',
      'must-read': 'FEATURED · MUST READ',
      'editors-pick': "FEATURED · EDITOR'S PICK",
      'ai-agents': 'FEATURED · AI & AGENTS',
      'security': 'FEATURED · SECURITY & VPN',
      'dev-apis': 'FEATURED · DEV APIS',
      'saas': 'FEATURED · SAAS'
    };

    let activeFilter = 'all';

    function applyFilter(targetFilter) {
      activeFilter = targetFilter;

      // Update button active states
      filterBtns.forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-filter') === targetFilter);
      });

      // Update Section Header Pill
      if (sectionLabelPill) {
        sectionLabelPill.textContent = labelMap[targetFilter] || 'FEATURED ARTICLES';
      }

      // Filter matching posts
      const matchingPosts = postsData.filter(p => {
        if (targetFilter === 'all') return true;
        const tags = (p.filterTags || '').split(' ');
        return tags.includes(targetFilter);
      });

      if (matchingPosts.length > 0) {
        const featured = matchingPosts[0];
        const remainingSlugs = new Set(matchingPosts.slice(1).map(p => p.slug));

        // Update featured hero card
        if (featuredHeroCard) {
          featuredHeroCard.style.display = 'flex';
          featuredHeroCard.href = `/blog/${featured.slug}/`;
          if (featuredBadge) featuredBadge.textContent = featured.curatedBadge;
          if (featuredDomain) featuredDomain.textContent = featured.brandDomain;
          if (featuredTitle) featuredTitle.textContent = `${featured.brand} — ${featured.brandTagline}`;
          if (featuredDesc) featuredDesc.textContent = featured.metaDescription;
          if (featuredReadTime) featuredReadTime.textContent = `${featured.readingTimeMin} min read`;

          if (featuredWatermark && watermarkImg) {
            const customWatermark = watermarkMap[featured.slug];
            if (customWatermark) {
              watermarkImg.src = customWatermark;
              featuredWatermark.style.display = 'flex';
            } else {
              featuredWatermark.style.display = 'none';
            }
          }
        }

        // Update cards in 3-col grid
        gridCards.forEach(card => {
          const slug = card.getAttribute('data-slug');
          card.style.display = remainingSlugs.has(slug) ? 'flex' : 'none';
        });

        if (noResults) noResults.style.display = 'none';
      } else {
        if (featuredHeroCard) featuredHeroCard.style.display = 'none';
        gridCards.forEach(card => card.style.display = 'none');
        if (noResults) noResults.style.display = 'block';
      }

      // Update Sidebar Items
      sidebarItems.forEach(item => {
        const tags = (item.getAttribute('data-tags') || '').split(' ');
        item.style.display = (targetFilter === 'all' || tags.includes(targetFilter)) ? 'flex' : 'none';
      });

      // Update URL hash without scroll jumping
      if (history.replaceState) {
        const newUrl = targetFilter === 'all'
          ? window.location.pathname + window.location.search
          : `${window.location.pathname}${window.location.search}#${targetFilter}`;
        history.replaceState(null, '', newUrl);
      }
    }

    // Category button listeners
    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = btn.getAttribute('data-filter') || 'all';
        applyFilter(filter);
      });
    });

    // Reset button listener
    if (resetAllBtn) {
      resetAllBtn.addEventListener('click', () => {
        applyFilter('all');
      });
    }

    // Toggle sidebar expandable list
    const toggleSidebarBtn = document.getElementById('toggleSidebarBtn');
    const sidebarRemainingPosts = document.getElementById('sidebarRemainingPosts');
    if (toggleSidebarBtn && sidebarRemainingPosts) {
      toggleSidebarBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isHidden = sidebarRemainingPosts.style.display === 'none';
        if (isHidden) {
          sidebarRemainingPosts.style.display = 'flex';
          toggleSidebarBtn.textContent = 'Show Less ↑';
          toggleSidebarBtn.setAttribute('aria-expanded', 'true');
        } else {
          sidebarRemainingPosts.style.display = 'none';
          toggleSidebarBtn.textContent = `View All (${postsData.length}) ↓`;
          toggleSidebarBtn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Read initial filter from URL hash
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && document.querySelector(`[data-filter="${initialHash}"]`)) {
      applyFilter(initialHash);
    } else {
      applyFilter('all');
    }
  }

  // Lifecycle execution
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlog);
  } else {
    initBlog();
  }
  document.addEventListener('astro:page-load', initBlog);
</script>

