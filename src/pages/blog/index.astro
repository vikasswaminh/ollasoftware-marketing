---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/primitives/Tag.astro';
import Btn from '../../components/primitives/Btn.astro';
import { allPosts } from '../../lib/blog';
import { SITE, breadcrumbLd } from '../../lib/seo';

const breadcrumb = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'Blog', url: `${SITE}/blog/` },
];

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/blog/#blog`,
  name: 'Ollasoftware Brand Deep-Dives',
  description: 'Long-form, 5,000-word pieces on every AI brand in the Ollasoftware portfolio. Honest, technical, no fluff.',
  url: `${SITE}/blog/`,
  publisher: { '@id': `${SITE}#organization` },
  blogPost: allPosts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: `${SITE}/blog/${p.slug}/`,
    description: p.metaDescription,
    datePublished: p.publishedOn,
    dateModified: p.lastUpdated,
  })),
};

// Curated filter tags mapping
const MUST_READ_SLUGS = new Set(['ollima', '24observe', 'ollagraph', 'quickztna', 'crawlcrawl', 'ollanode', '21tunnel']);
const EDITORS_PICK_SLUGS = new Set(['memfog', 'ollabear', 'meshwg', 'aeoniti', 'ollastack', 'ollavpn']);
const AI_AGENTS_SLUGS = new Set(['ollima', 'ollagraph', 'ollabear', 'ollasuper', 'memfog', 'browserfog', 'crawlcrawl', 'aeoniti', '24observe']);
const SECURITY_SLUGS = new Set(['quickztna', 'quicksdwan', 'meshwg', 'ollavpn', 'olladns', '21tunnel']);
const DEV_APIS_SLUGS = new Set(['ollastack', 'ollanode', '21tunnel', 'crawlcrawl', '24observe', 'olladns', 'ollagraph']);
const SAAS_SLUGS = new Set(['ollasync', 'freefreecv', 'nhprep', 'networkershome', 'ollasuper']);

// Filter categories
const filterCategories = [
  { id: 'all', label: 'All', count: allPosts.length },
  { id: 'must-read', label: 'Must Read', count: MUST_READ_SLUGS.size },
  { id: 'editors-pick', label: "Editor's Pick", count: EDITORS_PICK_SLUGS.size },
  { id: 'ai-agents', label: 'AI & Agents', count: AI_AGENTS_SLUGS.size },
  { id: 'security', label: 'Security & VPN', count: SECURITY_SLUGS.size },
  { id: 'dev-apis', label: 'Dev APIs', count: DEV_APIS_SLUGS.size },
  { id: 'saas', label: 'SaaS', count: SAAS_SLUGS.size },
];

const enhancedPosts = allPosts.map((p, i) => {
  const isMustRead = MUST_READ_SLUGS.has(p.slug);
  const isEditorsPick = EDITORS_PICK_SLUGS.has(p.slug);
  const isAi = AI_AGENTS_SLUGS.has(p.slug);
  const isSecurity = SECURITY_SLUGS.has(p.slug);
  const isDevApi = DEV_APIS_SLUGS.has(p.slug);
  const isSaas = SAAS_SLUGS.has(p.slug);

  const tags: string[] = ['all'];
  if (isMustRead) tags.push('must-read');
  if (isEditorsPick) tags.push('editors-pick');
  if (isAi) tags.push('ai-agents');
  if (isSecurity) tags.push('security');
  if (isDevApi) tags.push('dev-apis');
  if (isSaas) tags.push('saas');

  let badge = '';
  if (isMustRead) badge = 'Must Read';
  else if (isEditorsPick) badge = "Editor's Pick";
  else if (p.category === 'security') badge = 'Security';
  else if (p.category === 'api') badge = 'Dev API';
  else if (p.category === 'ai') badge = 'AI Agent';
  else if (p.category === 'saas') badge = 'SaaS';
  else badge = 'Deep Dive';

  return {
    ...p,
    indexStr: String(i + 1).padStart(2, '0'),
    filterTags: tags.join(' '),
    curatedBadge: badge,
    isMustRead,
    isEditorsPick
  };
});

const featuredPost = enhancedPosts[0];
---
<Layout
  title="Brand Deep-Dives — Ollasoftware Blog"
  description="Long-form 5,000-word brand deep-dives on every Olla product — Ollima, Ollagraph, Ollabear, Ollanode, OllaDNS and more. Honest, technical, useful."
  breadcrumb={breadcrumb}
  jsonLd={[blogLd, breadcrumbLd(breadcrumb)]}
>
  <!-- Hero Section with Left / Right Split Layout -->
  <section class="blog-hero-split">
    <div class="hero-col hero-left">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href="/">home</a>
        <span class="sep">/</span>
        <span class="current">blog</span>
      </nav>

      <div class="eyebrow-wrap">
        <Tag>BRAND DEEP-DIVES · 5,000 WORDS EACH</Tag>
      </div>

      <h1 class="hero-h1">The Ollasoftware blog.</h1>

      <p class="hero-desc">
        One 5,000-word piece per AI brand we own and operate. Built for the developer who wants to know exactly what each product does, who it is for, and how it compares — before they commit a single line of code.
      </p>

      <div class="hero-actions">
        <Btn primary href="/contact/">Talk to Ollasoftware →</Btn>
        <Btn href="/work/">See our work</Btn>
      </div>
    </div>

    <div class="hero-col hero-right">
      <div class="eyebrow-wrap">
        <span class="subtag mono">THE PIECES</span>
      </div>

      <h2 class="right-h2">One piece per brand. Updated as we ship.</h2>

      <p class="right-desc">
        Every brand in the Ollasoftware portfolio gets one long-form deep-dive — what it does, who it is for, how it compares, and what is on the roadmap. The aim is a piece you can read once and have a complete mental model of the product. New pieces ship every 1–2 weeks.
      </p>

      <div class="stats-mini mono">
        <div class="stat-pill">
          <span class="stat-num">{allPosts.length}</span>
          <span class="stat-lbl">Deep Dives</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">5k+</span>
          <span class="stat-lbl">Words/Piece</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">Production AI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Blue Filter Ribbon (Clean text, numbers, perfectly centered) -->
  <aside class="trust-ribbon-blue" aria-label="Filter blog categories">
    <div class="trust-scroller mono">
      {filterCategories.map((cat, idx) => (
        <>
          <button
            class={`blue-filter-btn ${idx === 0 ? 'active' : ''}`}
            data-filter={cat.id}
            type="button"
            aria-label={`Filter by ${cat.label}`}
          >
            <span class="lbl">{cat.label}</span>
            <span class="num">{cat.count}</span>
          </button>
          {idx < filterCategories.length - 1 && <span class="trust-dot">·</span>}
        </>
      ))}
    </div>
  </aside>

  <!-- Main Content Layout with Sticky Left Sidebar + Blog Content -->
  <section class="blog-main-layout" id="pieces">
    <!-- Left Column: Sticky Blog Headings Directory -->
    <aside class="founder-sidebar" aria-label="Blog Deep-Dives Directory">
      <div class="founder-sticky-box">
        <div class="founder-header">
          <span class="founder-badge mono">ALL 21 PIECES</span>
          <h3 class="founder-h3">Blog Directory</h3>
          <p class="founder-sub mono">Tap any brand to jump or read</p>
        </div>
        
        <nav class="founder-nav" aria-label="Brand Deep Dives List">
          {enhancedPosts.map((p) => (
            <a
              href={`/blog/${p.slug}/`}
              class="founder-link sidebar-post-item"
              data-slug={p.slug}
              data-tags={p.filterTags}
              title={`Read ${p.brand} Deep-Dive`}
            >
              <span class="sidebar-item-num mono">{p.indexStr}</span>
              <span class="founder-link-title">{p.brand}</span>
              <span class="sidebar-item-cat mono">{p.category}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Right Column: Blog Cards Arranged in Landing Page Theme -->
    <div class="posts-column">
      <!-- Top Section Header -->
      <div class="section-label-bar">
        <span class="newest-pill" id="sectionLabelPill">NEWEST ARTICLES</span>
      </div>

      <!-- Featured Top Compact Horizontal Card with Dynamic Brand Watermark -->
      <a
        class="featured-hero-card"
        id="featuredHeroCard"
        href={`/blog/${featuredPost.slug}/`}
      >
        <div class="card-watermark" id="featuredWatermark" aria-hidden="true">
          <img src="/nh-watermark.png" alt="" class="watermark-img" id="watermarkImg" />
        </div>
        <div class="featured-tags-row">
          <div class="tags-left">
            <span class="category-pill-brand" id="featuredBadge">{featuredPost.curatedBadge}</span>
            <span class="card-domain-tag mono" id="featuredDomain">{featuredPost.brandDomain}</span>
          </div>
          <span class="new-badge-pill">NEW</span>
        </div>
        <h2 class="featured-title" id="featuredTitle">{featuredPost.brand} — {featuredPost.brandTagline}</h2>
        <p class="featured-desc" id="featuredDesc">{featuredPost.metaDescription}</p>
        <div class="featured-foot">
          <span class="meta-read-time mono" id="featuredReadTime">{featuredPost.readingTimeMin} min read</span>
          <span class="meta-read-link">Read article →</span>
        </div>
      </a>

      <!-- 3-Column Grid for All Remaining Blog Pieces -->
      <div class="post-grid-3col" id="postGrid">
        {enhancedPosts.map((p) => (
          <a
            class="clean-post-card post-card"
            id={`card-${p.slug}`}
            data-slug={p.slug}
            href={`/blog/${p.slug}/`}
            data-tags={p.filterTags}
          >
            <div class="card-top-row">
              <span class="category-pill-brand">{p.curatedBadge}</span>
              <span class="card-domain-tag mono">{p.brandDomain}</span>
            </div>
            <div class="card-content-area">
              <h3 class="card-clean-title">{p.brand}</h3>
              <p class="card-clean-tagline">{p.brandTagline}</p>
              <p class="card-clean-desc">{p.metaDescription}</p>
            </div>
            <div class="card-clean-foot">
              <span class="card-read-time mono">{p.readingTimeMin} min read</span>
              <span class="card-clean-cta">Read article →</span>
            </div>
          </a>
        ))}
      </div>
      
      <div id="noResults" class="no-results mono" style="display: none;">
        <p>No deep-dives found matching this filter.</p>
        <button class="reset-filter-btn" type="button" onclick="document.querySelector('[data-filter=all]')?.click()">View All Pieces</button>
      </div>
    </div>

    <!-- Right Column: Sticky About Us Directory + Big Background Building Logo Anchored at Bottom -->
    <aside class="about-sidebar" aria-label="About Ollasoftware Directory">
      <div class="right-sticky-wrapper">
        <div class="about-sticky-box">
          <div class="about-header">
            <span class="founder-badge mono">ABOUT US</span>
            <h3 class="founder-h3">The Company</h3>
            <p class="founder-sub mono">Bangalore HQ · 40+ Brands</p>
          </div>
          
          <nav class="about-nav" aria-label="About Company Links">
            <a href="/about/#founder" class="founder-link about-link" title="Meet the Founder">
              <span class="sidebar-item-num mono">01</span>
              <span class="founder-link-title">FOUNDER</span>
              <span class="sidebar-item-cat mono">CCIE</span>
            </a>
            <a href="/about/#the-why" class="founder-link about-link" title="The why - Company Story">
              <span class="sidebar-item-num mono">02</span>
              <span class="founder-link-title">The why.</span>
              <span class="sidebar-item-cat mono">STORY</span>
            </a>
            <a href="/about/#team" class="founder-link about-link" title="The Senior Team">
              <span class="sidebar-item-num mono">03</span>
              <span class="founder-link-title">THE TEAM</span>
              <span class="sidebar-item-cat mono">SENIOR</span>
            </a>
            <a href="/about/#where-we-work" class="founder-link about-link" title="Global Hubs & Offices">
              <span class="sidebar-item-num mono">04</span>
              <span class="founder-link-title">WHERE WE WORK</span>
              <span class="sidebar-item-cat mono">4 HUBS</span>
            </a>
            <a href="/jobs/" class="founder-link about-link" title="Careers & Open Roles">
              <span class="sidebar-item-num mono">05</span>
              <span class="founder-link-title">CAREERS</span>
              <span class="sidebar-item-cat mono">HIRING</span>
            </a>
            <a href="/about/#press" class="founder-link about-link" title="Press & Mentions">
              <span class="sidebar-item-num mono">06</span>
              <span class="founder-link-title">PRESS</span>
              <span class="sidebar-item-cat mono">MEDIA</span>
            </a>
          </nav>
        </div>

        <!-- Big Background Building Logo Anchored Near Bottom of Screen -->
        <div class="sidebar-bg-logo-anchor" aria-hidden="true">
          <img
            src="/ollasoftware-vertical-building.png"
            alt=""
            class="sidebar-bg-building-img"
          />
        </div>
      </div>
    </aside>
  </section>
</Layout>

<script is:inline define:vars={{ postsData: enhancedPosts }}>
  function initBlogFilters() {
    const filterBtns = document.querySelectorAll('.blue-filter-btn');
    const gridCards = document.querySelectorAll('#postGrid .clean-post-card');
    const sidebarItems = document.querySelectorAll('.sidebar-post-item');
    const noResults = document.getElementById('noResults');

    const featuredHeroCard = document.getElementById('featuredHeroCard');
    const featuredWatermark = document.getElementById('featuredWatermark');
    const watermarkImg = document.getElementById('watermarkImg');
    const sectionLabelPill = document.getElementById('sectionLabelPill');
    const featuredBadge = document.getElementById('featuredBadge');
    const featuredDomain = document.getElementById('featuredDomain');
    const featuredTitle = document.getElementById('featuredTitle');
    const featuredDesc = document.getElementById('featuredDesc');
    const featuredReadTime = document.getElementById('featuredReadTime');

    if (!filterBtns.length) return;

    const watermarkMap = {
      'networkershome': '/nh-watermark.png',
      '21tunnel': '/watermarks/21tunnel.jpg',
      'meshwg': '/watermarks/meshwg.jpg',
      'browserfog': '/watermarks/browserfog.jpg',
      'quicksdwan': '/watermarks/quicksdwan.jpg',
      'nhprep': '/watermarks/nhprep.jpg',
      'ollima': '/watermarks/21tunnel.jpg',
      'crawlcrawl': '/watermarks/browserfog.jpg',
      'memfog': '/watermarks/browserfog.jpg',
      'aeoniti': '/watermarks/browserfog.jpg',
      'ollagraph': '/watermarks/21tunnel.jpg',
      'ollastack': '/watermarks/21tunnel.jpg',
      'ollanode': '/watermarks/21tunnel.jpg',
      'olladns': '/watermarks/quicksdwan.jpg',
      'quickztna': '/watermarks/quicksdwan.jpg',
      'ollavpn': '/watermarks/meshwg.jpg',
      'freefreecv': '/watermarks/nhprep.jpg',
      'ollasync': '/watermarks/nhprep.jpg',
      'ollasuper': '/watermarks/21tunnel.jpg',
      'ollabear': '/watermarks/browserfog.jpg',
      '24observe': '/watermarks/21tunnel.jpg'
    };

    const labelMap = {
      'all': 'NEWEST ARTICLES',
      'must-read': 'FEATURED · MUST READ',
      'editors-pick': "FEATURED · EDITOR'S PICK",
      'ai-agents': 'FEATURED · AI & AGENTS',
      'security': 'FEATURED · SECURITY & VPN',
      'dev-apis': 'FEATURED · DEV APIS',
      'saas': 'FEATURED · SAAS'
    };

    function applyFilter(targetFilter) {
      // Update active filter button
      filterBtns.forEach(btn => {
        if (btn.getAttribute('data-filter') === targetFilter) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      // Update Section Header Pill
      if (sectionLabelPill) {
        sectionLabelPill.textContent = labelMap[targetFilter] || 'FEATURED ARTICLES';
      }

      // Filter matching posts data
      const matchingPosts = postsData.filter(p => {
        if (targetFilter === 'all') return true;
        const tags = (p.filterTags || '').split(' ');
        return tags.includes(targetFilter);
      });

      if (matchingPosts.length > 0) {
        const featured = matchingPosts[0];
        const remainingSlugs = new Set(matchingPosts.slice(1).map(p => p.slug));

        // Update the big featured card at top
        if (featuredHeroCard) {
          featuredHeroCard.classList.remove('is-hidden');
          featuredHeroCard.href = `/blog/${featured.slug}/`;
          if (featuredBadge) featuredBadge.textContent = featured.curatedBadge;
          if (featuredDomain) featuredDomain.textContent = featured.brandDomain;
          if (featuredTitle) featuredTitle.textContent = `${featured.brand} — ${featured.brandTagline}`;
          if (featuredDesc) featuredDesc.textContent = featured.metaDescription;
          if (featuredReadTime) featuredReadTime.textContent = `${featured.readingTimeMin} min read`;

          // Dynamically display the specific brand's watermark
          if (featuredWatermark && watermarkImg) {
            const customWatermark = watermarkMap[featured.slug];
            if (customWatermark) {
              watermarkImg.src = customWatermark;
              featuredWatermark.classList.remove('is-hidden');
            } else {
              featuredWatermark.classList.add('is-hidden');
            }
          }
        }

        // Show remaining matching posts in the 3-col grid below (excluding the featured one)
        gridCards.forEach(card => {
          const slug = card.getAttribute('data-slug');
          if (remainingSlugs.has(slug)) {
            card.classList.remove('is-hidden');
          } else {
            card.classList.add('is-hidden');
          }
        });

        if (noResults) noResults.style.display = 'none';
      } else {
        if (featuredHeroCard) featuredHeroCard.classList.add('is-hidden');
        gridCards.forEach(card => card.classList.add('is-hidden'));
        if (noResults) noResults.style.display = 'block';
      }

      // Update Sidebar Items
      sidebarItems.forEach(item => {
        const tags = (item.getAttribute('data-tags') || '').split(' ');
        if (targetFilter === 'all' || tags.includes(targetFilter)) {
          item.classList.remove('is-hidden');
        } else {
          item.classList.add('is-hidden');
        }
      });

      // Update URL hash
      if (history.replaceState) {
        const newUrl = targetFilter === 'all' 
          ? window.location.pathname + window.location.search 
          : `${window.location.pathname}${window.location.search}#${targetFilter}`;
        history.replaceState(null, '', newUrl);
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = btn.getAttribute('data-filter') || 'all';
        applyFilter(filter);
      });
    });

    // Check URL hash on page load
    const hash = window.location.hash.replace('#', '');
    if (hash && document.querySelector(`[data-filter="${hash}"]`)) {
      applyFilter(hash);
    } else {
      applyFilter('all');
    }
  }

  // Support standard load and Astro Client Router lifecycle
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBlogFilters);
  } else {
    initBlogFilters();
  }
  document.addEventListener('astro:page-load', initBlogFilters);
</script>

<style>
  /* Hidden helper for fail-safe JavaScript filtering */
  .featured-hero-card.is-hidden,
  .clean-post-card.is-hidden,
  .sidebar-post-item.is-hidden,
  .card-watermark.is-hidden {
    display: none !important;
  }

  /* Split Hero Layout */
  .blog-hero-split {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 48px !important;
    padding: 72px 56px 64px !important;
    border-bottom: 1px solid var(--o-line) !important;
    background: radial-gradient(circle at 10% 20%, rgba(33, 107, 255, 0.04) 0%, transparent 60%) !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  .hero-col {
    display: flex !important;
    flex-direction: column !important;
  }

  .hero-left {
    padding-right: 32px !important;
    border-right: 1px solid var(--o-line) !important;
  }

  .hero-right {
    justify-content: center !important;
    padding-left: 16px !important;
  }

  .crumbs {
    font-size: 11px !important;
    color: var(--o-mute) !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-bottom: 20px !important;
    letter-spacing: 0.5px !important;
  }
  .crumbs a { color: var(--o-mute) !important; text-decoration: none !important; transition: color .15s !important; }
  .crumbs a:hover { color: var(--o-accent, #216BFF) !important; }
  .crumbs .current { color: var(--o-ink) !important; font-weight: 500 !important; }
  .crumbs .sep { color: var(--o-faint) !important; }

  .eyebrow-wrap {
    margin-bottom: 16px !important;
  }

  .subtag {
    font-size: 10px !important;
    letter-spacing: 1.2px !important;
    color: var(--o-accent, #216BFF) !important;
    text-transform: uppercase !important;
    font-weight: 600 !important;
    display: inline-block !important;
    padding: 3px 8px !important;
    border: 1px solid color-mix(in srgb, var(--o-accent, #216BFF) 30%, transparent) !important;
    background: color-mix(in srgb, var(--o-accent, #216BFF) 6%, transparent) !important;
    border-radius: 4px !important;
  }

  .hero-h1 {
    margin: 0 0 20px !important;
    font-size: clamp(32px, 4vw, 52px) !important;
    line-height: 1.05 !important;
    letter-spacing: -1.8px !important;
    font-weight: 700 !important;
    color: var(--o-ink) !important;
  }

  .hero-desc {
    font-size: 14px !important;
    line-height: 1.65 !important;
    color: var(--o-mute) !important;
    margin: 0 0 28px !important;
    max-width: 600px !important;
  }

  .hero-actions {
    display: flex !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
    align-items: center !important;
  }

  .right-h2 {
    margin: 0 0 16px !important;
    font-size: clamp(22px, 2.2vw, 28px) !important;
    line-height: 1.2 !important;
    letter-spacing: -0.8px !important;
    font-weight: 600 !important;
    color: var(--o-ink) !important;
  }

  .right-desc {
    font-size: 13.5px !important;
    line-height: 1.65 !important;
    color: var(--o-mute) !important;
    margin: 0 0 28px !important;
  }

  .stats-mini {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 12px !important;
    padding-top: 20px !important;
    border-top: 1px dashed var(--o-line) !important;
  }

  .stat-pill {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    background: var(--o-panel, #ffffff) !important;
    border: 1px solid var(--o-line) !important;
    padding: 10px 14px !important;
    border-radius: var(--o-radius, 8px) !important;
  }

  .stat-num {
    font-size: 18px !important;
    font-weight: 700 !important;
    color: var(--o-accent, #216BFF) !important;
    letter-spacing: -0.5px !important;
  }

  .stat-lbl {
    font-size: 9.5px !important;
    color: var(--o-faint) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
  }

  /* Solid Vibrant Blue Filter Ribbon — Sticky below Nav Bar on Scroll */
  .trust-ribbon-blue {
    position: sticky !important;
    top: 64px !important;
    z-index: 35 !important;
