  }

  .blue-filter-btn.active {
    background: #ffffff !important;
    color: #0369a1 !important;
    border-color: #ffffff !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
    text-shadow: none !important;
  }

  .blue-filter-btn.active .sym {
    color: #0284c7 !important;
  }

  .blue-filter-btn.active .num {
    background: #0284c7 !important;
    color: #ffffff !important;
  }

  .trust-dot {
    color: #bae6fd !important;
    font-weight: 800 !important;
  }

  /* Blog Post Grid */
  .grid-wrap {
    padding: 48px 56px 96px !important;
    border-bottom: 1px solid var(--o-line) !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }

  .post-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 18px !important;
  }

  .post-card {
    background: var(--o-panel, rgba(18, 18, 22, 0.6)) !important;
    border: 1px solid var(--o-line) !important;
    border-radius: var(--o-radius, 8px) !important;
