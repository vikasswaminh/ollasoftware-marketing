---
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
import Tag from '../../components/primitives/Tag.astro';
import Btn from '../../components/primitives/Btn.astro';
import { allPosts } from '../../lib/blog';
import { SITE, breadcrumbLd } from '../../lib/seo';

const breadcrumb = [
  { name: 'Home', url: `${SITE}/` },
  { name: 'Blog', url: `${SITE}/blog/` },
];

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/blog/#blog`,
  name: 'Ollasoftware Brand Deep-Dives',
  description: 'Long-form, 5,000-word pieces on every AI brand in the Ollasoftware portfolio. Honest, technical, no fluff.',
  url: `${SITE}/blog/`,
  publisher: { '@id': `${SITE}#organization` },
  blogPost: allPosts.map(p => ({
    '@type': 'BlogPosting',
    headline: p.title,
    url: `${SITE}/blog/${p.slug}/`,
    description: p.metaDescription,
    datePublished: p.publishedOn,
    dateModified: p.lastUpdated,
  })),
};
---
<Layout
  title="Brand Deep-Dives — Ollasoftware Blog"
  description="Long-form 5,000-word brand deep-dives on every Olla product — Ollima, Ollagraph, Ollabear, Ollanode, OllaDNS and more. Honest, technical, useful."
  breadcrumb={breadcrumb}
  jsonLd={[blogLd, breadcrumbLd(breadcrumb)]}
>
  <!-- Hero Section with Left / Right Split Layout -->
  <section class="blog-hero-split">
    <div class="hero-col hero-left">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href="/">home</a>
        <span class="sep">/</span>
        <span class="current">blog</span>
      </nav>

      <div class="eyebrow-wrap">
        <Tag>BRAND DEEP-DIVES · 5,000 WORDS EACH</Tag>
      </div>

      <h1 class="hero-h1">The Ollasoftware blog.</h1>

      <p class="hero-desc">
        One 5,000-word piece per AI brand we own and operate. Built for the developer who wants to know exactly what each product does, who it is for, and how it compares — before they commit a single line of code.
      </p>

      <div class="hero-actions">
        <Btn primary href="/contact/">Talk to Ollasoftware →</Btn>
        <Btn href="/work/">See our work</Btn>
      </div>
    </div>

    <div class="hero-col hero-right">
      <div class="eyebrow-wrap">
        <span class="subtag mono">THE PIECES</span>
      </div>

      <h2 class="right-h2">One piece per brand. Updated as we ship.</h2>

      <p class="right-desc">
        Every brand in the Ollasoftware portfolio gets one long-form deep-dive — what it does, who it is for, how it compares, and what is on the roadmap. The aim is a piece you can read once and have a complete mental model of the product. New pieces ship every 1–2 weeks.
      </p>

      <div class="stats-mini mono">
        <div class="stat-pill">
          <span class="stat-num">{allPosts.length}</span>
          <span class="stat-lbl">Deep Dives</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">5k+</span>
          <span class="stat-lbl">Words/Piece</span>
        </div>
        <div class="stat-pill">
          <span class="stat-num">100%</span>
          <span class="stat-lbl">Production AI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust & Credentials Ribbon (Networkers Home / Ollasoftware Style) -->
  <aside class="trust-ribbon" aria-label="Credentials & Social Proof">
    <div class="trust-scroller mono">
      <a href="/about/" class="trust-item" title="Meet the Founder">
        <span class="icon">👤</span> Meet Founder · Dual CCIE #22239
      </a>
      <span class="trust-dot">·</span>

      <a href="https://www.google.com/maps/place/NETWORKERS+HOME+Cyber+Security+and+Networking+Training+along+with+CCNA,CCNP+and+CCIE+Courses/@12.9152334,77.6295363,17z/data=!3m2!4b1!5s0x3bae148d1f7de241:0x645e9df497bd9279!4m6!3m5!1s0x3bae148cd1dba9cf:0x6908c0bcd3bc3460!8m2!3d12.9152282!4d77.6321166!16s%2Fg%2F124yprl9g" target="_blank" rel="noopener noreferrer" class="trust-item">
        <span class="icon">⭐</span> 4.7★ Google (1,173)
      </a>
      <span class="trust-dot">·</span>

      <a href="https://www.justdial.com/Bangalore/Networks-Home-Next-To-Behive-Work-Space-Hsr-Layout/080PXX80-XX80-180105111119-L5M6_BZDET" target="_blank" rel="noopener noreferrer" class="trust-item">
        <span class="icon">⭐</span> 4.5★ JustDial (1,345)
      </a>
      <span class="trust-dot">·</span>

      <a href="https://www.youtube.com/channel/UCWLd8VySHjRnfPWyvFpZGZw" target="_blank" rel="noopener noreferrer" class="trust-item">
        <span class="icon">▶</span> 171K YouTube
      </a>
      <span class="trust-dot">·</span>

      <a href="/work/" class="trust-item">
        <span class="icon">🚀</span> 22+ Operating Ventures
      </a>
      <span class="trust-dot">·</span>

      <span class="trust-item">
        <span class="icon">💼</span> ₹500Cr+ Invoiced (21Bill)
      </span>
      <span class="trust-dot">·</span>

      <span class="trust-item">
        <span class="icon">🌐</span> 20M+ Users Scaled
      </span>
      <span class="trust-dot">·</span>

      <span class="trust-item">
        <span class="icon">🎓</span> 45,000+ Engineers Placed
      </span>
      <span class="trust-dot">·</span>

      <a href="https://nhprep.com/" target="_blank" rel="noopener noreferrer" class="trust-item">
        <span class="icon">📚</span> LMS: nhprep.com
      </a>
      <span class="trust-dot">·</span>

      <a href="https://vpn.networkershome.com/" target="_blank" rel="noopener noreferrer" class="trust-item">
        <span class="icon">⚡</span> 24/7 Labs & Infrastructure
      </a>
    </div>
  </aside>

  <!-- Blog Pieces Grid -->
  <section class="grid-wrap">
    <div class="grid-header">
      <div class="grid-header-meta">
        <span class="meta-tag mono">PORTFOLIO DEEP-DIVES</span>
        <h3 class="grid-title">All {allPosts.length} Product Breakdowns</h3>
      </div>
      <p class="grid-desc mono">Detailed architecture, comparisons, performance benchmarks, and roadmap analysis.</p>
    </div>

    <div class="post-grid">
      {allPosts.map((p, i) => (
        <a class="post-card" href={`/blog/${p.slug}/`}>
          <div class="card-top">
            <span class="card-num mono">{String(i + 1).padStart(2, '0')}</span>
            <div class="card-badges">
              <span class="card-category mono">{p.category}</span>
              <span class="card-tag mono">{p.brandDomain}</span>
            </div>
          </div>
          <div class="card-main">
            <h3 class="card-h">{p.brand}</h3>
            <p class="card-tagline">{p.brandTagline}</p>
            <p class="card-sub">{p.metaDescription}</p>
          </div>
          <div class="card-foot">
            <span class="card-read-time mono">⏱ {p.readingTimeMin} min read</span>
            <span class="card-cta mono">read the {p.wordCount.toLocaleString()}-word piece →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  /* Split Hero Layout */
  .blog-hero-split {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 48px !important;
    padding: 72px 56px 64px !important;
    border-bottom: 1px solid var(--o-line) !important;
    background: radial-gradient(circle at 10% 20%, rgba(200, 255, 0, 0.03) 0%, transparent 60%) !important;
    position: relative !important;
    box-sizing: border-box !important;
  }

  .hero-col {
    display: flex !important;
    flex-direction: column !important;
  }

  .hero-left {
    padding-right: 32px !important;
    border-right: 1px solid var(--o-line) !important;
  }

  .hero-right {
    justify-content: center !important;
    padding-left: 16px !important;
  }

  .crumbs {
    font-size: 11px !important;
    color: var(--o-mute) !important;
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-bottom: 20px !important;
    letter-spacing: 0.5px !important;
  }
  .crumbs a { color: var(--o-mute) !important; text-decoration: none !important; transition: color .15s !important; }
  .crumbs a:hover { color: var(--o-accent, #c8ff00) !important; }
  .crumbs .current { color: var(--o-ink) !important; font-weight: 500 !important; }
  .crumbs .sep { color: var(--o-faint) !important; }

  .eyebrow-wrap {
    margin-bottom: 16px !important;
  }

  .subtag {
    font-size: 10px !important;
    letter-spacing: 1.2px !important;
    color: var(--o-accent, #c8ff00) !important;
    text-transform: uppercase !important;
    font-weight: 600 !important;
    display: inline-block !important;
    padding: 3px 8px !important;
    border: 1px solid color-mix(in srgb, var(--o-accent, #c8ff00) 30%, transparent) !important;
    background: color-mix(in srgb, var(--o-accent, #c8ff00) 6%, transparent) !important;
    border-radius: 3px !important;
  }

  .hero-h1 {
    margin: 0 0 20px !important;
    font-size: clamp(32px, 4vw, 52px) !important;
    line-height: 1.05 !important;
    letter-spacing: -1.8px !important;
    font-weight: 700 !important;
    color: var(--o-ink) !important;
  }

  .hero-desc {
    font-size: 14px !important;
    line-height: 1.65 !important;
    color: var(--o-mute) !important;
    margin: 0 0 28px !important;
    max-width: 600px !important;
  }

  .hero-actions {
    display: flex !important;
    gap: 12px !important;
    flex-wrap: wrap !important;
    align-items: center !important;
  }

  .right-h2 {
    margin: 0 0 16px !important;
    font-size: clamp(22px, 2.2vw, 28px) !important;
    line-height: 1.2 !important;
    letter-spacing: -0.8px !important;
    font-weight: 600 !important;
    color: var(--o-ink) !important;
  }

  .right-desc {
    font-size: 13.5px !important;
    line-height: 1.65 !important;
    color: var(--o-mute) !important;
    margin: 0 0 28px !important;
  }

  .stats-mini {
    display: grid !important;
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 12px !important;
    padding-top: 20px !important;
    border-top: 1px dashed var(--o-line) !important;
  }

  .stat-pill {
    display: flex !important;
    flex-direction: column !important;
    gap: 3px !important;
    background: var(--o-panel, rgba(255, 255, 255, 0.03)) !important;
    border: 1px solid var(--o-line) !important;
    padding: 10px 14px !important;
    border-radius: var(--o-radius, 6px) !important;
  }

  .stat-num {
    font-size: 18px !important;
    font-weight: 700 !important;
    color: var(--o-accent, #c8ff00) !important;
    letter-spacing: -0.5px !important;
  }

  .stat-lbl {
    font-size: 9.5px !important;
    color: var(--o-faint) !important;
    text-transform: uppercase !important;
    letter-spacing: 0.8px !important;
  }

  /* Trust Ribbon */
  .trust-ribbon {
    background: var(--o-panel-hi, rgba(15, 15, 18, 0.95)) !important;
    border-bottom: 1px solid var(--o-line) !important;
    padding: 14px 24px !important;
    overflow-x: auto !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
  }
  .trust-ribbon::-webkit-scrollbar { display: none !important; }

  .trust-scroller {
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
    font-size: 11px !important;
    color: var(--o-mute) !important;
    white-space: nowrap !important;
    justify-content: flex-start !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }

  .trust-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    color: var(--o-ink) !important;
    text-decoration: none !important;
    transition: color .15s, opacity .15s !important;
  }
  a.trust-item:hover {
    color: var(--o-accent, #c8ff00) !important;
    text-decoration: underline !important;
  }

  .trust-dot {
    color: var(--o-faint) !important;
    font-weight: bold !important;
  }

  .trust-item .icon {
    font-size: 12px !important;
  }

  /* Blog Post Grid */
  .grid-wrap {
    padding: 72px 56px 96px !important;
    border-bottom: 1px solid var(--o-line) !important;
    max-width: 1440px !important;
    margin: 0 auto !important;
  }

  .grid-header {
    display: flex !important;
    justify-content: space-between !important;
    align-items: flex-end !important;
    margin-bottom: 40px !important;
    padding-bottom: 20px !important;
    border-bottom: 1px solid var(--o-line) !important;
    gap: 24px !important;
    flex-wrap: wrap !important;
  }

  .grid-header-meta {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
  }

  .meta-tag {
    font-size: 10px !important;
    color: var(--o-accent, #c8ff00) !important;
    letter-spacing: 1px !important;
    font-weight: 600 !important;
  }

  .grid-title {
    margin: 0 !important;
    font-size: 26px !important;
    font-weight: 600 !important;
    color: var(--o-ink) !important;
    letter-spacing: -0.5px !important;
  }

  .grid-desc {
    font-size: 12px !important;
    color: var(--o-mute) !important;
    margin: 0 !important;
    max-width: 440px !important;
  }

  .post-grid {
    display: grid !important;
    grid-template-columns: repeat(2, 1fr) !important;
    gap: 18px !important;
  }

  .post-card {
    background: var(--o-panel, rgba(18, 18, 22, 0.6)) !important;
    border: 1px solid var(--o-line) !important;
    border-radius: var(--o-radius, 8px) !important;
    padding: 30px !important;
    text-decoration: none !important;
    color: var(--o-ink) !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: space-between !important;
    gap: 18px !important;
    transition: all .2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    position: relative !important;
    overflow: hidden !important;
  }

  .post-card::before {
    content: '' !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 3px !important;
    height: 0 !important;
    background: var(--o-accent, #c8ff00) !important;
    transition: height .25s ease !important;
  }

  .post-card:hover {
    border-color: color-mix(in srgb, var(--o-accent, #c8ff00) 50%, var(--o-line)) !important;
    transform: translateY(-3px) !important;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.25) !important;
    background: var(--o-panel-hi, rgba(24, 24, 30, 0.8)) !important;
  }

  .post-card:hover::before {
    height: 100% !important;
  }

  .card-top {
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
  }

  .card-num {
    color: var(--o-accent, #c8ff00) !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 1px !important;
  }

  .card-badges {
    display: flex !important;
    gap: 8px !important;
    align-items: center !important;
  }

  .card-category {
    font-size: 9.5px !important;
    color: var(--o-accent, #c8ff00) !important;
    padding: 3px 8px !important;
    background: color-mix(in srgb, var(--o-accent, #c8ff00) 8%, transparent) !important;
    border: 1px solid color-mix(in srgb, var(--o-accent, #c8ff00) 25%, transparent) !important;
    border-radius: 4px !important;
    text-transform: capitalize !important;
  }

  .card-tag {
    font-size: 9.5px !important;
    color: var(--o-faint) !important;
    padding: 3px 8px !important;
    border: 1px solid var(--o-line) !important;
    border-radius: 4px !important;
  }

  .card-main {
    display: flex !important;
    flex-direction: column !important;
    gap: 8px !important;
    flex: 1 !important;
  }

  .card-h {
    margin: 0 !important;
    font-size: 24px !important;
    color: var(--o-ink) !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    letter-spacing: -0.5px !important;
  }

  .card-tagline {
    margin: 0 !important;
    font-size: 13px !important;
    color: var(--o-accent, #c8ff00) !important;
    line-height: 1.45 !important;
    font-weight: 500 !important;
  }

  .card-sub {
    margin: 4px 0 0 !important;
    font-size: 12.5px !important;
    color: var(--o-mute) !important;
    line-height: 1.6 !important;
  }

  .card-foot {
    padding-top: 16px !important;
    border-top: 1px dashed var(--o-line) !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    font-size: 11px !important;
  }

  .card-read-time {
    color: var(--o-faint) !important;
  }

  .card-cta {
    color: var(--o-accent, #c8ff00) !important;
    font-weight: 500 !important;
    transition: transform .15s ease !important;
  }

  .post-card:hover .card-cta {
    transform: translateX(3px) !important;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .blog-hero-split {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
      padding: 56px 36px 48px !important;
    }
    .hero-left {
      padding-right: 0 !important;
      border-right: none !important;
      border-bottom: 1px solid var(--o-line) !important;
      padding-bottom: 36px !important;
    }
    .hero-right {
      padding-left: 0 !important;
    }
    .grid-wrap {
      padding: 56px 36px 72px !important;
    }
  }

  @media (max-width: 768px) {
    .post-grid {
      grid-template-columns: 1fr !important;
    }
    .blog-hero-split {
      padding: 44px 20px 36px !important;
    }
    .grid-wrap {
      padding: 44px 20px 60px !important;
    }
    .grid-header {
      flex-direction: column !important;
      align-items: flex-start !important;
    }
    .stats-mini {
      grid-template-columns: 1fr 1fr !important;
    }
  }
</style>
