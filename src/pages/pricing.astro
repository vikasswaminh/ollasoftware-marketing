---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/primitives/PageHero.astro';
import SectionHead from '../components/primitives/SectionHead.astro';
import Btn from '../components/primitives/Btn.astro';

const tiers = [
  {
    name: 'Audit',
    sub: '2-week deep read',
    price: '$24,000',
    cadence: 'fixed · one-off',
    blurb: 'A read on your AI surface, your SEO position, your paid funnel, your stack — pick one. Costed roadmap at the end, ready for your board.',
    bullets: [
      'Stakeholder interviews (5–10)',
      'Existing-state teardown',
      'Eval &amp; cost reviews',
      'Buy-vs-build memos',
      'Roadmap your board can read',
      'No upsell pressure',
    ],
    cta: { label: 'Book an audit →', href: '/contact' },
    accent: 'var(--o-purple)',
    featured: false,
  },
  {
    name: 'Sprint',
    sub: 'fixed-price build',
    price: '$48k+',
    cadence: 'per sprint · 4–12 weeks',
    blurb: 'Custom AI builds, software builds, or a quarterly content + AEO push. Tight scope, fixed price, working software in your repo by week one.',
    bullets: [
      '2–5 senior engineers / strategists',
      'Discovery → demo in 14 days',
      'Working in your stack from day 1',
      'Fixed price · change-orders on us',
      'You own everything, day 1',
      'Sprint refund if we miss the bar',
    ],
    cta: { label: 'Start a sprint →', href: '/contact' },
    accent: 'var(--o-accent)',
    featured: true,
  },
  {
    name: 'Retainer',
    sub: 'monthly cadence',
    price: '$11k+/mo',
    cadence: 'monthly · 30-day notice',
    blurb: 'Ongoing AEO, SEO, social, performance, or embedded engineering. A senior team in your standups, shipping every week, reported in pipeline.',
    bullets: [
      '2–4 person pods',
      'Weekly demos / read-outs',
      'In your tools, your accounts',
      'Reported in pipeline, not vanity',
      'Month-to-month, cancel anytime',
      'Clean hand-off built in',
    ],
    cta: { label: 'Start a retainer →', href: '/contact' },
    accent: 'var(--o-blue)',
    featured: false,
  },
];

const faqs = [
  { q: 'Why fixed price? Don\'t most agencies bill T&amp;M?',
    a: 'Because time-and-materials lets us be lazy and lets you be vague. Fixed price forces both of us to do the work up front to know what we\'re building. We over-scope discovery so the build estimate is honest.' },
  { q: 'What if we want to mix services?',
    a: 'Most clients do. We\'ll combine a sprint and a retainer into one engagement (one MSA, one invoice, one weekly standup). No bundling tax, no separate account managers.' },
  { q: 'Do you do equity-in-lieu deals?',
    a: 'For the right stage and the right founder — yes, in a small portion of the engagement. We\'ve done a handful. Ask on the call; we\'ll tell you straight.' },
  { q: 'What about discounts for non-profits or research?',
    a: 'Yes — we run a few pro-bono and reduced-rate sprints a year. Tell us about the work; if it\'s a fit we\'ll find a way.' },
  { q: 'Currency &amp; invoicing?',
    a: 'USD by default. EUR / GBP / INR / BRL on request. NET-15 by default, NET-30 for enterprise procurement. We accept wire, ACH, and SEPA. No card fees on us.' },
  { q: 'Where do you not work?',
    a: 'Gambling, crypto pumps, anything we\'d be embarrassed to put in a case study. Otherwise: any geography, any time zone.' },
];
---
<Layout
  title="Pricing — Ollasoftware"
  description="Three engagement models. Fixed prices for sprints. Monthly for retainers. Two weeks for audits. No surprise invoices."
>
  <PageHero
    eyebrow="Engagement"
    title="Three ways to work together."
    sub="Audit, sprint, retainer. Pick one. Combine them. Switch between them. No quotas, no exclusivity, no auto-renewals."
    breadcrumb={[{ label: 'home', href: '/' }, { label: 'pricing' }]}
  >
    <Btn primary href="/contact">Talk to us →</Btn>
    <Btn href="/services">See services</Btn>
  </PageHero>

  <section class="tiers">
    <div class="grid">
      {tiers.map(t => (
        <article class:list={['tier', { featured: t.featured }]} style={`--accent:${t.accent}`}>
          {t.featured && <div class="ribbon mono">Most common</div>}
          <div class="t-head">
            <span class="t-name">{t.name}</span>
            <span class="t-sub mono">{t.sub}</span>
          </div>
          <div class="t-price">
            <span class="num">{t.price}</span>
            <span class="cadence mono">{t.cadence}</span>
          </div>
          <p class="blurb">{t.blurb}</p>
          <ul>
            {t.bullets.map(b => <li class="mono"><span class="arr">›</span><span set:html={b} /></li>)}
          </ul>
          <a class="t-cta mono" href={t.cta.href}>{t.cta.label}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="how-charged">
    <SectionHead
      tag="How we charge"
      title="The boring details."
      sub="Two pages of T&amp;C, written in plain English."
    />
    <div class="charged-grid">
      <div class="ch">
        <h4 class="mono">Fixed sprints</h4>
        <p>50% on signature, 50% on demo. We refund pro-rata if we miss the success bar. We don't change-order our own under-scoping.</p>
      </div>
      <div class="ch">
        <h4 class="mono">Retainers</h4>
        <p>Monthly, paid in advance. 30-day cancellation notice. No long-term lock-in. Pause for a quarter if your business changes — we keep the seat warm at 50%.</p>
      </div>
      <div class="ch">
        <h4 class="mono">Audits</h4>
        <p>Flat fee, paid 50% on kickoff, 50% on delivery. You can convert any audit into a sprint within 60 days and we credit 100% of the audit fee against it.</p>
      </div>
      <div class="ch">
        <h4 class="mono">Media spend (perf only)</h4>
        <p>You pay the platform directly with your card. We never mark up media. We take a flat retainer regardless of spend so our incentives stay aligned with your CAC.</p>
      </div>
      <div class="ch">
        <h4 class="mono">Expenses</h4>
        <p>Travel and on-site work billed at cost, pre-approved by you. We don't expense lunches. We don't expense conference tickets.</p>
      </div>
      <div class="ch">
        <h4 class="mono">Discounts</h4>
        <p>Sign two services on retainer: 10% off the smaller. Pre-pay a sprint in full: 5% off. We don't negotiate beyond that — saves both of us the dance.</p>
      </div>
    </div>
  </section>

  <section class="faqs">
    <SectionHead
      tag="Money questions"
      title="What procurement asks."
    />
    <div class="faq-list">
      {faqs.map(f => (
        <details>
          <summary set:html={f.q} />
          <p set:html={f.a} />
        </details>
      ))}
    </div>
  </section>

  <section class="cta">
    <h2>Talk to a partner, not a sales rep.</h2>
    <p class="mono">The first call is with someone who'll actually be on your engagement. No SDR, no qualification form, no procurement theatre.</p>
    <div class="actions">
      <Btn primary href="/contact">Talk to us →</Btn>
      <Btn href="/process">See how we work</Btn>
    </div>
  </section>
</Layout>

<style>
  .tiers { padding: 64px 56px; border-bottom: 1px solid var(--o-line); }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    align-items: stretch;
  }
  .tier {
    background: var(--o-panel);
    border: 1px solid var(--o-line);
    border-radius: var(--o-radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
  }
  .tier.featured {
    border-color: var(--accent);
    box-shadow: 0 30px 80px -20px color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .ribbon {
    position: absolute;
    top: -1px;
    right: 16px;
    background: var(--accent);
    color: #0a0a0a;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 0 0 var(--o-radius-sm) var(--o-radius-sm);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .t-head { display: flex; flex-direction: column; gap: 2px; }
  .t-name {
    font-size: 28px;
    font-weight: 600;
    color: var(--o-ink);
    letter-spacing: -0.6px;
  }
  .t-sub {
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .t-price {
    padding: 16px 0;
    border-top: 1px solid var(--o-line);
    border-bottom: 1px solid var(--o-line);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .t-price .num {
    font-size: 36px;
    font-weight: 600;
    color: var(--o-ink);
    letter-spacing: -1px;
  }
  .t-price .cadence { font-size: 11px; color: var(--o-mute); }

  .blurb {
    font-size: 14px;
    color: var(--o-mute);
    line-height: 1.55;
    margin: 0;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  ul li {
    font-size: 13px;
    color: var(--o-ink);
    display: flex;
    gap: 10px;
    line-height: 1.5;
  }
  .arr { color: var(--accent); flex-shrink: 0; }

  .t-cta {
    margin-top: auto;
    padding: 12px 16px;
    background: var(--accent);
    color: #0a0a0a;
    text-align: center;
    text-decoration: none;
    border-radius: var(--o-radius-sm);
    font-size: 13px;
    font-weight: 500;
    transition: filter .14s;
  }
  .t-cta:hover { filter: brightness(1.08); }

  .how-charged, .faqs { padding: 96px 56px; border-bottom: 1px solid var(--o-line); }

  .charged-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .ch {
    background: var(--o-panel);
    border: 1px solid var(--o-line);
    border-radius: var(--o-radius);
    padding: 22px 24px;
  }
  .ch h4 {
    margin: 0 0 10px;
    font-size: 12px;
    color: var(--o-accent);
    text-transform: uppercase;
    letter-spacing: 0.6px;
    font-weight: 500;
  }
  .ch p { margin: 0; font-size: 14px; color: var(--o-mute); line-height: 1.55; }

  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  details {
    background: var(--o-panel);
    border: 1px solid var(--o-line);
    border-radius: var(--o-radius);
    padding: 18px 22px;
  }
  details summary {
    cursor: pointer;
    font-size: 16px;
    color: var(--o-ink);
    font-weight: 500;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  details summary::-webkit-details-marker { display: none; }
  details summary::after {
    content: '+';
    color: var(--o-mute);
    font-size: 20px;
    font-weight: 300;
    transition: transform .14s;
  }
  details[open] summary::after { transform: rotate(45deg); }
  details p { margin: 14px 0 0; font-size: 14px; color: var(--o-mute); line-height: 1.6; }

  .cta { padding: 96px 56px; text-align: center; }
  .cta h2 { margin: 0 0 12px; font-size: 40px; letter-spacing: -1px; font-weight: 600; color: var(--o-ink); }
  .cta p { font-size: 14px; color: var(--o-mute); margin: 0 0 28px; }
  .actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: 1fr; }
    .tier.featured { order: -1; }
    .charged-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 700px) {
    .tiers, .how-charged, .faqs, .cta { padding: 64px 24px; }
    .charged-grid { grid-template-columns: 1fr; }
  }
</style>
