# Cloudflare Pages headers — browser caching policy.
# Fingerprinted assets (Astro content-hashes the filename) are immutable:
# a content change ships a NEW filename, so the browser never needs to
# revalidate. This kills the per-navigation re-validation round-trips that
# CF Pages' default `max-age=0` was causing on every CSS/JS/font.

/*
  Cache-Control: public, max-age=0, must-revalidate

/_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-named icons / OG images / manifest: moderate cache
/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate
/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
/*.png
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400

# AEO / discovery text endpoints: short cache so edits propagate within the hour.
/llms.txt
  Cache-Control: public, max-age=3600
/llms-full.txt
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
